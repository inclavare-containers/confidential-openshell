[Unit]
Description=OpenShell v0.1.6 upstream Gateway for confidential ACK
After=network-online.target openshell-confidential-driver.service
Requires=openshell-confidential-driver.service

[Service]
User=openshell-gateway
Group=openshell-gateway
Environment=HOME=/var/lib/openshell-confidential
Environment=XDG_STATE_HOME=/var/lib/openshell-confidential/data
Environment=KUBECONFIG=/etc/openshell-confidential/kubeconfig
Environment=OPENSHELL_DB_URL=sqlite:/var/lib/openshell-confidential/data/openshell.db
Environment=OPENSHELL_TELEMETRY_ENABLED=false
ExecStart=/usr/local/bin/openshell-gateway --config /etc/openshell-confidential/gateway.toml --compute-driver confidential --compute-driver-socket /run/openshell-confidential/driver.sock
Restart=on-failure
RestartSec=2
UMask=0077
LimitCORE=0
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/openshell-confidential/data

[Install]
WantedBy=multi-user.target
