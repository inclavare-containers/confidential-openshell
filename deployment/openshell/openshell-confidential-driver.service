[Unit]
Description=Independent confidential Kubernetes compute driver
After=network-online.target

[Service]
User=openshell-gateway
Group=openshell-gateway
Environment=HOME=/var/lib/openshell-confidential
Environment=KUBECONFIG=/etc/openshell-confidential/kubeconfig
Environment=OPENSHELL_CONFIDENTIAL_RUNTIME_CLASS=kata-remote
Environment=OPENSHELL_K8S_WORKSPACE_STORAGE_CLASS=alicloud-disk-essd-peerpod
Environment=OPENSHELL_TELEMETRY_ENABLED=false
EnvironmentFile=/etc/openshell-confidential/driver.env
ExecStart=/usr/local/bin/openshell-driver-confidential-kubernetes \
  --runtime-bootstrap-grace-seconds 900 \
  --guest-initdata-base /etc/openshell-confidential/guest-initdata-base.toml \
  --confidential-client-tls-ca /var/lib/openshell-confidential/tls/ca.crt \
  --kata-policy-generator /opt/confidential-openshell/deployment/runtime/agent_policy.py \
  --kata-policy-tools-dir /opt/openshell/kata-policy \
  --kata-policy-pause-image ${PAUSE_IMAGE} \
  --bootstrap-store-dir /var/lib/openshell-confidential/driver/resources \
  --bootstrap-signing-key /var/lib/openshell-confidential/driver/signer.key \
  --kbs-policy-renderer /opt/confidential-openshell/deployment/trustee/render-kbs-policy.py \
  --kbs-policy-output /var/lib/openshell-confidential/driver/resource-policy.rego \
  --as-policy-output /var/lib/openshell-confidential/driver/attestation-policy.rego \
  --trustee-config /etc/openshell-confidential/trustee-client.json \
  --bind-socket /run/openshell-confidential/driver.sock \
  --workspace-mode shared \
  --gateway-id confidential-ack \
  --sandbox-namespace openshell \
  --sandbox-service-account openshell-sandbox \
  --sandbox-image ${WORKLOAD_IMAGE} \
  --sandbox-runtime-image ${SANDBOX_IMAGE} \
  --supervisor-image ${SUPERVISOR_IMAGE} \
  --grpc-endpoint https://${HOST_IP}:9443 \
  --host-gateway-ip ${HOST_IP}
Restart=on-failure
RestartSec=2
UMask=0077
LimitCORE=0
RuntimeDirectory=openshell-confidential
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart

[Install]
WantedBy=multi-user.target
