[Unit]
Description=Confidential OpenShell Trustee gRPC Attestation Service
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/trustee/images.env
ExecStartPre=-/usr/bin/docker rm -f openshell-trustee-as
ExecStart=/usr/bin/docker run --name openshell-trustee-as --network host --env RUST_LOG --read-only --security-opt no-new-privileges --tmpfs /tmp:rw,nosuid,nodev --tmpfs /run:rw,nosuid,nodev --tmpfs /root/.cache:rw,nosuid,nodev -v /etc/trustee:/etc/trustee:ro -v /opt/trustee/attestation-service/storage:/opt/trustee/attestation-service/storage:rw ${TRUSTEE_AS_IMAGE} grpc-as --socket 127.0.0.1:50004 --config-file /etc/trustee/as-config.json
ExecStop=/usr/bin/docker stop -t 15 openshell-trustee-as
ExecStopPost=-/usr/bin/docker rm -f openshell-trustee-as
Restart=on-failure
RestartSec=2
UMask=0077
LimitCORE=0
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
