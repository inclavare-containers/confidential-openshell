{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": [
    "confidential"
  ],
  "provider": {
    "confidential": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Approved test endpoint",
      "options": {
        "baseURL": "https://inference.example.internal:8443/v1",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "REPLACE_WITH_APPROVED_MODEL": {
          "name": "Approved test model"
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": "allow",
    "edit": "allow",
    "bash": {
      "*": "deny",
      "python3 test_clamp.py": "allow"
    }
  }
}
