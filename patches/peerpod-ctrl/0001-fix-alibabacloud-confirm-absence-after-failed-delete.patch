+
+package alibabacloud
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"testing"
+
+	ecs "github.com/alibabacloud-go/ecs-20140526/v4/client"
+	"github.com/alibabacloud-go/tea/tea"
+)
+
+type fakeDeleteECSClient struct {
+	*ecs.Client
+	deleteError       error
+	attributeError    error
+	attributeResponse *ecs.DescribeInstanceAttributeResponse
+	deleteRequests    []*ecs.DeleteInstanceRequest
+	attributeRequests []*ecs.DescribeInstanceAttributeRequest
+}
+
+func (f *fakeDeleteECSClient) DeleteInstance(request *ecs.DeleteInstanceRequest) (*ecs.DeleteInstanceResponse, error) {
+	f.deleteRequests = append(f.deleteRequests, request)
+	return &ecs.DeleteInstanceResponse{Body: &ecs.DeleteInstanceResponseBody{}}, f.deleteError
+}
+
+func (f *fakeDeleteECSClient) DescribeInstanceAttribute(request *ecs.DescribeInstanceAttributeRequest) (*ecs.DescribeInstanceAttributeResponse, error) {
+	f.attributeRequests = append(f.attributeRequests, request)
+	return f.attributeResponse, f.attributeError
+}
+
+func TestDeleteInstanceConfirmsAbsenceAfterError(t *testing.T) {
+	denied := &tea.SDKError{Code: tea.String("Forbidden.RAM"), Message: tea.String("tag-conditioned deletion denied")}
+	notFound := &tea.SDKError{Code: tea.String("InvalidInstanceId.NotFound"), Message: tea.String("instance is absent")}
+	readDenied := &tea.SDKError{Code: tea.String("Forbidden.RAM"), Message: tea.String("read denied")}
+	transportError := errors.New("delete response lost")
+	for _, test := range []struct {
+		name          string
+		deleteError   error
+		readError     error
+		readResponse  *ecs.DescribeInstanceAttributeResponse
+		wantSuccess   bool
+		wantReadCalls int
+	}{
+		{name: "successful deletion needs no read", wantSuccess: true},
+		{name: "documented deletion not-found needs no read", deleteError: notFound, wantSuccess: true},
+		{name: "denied delete confirmed absent", deleteError: denied, readError: notFound, wantSuccess: true, wantReadCalls: 1},
+		{name: "lost delete response confirmed absent", deleteError: transportError, readError: notFound, wantSuccess: true, wantReadCalls: 1},
+		{name: "wrapped read not-found confirms absence", deleteError: denied, readError: fmt.Errorf("read: %w", notFound), wantSuccess: true, wantReadCalls: 1},
+		{name: "existing instance preserves deletion denial", deleteError: denied, readResponse: &ecs.DescribeInstanceAttributeResponse{Body: &ecs.DescribeInstanceAttributeResponseBody{InstanceId: tea.String("i-target")}}, wantReadCalls: 1},
+		{name: "empty successful response cannot prove absence", deleteError: denied, wantReadCalls: 1},
+		{name: "read denial preserves deletion denial", deleteError: denied, readError: readDenied, wantReadCalls: 1},
+		{name: "read transport failure preserves deletion denial", deleteError: denied, readError: errors.New("read response lost"), wantReadCalls: 1},
+		{name: "other read not-found code cannot prove absence", deleteError: denied, readError: &tea.SDKError{Code: tea.String("InvalidRegionId.NotFound")}, wantReadCalls: 1},
+		{name: "read error without code cannot prove absence", deleteError: denied, readError: &tea.SDKError{Message: tea.String("incomplete SDK error")}, wantReadCalls: 1},
+		{name: "non-SDK deletion error preserved if instance exists", deleteError: transportError, wantReadCalls: 1},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			client := &fakeDeleteECSClient{deleteError: test.deleteError, attributeError: test.readError, attributeResponse: test.readResponse}
+			p := &alibabaCloudProvider{ecsClient: client, serviceConfig: &Config{Region: "cn-beijing"}}
+			err := p.DeleteInstance(context.Background(), "i-target")
+			if test.wantSuccess && err != nil {
+				t.Fatalf("DeleteInstance() = %v, want confirmed success", err)
+			}
+			if !test.wantSuccess && !errors.Is(err, test.deleteError) {
+				t.Fatalf("DeleteInstance() = %v, want original deletion error %v", err, test.deleteError)
+			}
+			if len(client.deleteRequests) != 1 || tea.StringValue(client.deleteRequests[0].InstanceId) != "i-target" || !tea.BoolValue(client.deleteRequests[0].Force) {
+				t.Fatal("deletion must retain the exact target and existing Force behavior")
+			}
+			if len(client.attributeRequests) != test.wantReadCalls {
+				t.Fatalf("read calls = %d, want %d", len(client.attributeRequests), test.wantReadCalls)
+			}
+			if test.wantReadCalls == 1 && tea.StringValue(client.attributeRequests[0].InstanceId) != "i-target" {
+				t.Fatal("absence read must target the same exact instance on the same client")
+			}
+		})
+	}
