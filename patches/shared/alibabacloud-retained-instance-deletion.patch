+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package alibabacloud
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"testing"
+
+	ecs "github.com/alibabacloud-go/ecs-20140526/v4/client"
+	"github.com/alibabacloud-go/tea/tea"
+)
+
+type retentionClient struct {
+	*ecs.Client
+	disks                  *ecs.DescribeDisksResponse
+	diskErr                error
+	lock                   string
+	deleted                bool
+	lockAfterFailure       bool
+	deleteCalls, lockReads int
+}
+
+func (c *retentionClient) DescribeDisks(req *ecs.DescribeDisksRequest) (*ecs.DescribeDisksResponse, error) {
+	if c.deleted && tea.StringValue(req.InstanceId) != "" {
+		return &ecs.DescribeDisksResponse{Body: &ecs.DescribeDisksResponseBody{Disks: &ecs.DescribeDisksResponseBodyDisks{}}}, nil
+	}
+	return c.disks, c.diskErr
+}
+func (c *retentionClient) DescribeInstanceAttribute(req *ecs.DescribeInstanceAttributeRequest) (*ecs.DescribeInstanceAttributeResponse, error) {
+	if c.deleted {
+		return nil, &tea.SDKError{Code: tea.String("InvalidInstanceId.NotFound")}
+	}
+	c.lockReads++
+	body := &ecs.DescribeInstanceAttributeResponseBody{InstanceId: req.InstanceId}
+	if c.lock != "" {
+		body.OperationLocks = &ecs.DescribeInstanceAttributeResponseBodyOperationLocks{LockReason: []*ecs.DescribeInstanceAttributeResponseBodyOperationLocksLockReason{{LockReason: tea.String(c.lock)}}}
+	}
+	return &ecs.DescribeInstanceAttributeResponse{Body: body}, nil
+}
+func (c *retentionClient) DeleteInstance(req *ecs.DeleteInstanceRequest) (*ecs.DeleteInstanceResponse, error) {
+	c.deleteCalls++
+	if c.lockAfterFailure && c.deleteCalls == 1 {
+		c.lock = "security"
+		return nil, &tea.SDKError{Code: tea.String("IncorrectInstanceStatus")}
+	}
+	if tea.StringValue(req.InstanceId) != "i-retained" || !tea.BoolValue(req.Force) {
+		return nil, errors.New("wrong deletion request")
+	}
+	c.deleted = true
+	for _, disk := range c.disks.Body.Disks.Disk {
+		disk.Status = tea.String("Available")
+		disk.InstanceId = tea.String("")
+	}
+	return &ecs.DeleteInstanceResponse{Body: &ecs.DeleteInstanceResponseBody{}}, nil
+}
+
+// Run the same cases against both independent binaries' provider queues.
+func TestDeleteInstanceRetentionGuard(t *testing.T) {
+	for _, tc := range []struct {
+		name, lock, wantError string
+		mutate                func(*retentionClient)
+	}{
+		{name: "retained disk is released safely"},
+		{name: "security lock blocks delete", lock: "security", wantError: "security-locked"},
+		{name: "unknown lock fails closed with retained disk", lock: "new-lock", wantError: "unrecognized operation lock"},
+		{name: "known financial lock does not imply data loss", lock: "financial"},
+		{name: "ephemeral security lock is not blocked", lock: "security", mutate: func(c *retentionClient) { c.disks.Body.Disks.Disk = nil }},
+		{name: "delete with instance rejected", wantError: "DeleteWithInstance=false", mutate: func(c *retentionClient) { c.disks.Body.Disks.Disk[0].DeleteWithInstance = tea.Bool(true) }},
+		{name: "missing retention attribute rejected", wantError: "DeleteWithInstance=false", mutate: func(c *retentionClient) { c.disks.Body.Disks.Disk[0].DeleteWithInstance = nil }},
+		{name: "wrong instance rejected", wantError: "not attached", mutate: func(c *retentionClient) { c.disks.Body.Disks.Disk[0].InstanceId = tea.String("i-other") }},
+		{name: "inventory permission error prevents delete", wantError: "inventory denied", mutate: func(c *retentionClient) { c.diskErr = errors.New("inventory denied") }},
+		{name: "truncated inventory prevents delete", wantError: "truncated", mutate: func(c *retentionClient) { c.disks.Body.NextToken = tea.String("more") }},
+		{name: "incomplete inventory prevents delete", wantError: "incomplete", mutate: func(c *retentionClient) { c.disks = nil }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			c := &retentionClient{lock: tc.lock, disks: &ecs.DescribeDisksResponse{Body: &ecs.DescribeDisksResponseBody{Disks: &ecs.DescribeDisksResponseBodyDisks{Disk: []*ecs.DescribeDisksResponseBodyDisksDisk{{DiskId: tea.String("d-retained"), Type: tea.String("data"), Portable: tea.Bool(true), MultiAttach: tea.String("Disabled"), DeleteWithInstance: tea.Bool(false), Status: tea.String("In_use"), InstanceId: tea.String("i-retained")}}}}}}
+			if tc.mutate != nil {
+				tc.mutate(c)
+			}
+			p := &alibabaCloudProvider{ecsClient: c, serviceConfig: &Config{Region: "cn-beijing"}}
+			err := p.DeleteInstance(context.Background(), "i-retained")
+			if tc.wantError != "" {
+				if err == nil || !strings.Contains(err.Error(), tc.wantError) {
+					t.Fatalf("error=%v, want %q", err, tc.wantError)
+				}
+				if c.deleteCalls != 0 {
+					t.Fatalf("unsafe delete called %d times", c.deleteCalls)
+				}
+			} else {
+				if err != nil || c.deleteCalls != 1 {
+					t.Fatalf("error=%v, delete calls=%d", err, c.deleteCalls)
+				}
+				if tc.name == "ephemeral security lock is not blocked" && c.lockReads != 0 {
+					t.Fatal("applied retained-disk lock checks to an ephemeral instance")
+				}
+			}
+		})
+	}
+}
+
+func TestDeleteInstanceRechecksRetentionOnRetry(t *testing.T) {
+	c := &retentionClient{lockAfterFailure: true, disks: &ecs.DescribeDisksResponse{Body: &ecs.DescribeDisksResponseBody{Disks: &ecs.DescribeDisksResponseBodyDisks{Disk: []*ecs.DescribeDisksResponseBodyDisksDisk{{DiskId: tea.String("d-retained"), Type: tea.String("data"), Portable: tea.Bool(true), MultiAttach: tea.String("Disabled"), DeleteWithInstance: tea.Bool(false), Status: tea.String("In_use"), InstanceId: tea.String("i-retained")}}}}}}
+	p := &alibabaCloudProvider{ecsClient: c, serviceConfig: &Config{Region: "cn-beijing"}}
+	err := p.DeleteInstance(context.Background(), "i-retained")
+	if err == nil || !strings.Contains(err.Error(), "security-locked") || c.deleteCalls != 1 {
+		t.Fatalf("error=%v delete calls=%d; second mutation must be blocked", err, c.deleteCalls)
+	}
+}
