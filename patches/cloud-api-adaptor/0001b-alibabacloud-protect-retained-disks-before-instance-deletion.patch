+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package controllers
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	provider "github.com/confidential-containers/cloud-api-adaptor/src/cloud-providers"
+	api "github.com/confidential-containers/cloud-api-adaptor/src/peerpod-ctrl/api/v1alpha1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime"
+	"k8s.io/apimachinery/pkg/types"
+	ctrl "sigs.k8s.io/controller-runtime"
+	"sigs.k8s.io/controller-runtime/pkg/client/fake"
+)
+
+type refusingRetentionProvider struct {
+	provider.Provider
+	err      error
+	instance string
+}
+
+func (p *refusingRetentionProvider) DeleteInstance(_ context.Context, id string) error {
+	p.instance = id
+	return p.err
+}
+
+func TestFinalizerRetainsPeerPodUntilProviderAllowsDeletion(t *testing.T) {
+	scheme := runtime.NewScheme()
+	if err := api.AddToScheme(scheme); err != nil {
+		t.Fatal(err)
+	}
+	now := metav1.Now()
+	pp := &api.PeerPod{ObjectMeta: metav1.ObjectMeta{Name: "retained", Namespace: "default", DeletionTimestamp: &now, Finalizers: []string{ppFinalizer}}, Spec: api.PeerPodSpec{CloudProvider: "alibabacloud", InstanceID: "i-retained"}}
+	client := fake.NewClientBuilder().WithScheme(scheme).WithObjects(pp).Build()
+	guardErr := errors.New("security lock prevents retained disk deletion")
+	p := &refusingRetentionProvider{err: guardErr}
+	r := &PeerPodReconciler{Client: client, Scheme: scheme, Providers: map[string]provider.Provider{"alibabacloud": p}}
+	key := types.NamespacedName{Name: pp.Name, Namespace: pp.Namespace}
+	if _, err := r.Reconcile(t.Context(), ctrl.Request{NamespacedName: key}); !errors.Is(err, guardErr) {
+		t.Fatalf("lost guard error: %v", err)
+	}
+	if p.instance != "i-retained" {
+		t.Fatalf("wrong instance %q", p.instance)
+	}
+	current := &api.PeerPod{}
+	if err := client.Get(t.Context(), key, current); err != nil {
+		t.Fatal(err)
+	}
+	if len(current.Finalizers) != 1 || current.Finalizers[0] != ppFinalizer {
+		t.Fatal("released finalizer despite retained-disk guard failure")
+	}
+	p.err = nil
+	if _, err := r.Reconcile(t.Context(), ctrl.Request{NamespacedName: key}); err != nil {
+		t.Fatal(err)
+	}
+	if err := client.Get(t.Context(), key, current); !apierrors.IsNotFound(err) {
+		t.Fatalf("successful retry did not finish deletion: %v", err)
+	}
+}
