From b869f7fc0c6bfdcfe8b24876aaff234023452447 Mon Sep 17 00:00:00 2001
From: Weidong Sun <sunweidong@linux.alibaba.com>
Date: Tue, 3 Nov 2026 01:07:30 +0800
Subject: [PATCH 02/10] fix(alibabacloud): accept explicit VPC configuration

Allow deployments to provide the VPC ID directly and use metadata discovery only when it is absent. This keeps Alibaba instance creation usable in restricted networks without changing any other provider.

Signed-off-by: Weidong Sun <sunweidong@linux.alibaba.com>
---
 src/cloud-providers/alibabacloud/manager.go   |  3 +-
 .../alibabacloud/manager_test.go              | 28 ++++++++
 src/cloud-providers/alibabacloud/provider.go  |  9 ++-
 .../alibabacloud/provider_vpc_test.go         | 68 +++++++++++++++++++
 4 files changed, 105 insertions(+), 3 deletions(-)
 create mode 100644 src/cloud-providers/alibabacloud/manager_test.go
 create mode 100644 src/cloud-providers/alibabacloud/provider_vpc_test.go

diff --git a/src/cloud-providers/alibabacloud/manager.go b/src/cloud-providers/alibabacloud/manager.go
index a3753a0299bb699bc89668e33df4e09d4b6f6178..c743b9ef60b623587f01d26da23db5dd501dee94 100644
--- a/src/cloud-providers/alibabacloud/manager.go
+++ b/src/cloud-providers/alibabacloud/manager.go
@@ -34,8 +34,7 @@ func (*Manager) ParseCmd(flags *flag.FlagSet) {
 	reg.IntWithEnv(&alibabacloudcfg.SystemDiskSize, "system-disk-size", 40, "SYSTEM_DISK_SIZE", "System Disk size (in GiB) for the Pod VMs")
 	reg.BoolWithEnv(&alibabacloudcfg.DisableCVM, "disable-cvm", false, "DISABLECVM", "Use non-CVMs for peer pods")
 
-	// Flags without environment variable support (pass empty string for envVarName)
-	reg.StringWithEnv(&alibabacloudcfg.VpcID, "vpc-id", "", "", "VPC ID to be used for the Pod VMs")
+	reg.StringWithEnv(&alibabacloudcfg.VpcID, "vpc-id", "", "VPC_ID", "VPC ID to be used for the Pod VMs")
 
 	// Custom flag types (comma-separated lists)
 	reg.CustomTypeWithEnv(&alibabacloudcfg.SecurityGroupIDs, "security-group-ids", "cn-beijing", "SECURITY_GROUP_IDS", "Security Group Ids to be used for the Pod VM, comma separated")
