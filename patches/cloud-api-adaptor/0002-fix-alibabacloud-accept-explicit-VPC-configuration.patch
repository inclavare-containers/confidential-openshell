+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package alibabacloud
+
+import (
+	"flag"
+	"testing"
+)
+
+func TestManagerVPCIDFromEnvironment(t *testing.T) {
+	alibabacloudcfg = Config{}
+	t.Cleanup(func() { alibabacloudcfg = Config{} })
+	t.Setenv("VPC_ID", "vpc-from-environment")
+
+	flags := flag.NewFlagSet("test", flag.ContinueOnError)
+	(&Manager{}).ParseCmd(flags)
+	if alibabacloudcfg.VpcID != "vpc-from-environment" {
+		t.Fatalf("VpcID = %q, want VPC_ID environment value", alibabacloudcfg.VpcID)
+	}
+
+	if err := flags.Set("vpc-id", "vpc-from-flag"); err != nil {
+		t.Fatal(err)
+	}
+	if alibabacloudcfg.VpcID != "vpc-from-flag" {
+		t.Fatalf("VpcID = %q, want flag override", alibabacloudcfg.VpcID)
+	}
+}
diff --git a/src/cloud-providers/alibabacloud/provider.go b/src/cloud-providers/alibabacloud/provider.go
index 389f2d112515b3661be9325f6bfba1e987c787a4..b52fc17de242bfed6da4d718f2426b7ba9df8d77 100644
--- a/src/cloud-providers/alibabacloud/provider.go
+++ b/src/cloud-providers/alibabacloud/provider.go
@@ -144,7 +144,7 @@ func NewProvider(config *Config) (provider.Provider, error) {
 		return nil, fmt.Errorf("failed to update instance type spec list: %v", err)
 	}
 
-	if err = provider.updateVpcID(); err != nil {
+	if err = provider.ensureVpcID(); err != nil {
 		return nil, fmt.Errorf("failed to get vpc id: %v", err)
 	}
 
@@ -440,6 +440,13 @@ func (p *alibabaCloudProvider) updateVpcID() error {
 	return nil
 }
 
+func (p *alibabaCloudProvider) ensureVpcID() error {
+	if p.serviceConfig.VpcID != "" {
+		return nil
+	}
+	return p.updateVpcID()
+}
