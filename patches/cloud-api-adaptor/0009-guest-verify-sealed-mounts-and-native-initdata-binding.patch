+func TestCanonicalInitdataEventMatchesReleasedAAEncoding(t *testing.T) {
+	// Fixed independent fixture from native AA TCG2 layout and SHA384 tagged
+	// bytes; it catches PCR, tag-endianness, length and digest changes.
+	expected, err := hex.DecodeString("0400000006000000010000000c009e62d4ff9a442178294c7ca76555f03b19d5dec935c14949342fda7262d8bbdb9c0da2d99b68087961745da31098b8062f0000004c45414127000000636f6e666964656e7469616c636f6e7461696e6572732e6f726720696e69746461746120616263")
+	require.NoError(t, err)
