+func TestMeasureInitdataRejectsNativeDisabledOrMissingRecord(t *testing.T) {
+	for _, result := range []protoreflect.EnumNumber{0, 1, 2} {
+		t.Run(string(rune('0'+result)), func(t *testing.T) {
+			path, digestPath, socket, eventlog, _ := measurementFixture(t)
+			listener, err := net.Listen("unix", socket)
+			require.NoError(t, err)
+			defer listener.Close()
+			server, err := ttrpc.NewServer()
+			require.NoError(t, err)
+			defer server.Close()
+			server.RegisterService("attestation_agent.AttestationAgentService", &ttrpc.ServiceDesc{Methods: map[string]ttrpc.Method{
+				"GetTeeType": nativeTeeTypeMethod("tdx"),
+				"ExtendRuntimeMeasurement": func(_ context.Context, unmarshal func(interface{}) error) (interface{}, error) {
+					request, response, err := nativeAAMessages()
+					require.NoError(t, err)
+					require.NoError(t, unmarshal(request))
+					response.Set(response.Descriptor().Fields().ByName("Result"), protoreflect.ValueOfEnum(result))
+					return response, nil
+				},
+			}})
+			go server.Serve(context.Background(), listener)
+			err = MeasureInitdata(context.Background(), path, digestPath, socket, eventlog)
+			if result == 0 {
+				require.Error(t, err, "RPC success without the native eventlog must fail")
+			} else {
+				require.ErrorContains(t, err, "non-success result")
+			}
+		})
+	}
+}
