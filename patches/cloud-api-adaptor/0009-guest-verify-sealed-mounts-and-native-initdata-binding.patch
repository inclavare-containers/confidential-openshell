+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package interceptor
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-api-adaptor/pkg/util"
+	pb "github.com/kata-containers/kata-containers/src/runtime/virtcontainers/pkg/agent/protocols/grpc"
+	"github.com/stretchr/testify/require"
+)
+
+func TestCreateContainerRollsBackBeforeAndAfterSealedGate(t *testing.T) {
+	for _, tc := range []struct {
+		name                               string
+		preparationFailure, cleanupFailure bool
+	}{
+		{name: "sealed rejection"}, {name: "preparation failure", preparationFailure: true}, {name: "failed rollback retained for destroy", cleanupFailure: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			owned := filepath.Join(t.TempDir(), "owned")
+			require.NoError(t, os.Mkdir(owned, 0700))
+			borrowed := filepath.Join(t.TempDir(), "borrowed")
+			require.NoError(t, os.Mkdir(borrowed, 0700))
+			unmountErr := errors.New("device busy")
+			cleaned := false
+			v := &preparedCloudVolume{sourcePath: owned, createdDirHere: true, mountedHere: true, unmount: func(string, int) error {
+				cleaned = true
+				if tc.cleanupFailure {
+					return unmountErr
+				}
+				return nil
+			}}
+			i := &interceptor{sealedGate: &sealedVolumeGate{manifest: sealedVolumeManifest{Container: "bootstrap", Destination: "/secrets"}}}
+			req := &pb.CreateContainerRequest{OCI: &pb.Spec{Linux: &pb.Linux{}, Annotations: map[string]string{util.CloudVolumesAnnotationKey: "{}", "io.kubernetes.cri.container-name": "unmeasured"}, Mounts: []*pb.Mount{{Destination: "/secrets"}}}}
+			_, err := i.createContainer(context.Background(), req, func(context.Context, *pb.CreateContainerRequest, string) ([]*preparedCloudVolume, error) {
+				volumes := []*preparedCloudVolume{v, {sourcePath: borrowed}}
+				if tc.preparationFailure {
+					return volumes, errors.New("preparation failed")
+				}
+				return volumes, nil
+			})
+			require.Error(t, err)
+			require.True(t, cleaned, "early error skipped resource rollback")
+			require.DirExists(t, borrowed, "rollback removed a borrowed resource")
+			if tc.cleanupFailure {
+				require.ErrorIs(t, err, unmountErr)
+				require.Len(t, i.cloudVolumes, 1, "failed cleanup lost ownership")
+				tc.cleanupFailure = false
+				require.NoError(t, cleanupPreparedCloudVolumes(context.Background(), i.cloudVolumes))
+			} else {
+				require.Empty(t, i.cloudVolumes)
+			}
+			require.NoDirExists(t, owned)
+		})
+	}
+}
diff --git a/src/cloud-api-adaptor/pkg/userdata/measure.go b/src/cloud-api-adaptor/pkg/userdata/measure.go
new file mode 100644
index 00000000..22253f08
--- /dev/null
+++ b/src/cloud-api-adaptor/pkg/userdata/measure.go
@@ -0,0 +1,166 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package userdata
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha512"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-api-adaptor/pkg/initdata"
+	"github.com/containerd/ttrpc"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/reflect/protodesc"
+	"google.golang.org/protobuf/reflect/protoreflect"
+	"google.golang.org/protobuf/types/descriptorpb"
+	"google.golang.org/protobuf/types/dynamicpb"
+)
+
+const NativeAASocket = "/run/confidential-containers/attestation-agent/attestation-agent.sock"
+const NativeAAEventlog = "/run/attestation-agent/eventlog"
+const maxMeasurementFile = 2 << 20
+
+// This is the exact published ExtendRuntimeMeasurement subset of the CoCo0.22
+// attestation-agent.proto. Dynamic messages reuse the existing protobuf/ttrpc
+// dependencies without copying another generated protocol library. Optional
+// RegisterIndex is omitted so AA uses its measured init_pcr configuration.
+func nativeAAMessages() (*dynamicpb.Message, *dynamicpb.Message, error) {
+	field := func(name string, number int32, typ descriptorpb.FieldDescriptorProto_Type) *descriptorpb.FieldDescriptorProto {
+		return &descriptorpb.FieldDescriptorProto{Name: proto.String(name), Number: proto.Int32(number), Type: &typ}
+	}
+	result := field("Result", 1, descriptorpb.FieldDescriptorProto_TYPE_ENUM)
+	result.TypeName = proto.String(".attestation_agent.RuntimeMeasurementResult")
+	file, err := protodesc.NewFile(&descriptorpb.FileDescriptorProto{
+		Name: proto.String("attestation-agent.proto"), Package: proto.String("attestation_agent"), Syntax: proto.String("proto3"),
+		EnumType: []*descriptorpb.EnumDescriptorProto{{Name: proto.String("RuntimeMeasurementResult"), Value: []*descriptorpb.EnumValueDescriptorProto{
+			{Name: proto.String("OK"), Number: proto.Int32(0)}, {Name: proto.String("NOT_SUPPORTED"), Number: proto.Int32(1)}, {Name: proto.String("NOT_ENABLED"), Number: proto.Int32(2)},
+		}}},
+		MessageType: []*descriptorpb.DescriptorProto{
+			{Name: proto.String("ExtendRuntimeMeasurementRequest"), Field: []*descriptorpb.FieldDescriptorProto{field("Domain", 1, descriptorpb.FieldDescriptorProto_TYPE_STRING), field("Operation", 2, descriptorpb.FieldDescriptorProto_TYPE_STRING), field("Content", 3, descriptorpb.FieldDescriptorProto_TYPE_STRING)}},
+			{Name: proto.String("ExtendRuntimeMeasurementResponse"), Field: []*descriptorpb.FieldDescriptorProto{result}},
+			{Name: proto.String("GetTeeTypeRequest")},
+			{Name: proto.String("GetTeeTypeResponse"), Field: []*descriptorpb.FieldDescriptorProto{field("tee", 1, descriptorpb.FieldDescriptorProto_TYPE_STRING)}},
+		},
+	}, nil)
+	if err != nil {
+		return nil, nil, err
+	}
+	return dynamicpb.NewMessage(file.Messages().Get(0)), dynamicpb.NewMessage(file.Messages().Get(1)), nil
+}
+
+func readMeasurementFile(path string) ([]byte, error) {
+	info, err := os.Lstat(path)
+	if err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() || info.Size() > maxMeasurementFile {
+		return nil, fmt.Errorf("measurement file %s must be a bounded regular file", path)
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+	return io.ReadAll(io.LimitReader(file, maxMeasurementFile+1))
+}
+
+// canonicalInitdataEvent is CoCo0.22's native TCG2 EV_EVENT_TAG encoding for
+// one SHA384 event at measurement-register4 (TDX init_pcr17 -> RTMR3). It is
+// deliberately exact: stale, duplicate, malformed or unexpected events fail.
+func canonicalInitdataEvent(digest string) []byte {
+	text := []byte("confidentialcontainers.org initdata " + digest)
+	var tagged bytes.Buffer
+	_ = binary.Write(&tagged, binary.LittleEndian, uint32(0x4141454c))
+	_ = binary.Write(&tagged, binary.LittleEndian, uint32(len(text)))
+	_, _ = tagged.Write(text)
+	hash := sha512.Sum384(tagged.Bytes())
+	var event bytes.Buffer
+	for _, number := range []uint32{4, 6, 1} {
+		_ = binary.Write(&event, binary.LittleEndian, number)
+	}
+	_ = binary.Write(&event, binary.LittleEndian, uint16(0xc))
+	_, _ = event.Write(hash[:])
+	_ = binary.Write(&event, binary.LittleEndian, uint32(tagged.Len()))
+	_, _ = event.Write(tagged.Bytes())
+	return event.Bytes()
+}
+
+func MeasureInitdata(ctx context.Context, initdataPath, digestPath, socketPath, eventlogPath string) error {
+	encoded, err := readMeasurementFile(initdataPath)
+	if err != nil {
+		return err
+	}
+	parsed, err := initdata.Parse(bytes.NewReader(encoded))
+	if err != nil {
+		return err
+	}
+	if parsed.Body.Algorithm != "sha384" {
+		return errors.New("native initdata measurement requires sha384")
+	}
+	digest, err := readMeasurementFile(digestPath)
+	if err != nil {
+		return err
+	}
+	if strings.TrimSpace(string(digest)) != parsed.Digest {
+		return errors.New("provisioned initdata digest differs from exact initdata")
+	}
+	expected := canonicalInitdataEvent(parsed.Digest)
+	previous, err := readMeasurementFile(eventlogPath)
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	if bytes.Equal(previous, expected) {
+		return nil
+	}
+	if len(previous) != 0 {
+		return errors.New("native AA eventlog contains unexpected or duplicate initdata events")
+	}
+	request, response, err := nativeAAMessages()
+	if err != nil {
+		return err
+	}
+	for name, value := range map[protoreflect.Name]string{"Domain": "confidentialcontainers.org", "Operation": "initdata", "Content": parsed.Digest} {
+		request.Set(request.Descriptor().Fields().ByName(name), protoreflect.ValueOfString(value))
+	}
+	ctx, cancel := context.WithTimeout(ctx, 30*time.Second)
+	defer cancel()
+	connection, err := (&net.Dialer{}).DialContext(ctx, "unix", socketPath)
+	if err != nil {
+		return fmt.Errorf("connect native AA: %w", err)
+	}
+	client := ttrpc.NewClient(connection)
+	defer client.Close()
+	file := request.Descriptor().ParentFile()
+	teeRequest := dynamicpb.NewMessage(file.Messages().ByName("GetTeeTypeRequest"))
+	teeResponse := dynamicpb.NewMessage(file.Messages().ByName("GetTeeTypeResponse"))
+	if err := client.Call(ctx, "attestation_agent.AttestationAgentService", "GetTeeType", teeRequest, teeResponse); err != nil {
+		return fmt.Errorf("query native AA tee type: %w", err)
+	}
+	if teeResponse.Get(teeResponse.Descriptor().Fields().ByName("tee")).String() != "tdx" {
+		return errors.New("native initdata measurement requires a TDX attester")
+	}
+
+	if err := client.Call(ctx, "attestation_agent.AttestationAgentService", "ExtendRuntimeMeasurement", request, response); err != nil {
+		return fmt.Errorf("native AA measurement: %w", err)
+	}
+	if result := response.Get(response.Descriptor().Fields().ByName("Result")).Enum(); result != 0 {
+		return fmt.Errorf("native AA measurement returned non-success result %d", result)
+	}
+	actual, err := readMeasurementFile(eventlogPath)
+	if err != nil {
+		return err
+	}
+	if !bytes.Equal(actual, expected) {
+		return errors.New("native AA did not record the canonical measured initdata event")
+	}
+	return nil
+}
