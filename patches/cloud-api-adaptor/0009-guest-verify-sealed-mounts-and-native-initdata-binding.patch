+func measurementFixture(t *testing.T) (string, string, string, string, string) {
+	t.Helper()
+	base := t.TempDir()
+	encoded, err := initdata.Encode("version = \"0.1.0\"\nalgorithm = \"sha384\"\n[data]\n\"policy.rego\" = 'package agent_policy'\n")
+	require.NoError(t, err)
+	path := filepath.Join(base, "initdata")
+	require.NoError(t, os.WriteFile(path, []byte(encoded), 0600))
+	file, err := os.Open(path)
+	require.NoError(t, err)
+	parsed, err := initdata.Parse(file)
+	file.Close()
+	require.NoError(t, err)
+	digestPath := filepath.Join(base, "digest")
+	require.NoError(t, os.WriteFile(digestPath, []byte(parsed.Digest), 0600))
+	return path, digestPath, filepath.Join(base, "aa.sock"), filepath.Join(base, "eventlog"), parsed.Digest
+}
+
+func TestMeasureInitdataNativeRPCAndIdempotentAAEL(t *testing.T) {
+	path, digestPath, socket, eventlog, digest := measurementFixture(t)
+	listener, err := net.Listen("unix", socket)
+	require.NoError(t, err)
+	defer listener.Close()
+	server, err := ttrpc.NewServer()
+	require.NoError(t, err)
+	defer server.Close()
+	calls := 0
+	server.RegisterService("attestation_agent.AttestationAgentService", &ttrpc.ServiceDesc{Methods: map[string]ttrpc.Method{
+		"GetTeeType": nativeTeeTypeMethod("tdx"),
+		"ExtendRuntimeMeasurement": func(_ context.Context, unmarshal func(interface{}) error) (interface{}, error) {
+			request, response, err := nativeAAMessages()
+			require.NoError(t, err)
+			require.NoError(t, unmarshal(request))
+			wire, err := proto.Marshal(request)
+			require.NoError(t, err)
+			// Decode independently with protobuf wire primitives, checking the
+			// official field numbers and omitted optional RegisterIndex.
+			fields := map[protowire.Number]string{}
+			for len(wire) > 0 {
+				number, typ, n := protowire.ConsumeTag(wire)
+				require.Equal(t, protowire.BytesType, typ)
+				value, m := protowire.ConsumeString(wire[n:])
+				require.Positive(t, m)
+				fields[number] = value
+				wire = wire[n+m:]
+			}
+			require.Equal(t, map[protowire.Number]string{1: "confidentialcontainers.org", 2: "initdata", 3: digest}, fields)
+			calls++
+			require.NoError(t, os.WriteFile(eventlog, canonicalInitdataEvent(digest), 0600))
+			return response, nil
+		},
+	}})
+	go server.Serve(context.Background(), listener)
+	require.NoError(t, MeasureInitdata(context.Background(), path, digestPath, socket, eventlog))
+	require.NoError(t, MeasureInitdata(context.Background(), path, digestPath, "/no-second-rpc", eventlog))
+	require.Equal(t, 1, calls)
+}
+
+func TestMeasureInitdataRefusesChangedDigestAndExtraEvents(t *testing.T) {
+	path, digestPath, socket, eventlog, digest := measurementFixture(t)
+	require.NoError(t, os.WriteFile(digestPath, []byte("bad digest"), 0600))
+	require.ErrorContains(t, MeasureInitdata(context.Background(), path, digestPath, socket, eventlog), "digest differs")
+	require.NoError(t, os.WriteFile(digestPath, []byte(digest), 0600))
+	for _, invalid := range [][]byte{[]byte("legacy plaintext AAEL"), append(canonicalInitdataEvent(digest), canonicalInitdataEvent(digest)...), canonicalInitdataEvent("wrong digest")} {
+		require.NoError(t, os.WriteFile(eventlog, invalid, 0600))
+		require.ErrorContains(t, MeasureInitdata(context.Background(), path, digestPath, socket, eventlog), "unexpected or duplicate")
+	}
+}
