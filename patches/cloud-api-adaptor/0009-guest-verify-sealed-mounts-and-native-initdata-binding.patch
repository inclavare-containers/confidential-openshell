+func nativeTeeTypeMethod(tee string) ttrpc.Method {
+	return func(_ context.Context, unmarshal func(interface{}) error) (interface{}, error) {
+		request, _, err := nativeAAMessages()
+		if err != nil {
+			return nil, err
+		}
+		file := request.Descriptor().ParentFile()
+		teeRequest := dynamicpb.NewMessage(file.Messages().ByName("GetTeeTypeRequest"))
+		if err := unmarshal(teeRequest); err != nil {
+			return nil, err
+		}
+		response := dynamicpb.NewMessage(file.Messages().ByName("GetTeeTypeResponse"))
+		response.Set(response.Descriptor().Fields().ByName("tee"), protoreflect.ValueOfString(tee))
+		return response, nil
+	}
+}
