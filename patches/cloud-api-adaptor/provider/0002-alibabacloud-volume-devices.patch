@@ -117,9 +121,13 @@ func TestAttachAlibabaDataDisksWaitsForReadyStates(t *testing.T) {
 			disk.Status = tea.String("Attaching")
 		}
 	}
-	if err := p.attachDataDisks(context.Background(), "i-peerpod", []provider.CloudVolume{{DiskID: "d-one"}}); err != nil {
+	devices, err := p.attachDataDisks(context.Background(), "i-peerpod", []provider.CloudVolume{{DiskID: "d-one"}}, false)
+	if err != nil {
 		t.Fatal(err)
 	}
+	if devices["d-one"] != "/dev/disk/by-id/virtio-serial-d-one" {
+		t.Fatal(devices)
+	}
 	if client.instanceQueries != 3 || client.diskQueries != 2 {
 		t.Fatalf("instance queries=%d, disk queries=%d", client.instanceQueries, client.diskQueries)
 	}
@@ -129,7 +137,7 @@ func TestAttachAlibabaDataDisksReturnsAPIErrors(t *testing.T) {
 	for _, failure := range []error{errors.New("disk is in another zone"), context.DeadlineExceeded, &tea.SDKError{Code: tea.String("IncorrectInstanceStatus")}} {
 		p, client := newFakeVolumeProvider(t, "Running")
 		client.attachError = failure
-		err := p.attachDataDisks(context.Background(), "i-peerpod", []provider.CloudVolume{{DiskID: "d-one"}})
+		_, err := p.attachDataDisks(context.Background(), "i-peerpod", []provider.CloudVolume{{DiskID: "d-one"}}, false)
 		if !errors.Is(err, failure) || len(client.attachRequests) != 1 || client.diskQueries != 0 {
