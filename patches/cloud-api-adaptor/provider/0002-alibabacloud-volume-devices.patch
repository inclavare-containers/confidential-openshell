 		}
@@ -151,7 +159,7 @@ func TestAttachAlibabaDataDisksHonorsCancellation(t *testing.T) {
 					cancel()
 				}
 			}
-			if err := p.attachDataDisks(ctx, "i-peerpod", []provider.CloudVolume{{DiskID: "d-one"}}); !errors.Is(err, context.Canceled) {
