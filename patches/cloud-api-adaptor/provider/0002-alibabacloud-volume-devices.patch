 				t.Fatalf("expected cancellation, got %v", err)
 			}
 			if stage == "before attach" && len(client.attachRequests) != 0 {
@@ -163,7 +171,7 @@ func TestAttachAlibabaDataDisksHonorsCancellation(t *testing.T) {
 
 func TestAttachAlibabaDataDisksWithoutVolumes(t *testing.T) {
