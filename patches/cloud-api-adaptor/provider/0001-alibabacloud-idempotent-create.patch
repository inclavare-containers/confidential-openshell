 	ecsClient
-	images []string
+	images   []string
+	requests []*ecs.RunInstancesRequest
 }
 
 func (c *imageRecordingECSClient) RunInstances(req *ecs.RunInstancesRequest) (*ecs.RunInstancesResponse, error) {
 	c.images = append(c.images, tea.StringValue(req.ImageId))
+	c.requests = append(c.requests, req)
 	// Stop at the API boundary; this test only needs the submitted request.
 	return nil, errors.New("stop after recording RunInstances")
 }
@@ -55,3 +57,26 @@ func TestCreateInstanceImageOverride(t *testing.T) {
 		})
 	}
 }
+
+func TestCreateInstanceRetriesUseStableParameters(t *testing.T) {
+	client := &imageRecordingECSClient{}
+	p := &alibabaCloudProvider{ecsClient: client, serviceConfig: &Config{
+		ImageID: "image-default", InstanceType: "ecs.g8i.xlarge",
+		Tags: map[string]string{"z": "last", "a": "first", "SandboxId": "ignored"},
+	}}
+	for _, id := range []string{"sandbox-1", "sandbox-1", "sandbox-2"} {
+		_, err := p.CreateInstance(t.Context(), "pod", id, &cloudinit.CloudConfig{}, provider.InstanceTypeSpec{})
+		require.ErrorContains(t, err, "stop after recording RunInstances")
+	}
+	require.Len(t, client.requests, 3)
+	assert.Equal(t, client.requests[0], client.requests[1])
+	assert.NotEmpty(t, tea.StringValue(client.requests[0].ClientToken))
+	assert.NotEqual(t, tea.StringValue(client.requests[0].ClientToken), tea.StringValue(client.requests[2].ClientToken))
+	tags := client.requests[0].Tag
+	require.Len(t, tags, 3)
+	assert.Equal(t, "SandboxId", tea.StringValue(tags[2].Key))
+	assert.Equal(t, "sandbox-1", tea.StringValue(tags[2].Value))
+	_, err := p.CreateInstance(t.Context(), "pod", "", &cloudinit.CloudConfig{}, provider.InstanceTypeSpec{})
+	require.ErrorContains(t, err, "sandbox ID is required")
+	require.Len(t, client.requests, 3)
+}
