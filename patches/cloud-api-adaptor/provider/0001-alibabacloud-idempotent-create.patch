 	// Public IP address
 	var publicIPAddr *netip.Addr
 
@@ -246,13 +252,23 @@ func (p *alibabaCloudProvider) CreateInstance(ctx context.Context, podName, sand
 		return nil, err
 	}
 
-	tags := make([]*ecs.RunInstancesRequestTag, 0)
-	for k, v := range p.serviceConfig.Tags {
+	tagKeys := make([]string, 0, len(p.serviceConfig.Tags))
+	for key := range p.serviceConfig.Tags {
+		if key != sandboxIDTagKey {
+			tagKeys = append(tagKeys, key)
+		}
+	}
+	sort.Strings(tagKeys)
+	tags := make([]*ecs.RunInstancesRequestTag, 0, len(tagKeys)+2)
+	for _, k := range tagKeys {
 		tags = append(tags, &ecs.RunInstancesRequestTag{
 			Key:   tea.String(k),
-			Value: tea.String(v),
+			Value: tea.String(p.serviceConfig.Tags[k]),
 		})
 	}
+	tags = append(tags, &ecs.RunInstancesRequestTag{
+		Key: tea.String(sandboxIDTagKey), Value: tea.String(sandboxID),
+	})
 
 	var req *ecs.RunInstancesRequest
 
@@ -268,6 +284,8 @@ func (p *alibabaCloudProvider) CreateInstance(ctx context.Context, podName, sand
 	}
 
 	req = &ecs.RunInstancesRequest{
+		// ECS owns idempotency; retrying the same CRI sandbox uses the same token.
+		ClientToken:        tea.String(fmt.Sprintf("%x", sha256.Sum256([]byte(sandboxID)))),
 		RegionId:           tea.String(p.serviceConfig.Region),
 		MinAmount:          tea.Int32(1),
 		Amount:             tea.Int32(1),
@@ -309,13 +327,14 @@ func (p *alibabaCloudProvider) CreateInstance(ctx context.Context, podName, sand
 	}
 
 	logger.Printf("CreateInstance: name: %q", instanceName)
-
-	result, err := p.ecsClient.RunInstances(req)
+	response, err := p.ecsClient.RunInstances(req)
 	if err != nil {
-		return nil, fmt.Errorf("creating instance (%v) returned error: %s", result, err)
+		return nil, fmt.Errorf("create Alibaba Cloud instance: %w", err)
 	}
-
-	instanceID := *result.Body.InstanceIdSets.InstanceIdSet[0]
+	if response == nil || response.Body == nil || response.Body.InstanceIdSets == nil || len(response.Body.InstanceIdSets.InstanceIdSet) != 1 || tea.StringValue(response.Body.InstanceIdSets.InstanceIdSet[0]) == "" {
+		return nil, errors.New("RunInstances returned no unique instance ID")
+	}
+	instanceID := tea.StringValue(response.Body.InstanceIdSets.InstanceIdSet[0])
 	logger.Printf("created an instance %s for sandbox %s", instanceID, sandboxID)
 
 	// Create partial instance to return on error (allows caller to cleanup)
@@ -349,7 +368,7 @@ func (p *alibabaCloudProvider) CreateInstance(ctx context.Context, podName, sand
 	}
 	logger.Printf("Instance %s is ready.", instanceID)
 
-	ips, err := p.getIPs(*result.Body.InstanceIdSets.InstanceIdSet[0], p.ecsClient)
