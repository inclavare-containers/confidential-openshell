+func (f *fakeCleanupECSClient) rebindDisksLocked() {
+	for _, disk := range f.disks {
+		if disk.instanceID == f.instanceID {
+			disk.status = "In_use"
+			disk.instanceID = f.rebindInstanceID
+		}
+	}
+}
