@@ -0,0 +1,55 @@
+// Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package k8sops
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-api-adaptor/pkg/util"
+	cri "github.com/containerd/containerd/pkg/cri/annotations"
+	"github.com/stretchr/testify/require"
+	"k8s.io/client-go/kubernetes"
+	"k8s.io/client-go/rest"
+)
+
+func TestCSISelectionResolvesRemotePodUID(t *testing.T) {
+	calls := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		require.Equal(t, "/api/v1/namespaces/default/pods/pod-a", r.URL.Path)
+		calls++
+		w.Header().Set("Content-Type", "application/json")
+		_, err := w.Write([]byte(`{"apiVersion":"v1","kind":"Pod","metadata":{"name":"pod-a","namespace":"default","uid":"uid-a"}}`))
+		require.NoError(t, err)
+	}))
+	defer server.Close()
+	client, err := kubernetes.NewForConfig(&rest.Config{Host: server.URL})
+	require.NoError(t, err)
+	service := &PeerPodService{client: client}
+	directory := t.TempDir()
+	previous := util.KataDirectVolumesDir
+	util.KataDirectVolumesDir = directory
+	defer func() { util.KataDirectVolumesDir = previous }()
+	for _, volume := range []struct{ uid, name, disk string }{{"uid-a", "pvc-1", "disk-a"}, {"uid-b", "pvc-2", "disk-b"}, {"uid-a", "pvc-3", "disk-c"}} {
+		target := "/var/lib/kubelet/pods/" + volume.uid + "/volumes/kubernetes.io~csi/" + volume.name + "/mount"
+		record := filepath.Join(directory, base64.URLEncoding.EncodeToString([]byte(target)))
+		require.NoError(t, os.Mkdir(record, 0755))
+		data, err := json.Marshal(map[string]string{"device": volume.disk, "fstype": "ext4"})
+		require.NoError(t, err)
+		require.NoError(t, os.WriteFile(filepath.Join(record, "mountInfo.json"), data, 0600))
+	}
+	annotations := map[string]string{cri.SandboxName: "pod-a", cri.SandboxNamespace: "default"}
+	volumes, err := util.GetCSIVolumesForPod(annotations, func() (string, error) { return service.GetPodUID(context.Background(), "pod-a", "default") })
+	require.NoError(t, err)
+	require.Equal(t, 1, calls, "lookup must be shared across volume entries")
+	require.Len(t, volumes, 2)
+	require.Equal(t, "disk-a", volumes[0].DiskID)
+	require.Equal(t, "disk-c", volumes[1].DiskID)
+}
