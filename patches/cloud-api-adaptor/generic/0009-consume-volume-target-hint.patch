From c2dec96df60f95e324c7c6f3b9e863918f9e1b1d Mon Sep 17 00:00:00 2001
From: Weidong Sun <sunweidong@linux.alibaba.com>
Date: Wed, 4 Nov 2026 22:40:18 +0800
Subject: [PATCH] forwarder: consume the internal volume target hint

Keep the peer-pod volume target hint for APF's mount wait, then omit it
from the request forwarded to Kata Agent. The upstream genpolicy rules
reject unexpected annotations; this transport hint is not an agent input.

Signed-off-by: Weidong Sun <sunweidong@linux.alibaba.com>
Co-authored-by: Codex <noreply@openai.com>
---
 src/cloud-api-adaptor/pkg/forwarder/interceptor/interceptor.go      | 1 +
 src/cloud-api-adaptor/pkg/forwarder/interceptor/interceptor_test.go | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/src/cloud-api-adaptor/pkg/forwarder/interceptor/interceptor.go b/src/cloud-api-adaptor/pkg/forwarder/interceptor/interceptor.go
index d47fd4e9..f9131e1d 100644
--- a/src/cloud-api-adaptor/pkg/forwarder/interceptor/interceptor.go
+++ b/src/cloud-api-adaptor/pkg/forwarder/interceptor/interceptor.go
@@ -208,6 +208,7 @@ func (i *interceptor) CreateContainer(ctx context.Context, req *pb.CreateContain
 	}
 
 	volumeTargetPath := req.OCI.Annotations[volumeTargetPathKey]
+	delete(req.OCI.Annotations, volumeTargetPathKey)
 	volumeTargetPathSlice := strings.Split(volumeTargetPath, ",")
 	if len(req.OCI.Mounts) > 0 {
 		for _, m := range req.OCI.Mounts {
diff --git a/src/cloud-api-adaptor/pkg/forwarder/interceptor/interceptor_test.go b/src/cloud-api-adaptor/pkg/forwarder/interceptor/interceptor_test.go
index 8aa4d6c2..44b1bd4c 100644
--- a/src/cloud-api-adaptor/pkg/forwarder/interceptor/interceptor_test.go
+++ b/src/cloud-api-adaptor/pkg/forwarder/interceptor/interceptor_test.go
@@ -165,6 +165,7 @@ func TestInterceptorCreateContainer(t *testing.T) {
 		req := &pb.CreateContainerRequest{
 			ContainerId: "test-container",
 			OCI: &pb.Spec{
+				Annotations: map[string]string{volumeTargetPathKey: "/run/guest-volume"},
 				Linux: &pb.Linux{
 					Namespaces: []*pb.LinuxNamespace{},
 				},
@@ -176,6 +177,7 @@ func TestInterceptorCreateContainer(t *testing.T) {
 
 		require.NoError(t, err)
 		assert.True(t, mock.CreateContainerCalled)
+		assert.NotContains(t, req.OCI.Annotations, volumeTargetPathKey)
 
 		// Verify network namespace was added
 		found := false
-- 
2.43.7
