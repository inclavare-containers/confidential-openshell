--- /dev/null
+++ b/src/cloud-api-adaptor/pkg/forwarder/interceptor/volume_transaction_test.go
@@ -0,0 +1,62 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package interceptor
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-api-adaptor/pkg/util"
+	pb "github.com/kata-containers/kata-containers/src/runtime/virtcontainers/pkg/agent/protocols/grpc"
+	"github.com/stretchr/testify/require"
+)
+
+func TestCreateContainerRollsBackPreparationAndAgentFailure(t *testing.T) {
+	for _, tc := range []struct {
+		name                               string
+		preparationFailure, cleanupFailure bool
+	}{
+		{name: "agent rejection"}, {name: "preparation failure", preparationFailure: true}, {name: "failed rollback retained for destroy", cleanupFailure: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			owned := filepath.Join(t.TempDir(), "owned")
+			require.NoError(t, os.Mkdir(owned, 0700))
+			borrowed := filepath.Join(t.TempDir(), "borrowed")
+			require.NoError(t, os.Mkdir(borrowed, 0700))
+			unmountErr := errors.New("device busy")
+			cleaned := false
+			v := &preparedCloudVolume{sourcePath: owned, createdDirHere: true, mountedHere: true, unmount: func(string, int) error {
+				cleaned = true
+				if tc.cleanupFailure {
+					return unmountErr
+				}
+				return nil
+			}}
+			i := &interceptor{Redirector: &mockRedirector{createContainerError: errors.New("agent rejected container")}}
+			req := &pb.CreateContainerRequest{OCI: &pb.Spec{Linux: &pb.Linux{}, Annotations: map[string]string{util.CloudVolumesAnnotationKey: "{}"}}}
+			_, err := i.createContainer(context.Background(), req, func(context.Context, *pb.CreateContainerRequest, string) ([]*preparedCloudVolume, error) {
+				volumes := []*preparedCloudVolume{v, {sourcePath: borrowed}}
+				if tc.preparationFailure {
+					return volumes, errors.New("preparation failed")
+				}
+				return volumes, nil
+			})
+			require.Error(t, err)
+			require.True(t, cleaned, "early error skipped resource rollback")
+			require.DirExists(t, borrowed, "rollback removed a borrowed resource")
+			if tc.cleanupFailure {
+				require.ErrorIs(t, err, unmountErr)
+				require.Len(t, i.cloudVolumes, 1, "failed cleanup lost ownership")
+				tc.cleanupFailure = false
+				require.NoError(t, cleanupPreparedCloudVolumes(context.Background(), i.cloudVolumes))
+			} else {
+				require.Empty(t, i.cloudVolumes)
+			}
+			require.NoDirExists(t, owned)
+		})
+	}
+}
