From e72ea9828161bc9dad15568871979d239354d28d Mon Sep 17 00:00:00 2001
From: Weidong Sun <sunweidong@linux.alibaba.com>
Date: Tue, 3 Nov 2026 17:59:51 +0800
Subject: [PATCH] alibabacloud: keep image overrides local to each instance

A Pod's image override replaces the provider's configured default,
causing subsequent requests without an override to use the wrong image.

Keep the selected image in a local variable, following the AWS and Azure
fixes in #2291. Test an override followed by a request for the default
image with both unset and configured system disk sizes.

Fixes: #3436
Generated-by: OpenAI Codex
Signed-off-by: Weidong Sun <sunweidong@linux.alibaba.com>
---
 src/cloud-providers/alibabacloud/provider.go  |  9 +--
 .../alibabacloud/provider_test.go             | 57 +++++++++++++++++++
 2 files changed, 62 insertions(+), 4 deletions(-)
 create mode 100644 src/cloud-providers/alibabacloud/provider_test.go

diff --git a/src/cloud-providers/alibabacloud/provider.go b/src/cloud-providers/alibabacloud/provider.go
index 389f2d11..26312855 100644
--- a/src/cloud-providers/alibabacloud/provider.go
+++ b/src/cloud-providers/alibabacloud/provider.go
@@ -226,9 +226,10 @@ func (p *alibabaCloudProvider) CreateInstance(ctx context.Context, podName, sand
 
 	var req *ecs.RunInstancesRequest
 
+	imageID := p.serviceConfig.ImageID
 	if spec.Image != "" {
 		logger.Printf("Choosing %s from annotation as the ECS Image for the PodVM image", spec.Image)
-		p.serviceConfig.ImageID = spec.Image
+		imageID = spec.Image
 	}
 
 	securityGroupIds := []*string{}
@@ -240,7 +241,7 @@ func (p *alibabaCloudProvider) CreateInstance(ctx context.Context, podName, sand
 		RegionId:           tea.String(p.serviceConfig.Region),
 		MinAmount:          tea.Int32(1),
 		Amount:             tea.Int32(1),
-		ImageId:            tea.String(p.serviceConfig.ImageID),
+		ImageId:            tea.String(imageID),
 		InstanceType:       tea.String(instanceType),
 		InstanceChargeType: tea.String("PostPaid"), // pay-as-you-go
 		SecurityGroupIds:   securityGroupIds,
@@ -269,12 +270,12 @@ func (p *alibabaCloudProvider) CreateInstance(ctx context.Context, podName, sand
 
 	// Add block device mappings to the instance to set the root volume size
 	if p.serviceConfig.SystemDiskSize > 0 {
-		req.ImageId = tea.String(p.serviceConfig.ImageID)
+		req.ImageId = tea.String(imageID)
 		req.SystemDisk = &ecs.RunInstancesRequestSystemDisk{
 			Size:     tea.String(strconv.Itoa(p.serviceConfig.SystemDiskSize)),
 			Category: tea.String("cloud_essd"),
 		}
-		logger.Printf("Setting the SystemDisk size to %d GiB with ImageId %s", p.serviceConfig.SystemDiskSize, p.serviceConfig.ImageID)
+		logger.Printf("Setting the SystemDisk size to %d GiB with ImageId %s", p.serviceConfig.SystemDiskSize, imageID)
 	}
 
 	logger.Printf("CreateInstance: name: %q", instanceName)
diff --git a/src/cloud-providers/alibabacloud/provider_test.go b/src/cloud-providers/alibabacloud/provider_test.go
new file mode 100644
index 00000000..1d7209f7
--- /dev/null
+++ b/src/cloud-providers/alibabacloud/provider_test.go
@@ -0,0 +1,57 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package alibabacloud
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	ecs "github.com/alibabacloud-go/ecs-20140526/v4/client"
+	"github.com/alibabacloud-go/tea/tea"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	provider "github.com/confidential-containers/cloud-api-adaptor/src/cloud-providers"
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-providers/util/cloudinit"
+)
+
+type imageRecordingECSClient struct {
+	ecsClient
+	images []string
+}
+
+func (c *imageRecordingECSClient) RunInstances(req *ecs.RunInstancesRequest) (*ecs.RunInstancesResponse, error) {
+	c.images = append(c.images, tea.StringValue(req.ImageId))
+	// Stop at the API boundary; this test only needs the submitted request.
+	return nil, errors.New("stop after recording RunInstances")
+}
+
+func TestCreateInstanceImageOverride(t *testing.T) {
+	for _, tc := range []struct {
+		name           string
+		systemDiskSize int
+	}{
+		{name: "default system disk"},
+		{name: "configured system disk", systemDiskSize: 40},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			config := &Config{
+				ImageID: "image-default", InstanceType: "ecs.g8i.xlarge",
+				SystemDiskSize: tc.systemDiskSize,
+			}
+			client := &imageRecordingECSClient{}
+			p := &alibabaCloudProvider{serviceConfig: config, ecsClient: client}
+
+			for _, image := range []string{"image-custom", ""} {
+				_, err := p.CreateInstance(context.Background(), "test-pod", "test-sandbox",
+					&cloudinit.CloudConfig{}, provider.InstanceTypeSpec{Image: image})
+				require.ErrorContains(t, err, "stop after recording RunInstances")
+			}
+
+			assert.Equal(t, []string{"image-custom", "image-default"}, client.images)
+			assert.Equal(t, "image-default", config.ImageID)
+		})
+	}
+}
