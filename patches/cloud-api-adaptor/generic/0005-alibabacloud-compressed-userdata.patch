diff --git a/src/cloud-providers/alibabacloud/userdata_test.go b/src/cloud-providers/alibabacloud/userdata_test.go
new file mode 100644
index 00000000..7113457d
--- /dev/null
+++ b/src/cloud-providers/alibabacloud/userdata_test.go
@@ -0,0 +1,93 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package alibabacloud
+
+import (
+	"bytes"
+	"compress/gzip"
+	"encoding/base64"
+	"io"
+	"math/rand"
+	"strings"
+	"testing"
+)
+
+func TestEncodeUserData(t *testing.T) {
+	noise := make([]byte, 64*1024)
+	if _, err := rand.New(rand.NewSource(1)).Read(noise); err != nil {
+		t.Fatal(err)
+	}
+	tests := []struct {
+		name       string
+		data       string
+		compressed bool
+		minPayload int
+	}{
+		{
+			name:       "at compression threshold",
+			data:       strings.Repeat("x", 32*1024),
+			compressed: false,
+		},
+		{
+			name:       "over compression threshold",
+			data:       strings.Repeat("x", 32*1024+1),
+			compressed: true,
+		},
+		{
+			name: "small uncompressed payload",
+			data: "#cloud-config",
+		},
+		{
+			name:       "large payload round trip",
+			data:       string(bytes.Repeat(noise, 2)),
+			compressed: true,
+			minPayload: 32*1024 + 1,
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			encoded, err := encodeUserData(test.data)
+			if err != nil {
+				t.Fatal(err)
+			}
+			encodedAgain, err := encodeUserData(test.data)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if encodedAgain != encoded {
+				t.Fatal("user data encoding is not deterministic")
+			}
+			payload, err := base64.StdEncoding.DecodeString(encoded)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(payload) < test.minPayload {
+				t.Fatalf("payload is %d bytes before base64; expected at least %d", len(payload), test.minPayload)
+			}
+
+			if !test.compressed {
+				if string(payload) != test.data {
+					t.Fatal("small user data changed")
+				}
+				return
+			}
+
+			reader, err := gzip.NewReader(bytes.NewReader(payload))
+			if err != nil {
+				t.Fatal(err)
+			}
+			decoded, err := io.ReadAll(reader)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := reader.Close(); err != nil {
+				t.Fatal(err)
+			}
+			if string(decoded) != test.data {
+				t.Fatal("compressed user data did not round-trip")
+			}
+		})
+	}
+}
