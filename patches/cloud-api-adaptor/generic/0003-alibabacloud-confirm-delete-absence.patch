+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package alibabacloud
+
+import (
+	"errors"
+	"fmt"
+	ecs "github.com/alibabacloud-go/ecs-20140526/v4/client"
+	"github.com/alibabacloud-go/tea/tea"
+)
+
+func isAlibabaInstanceNotFoundError(err error) bool {
+	var sdkErr *tea.SDKError
+	return errors.As(err, &sdkErr) && tea.StringValue(sdkErr.Code) == "InvalidInstanceId.NotFound"
+}
+
+// deleteInstanceAndConfirmAbsence preserves deletion errors unless an exact
+// instance read confirms absence. A nil error alone means deletion was accepted.
+func (p *alibabaCloudProvider) deleteInstanceAndConfirmAbsence(instanceID string) (bool, error) {
+	_, err := p.ecsClient.DeleteInstance(&ecs.DeleteInstanceRequest{InstanceId: tea.String(instanceID), Force: tea.Bool(true)})
+	if err == nil {
+		return false, nil
+	}
+	if isAlibabaInstanceNotFoundError(err) {
+		return true, nil
+	}
+	// A tag-conditioned denial can race another caller's successful deletion.
+	// Only a typed not-found for this exact ID confirms that outcome.
+	_, readErr := p.ecsClient.DescribeInstanceAttribute(&ecs.DescribeInstanceAttributeRequest{InstanceId: tea.String(instanceID)})
+	if isAlibabaInstanceNotFoundError(readErr) {
+		return true, nil
+	}
+	return false, fmt.Errorf("delete instance %s: %w", instanceID, err)
+}
