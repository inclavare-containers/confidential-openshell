+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package cloud
+
+import (
+	"bytes"
+	"compress/gzip"
+	"encoding/base64"
+	"io"
+	"testing"
+
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-api-adaptor/pkg/paths"
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-providers/util/cloudinit"
+	yaml "gopkg.in/yaml.v2"
+)
+
+func TestNativeCloudConfigPreservesMeasuredInitdata(t *testing.T) {
+	raw := []byte("version = '0.1.0'\nalgorithm = 'sha384'\n[data]\n'policy.rego' = 'package agent_policy'\n\n")
+	var packed bytes.Buffer
+	writer := gzip.NewWriter(&packed)
+	if _, err := writer.Write(raw); err != nil {
+		t.Fatal(err)
+	}
+	if err := writer.Close(); err != nil {
+		t.Fatal(err)
+	}
+	config := &cloudinit.CloudConfig{WriteFiles: []cloudinit.WriteFile{
+		{Path: paths.InitDataPath, Content: base64.StdEncoding.EncodeToString(packed.Bytes())},
+	}}
+	generated, err := config.Generate()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var parsed cloudinit.CloudConfig
+	if err := yaml.UnmarshalStrict([]byte(generated), &parsed); err != nil {
+		t.Fatal(err)
+	}
+	// Native cloud-init adds a transport newline. Go's base64 decoder accepts
+	// it; guest validation must normalize only that outer transport boundary.
+	compressed, err := base64.StdEncoding.Strict().DecodeString(parsed.WriteFiles[0].Content)
+	if err != nil {
+		t.Fatal(err)
+	}
+	reader, err := gzip.NewReader(bytes.NewReader(compressed))
+	if err != nil {
+		t.Fatal(err)
+	}
+	decoded, err := io.ReadAll(reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(decoded, raw) {
+		t.Fatal("native cloud-config changed measured initdata bytes")
+	}
+}
