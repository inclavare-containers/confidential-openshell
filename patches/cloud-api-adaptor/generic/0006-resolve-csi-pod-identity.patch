diff --git a/src/cloud-api-adaptor/pkg/adaptor/k8sops/peerpod.go b/src/cloud-api-adaptor/pkg/adaptor/k8sops/peerpod.go
index 918908da..e5c47267 100644
--- a/src/cloud-api-adaptor/pkg/adaptor/k8sops/peerpod.go
+++ b/src/cloud-api-adaptor/pkg/adaptor/k8sops/peerpod.go
@@ -91,6 +91,22 @@ func (s *PeerPodService) getPod(podname string, podns string) (*v1.Pod, error) {
 	return pod, nil
 }
 
+// GetPodUID resolves the Pod identity for a remote hypervisor request that
+// provides only a name and namespace.
+func (s *PeerPodService) GetPodUID(ctx context.Context, podname, podns string) (string, error) {
+	if s == nil || s.client == nil {
+		return "", errors.New("PeerPodService Kubernetes client is unavailable")
+	}
+	pod, err := s.client.CoreV1().Pods(podns).Get(ctx, podname, metav1.GetOptions{})
+	if err != nil {
+		return "", err
+	}
+	if pod.UID == "" {
+		return "", fmt.Errorf("pod %s/%s has an empty UID", podns, podname)
+	}
+	return string(pod.UID), nil
+}
+
 // make the pod an owner of a PeerPod
 func (s *PeerPodService) OwnPeerPod(podname string, podns string, instanceID string) error {
 	pod, err := s.getPod(podname, podns)
