@@ -180,15 +180,16 @@ type CloudVolumeAnnotation struct {
 // mountInfo.json files written by the CSI block driver. Each file
 // describes a cloud volume that should be attached to the PodVM.
 // Volumes are filtered by pod UID (from annotations) to prevent
-// cross-pod volume leakage on multi-tenant nodes.
-func GetCSIVolumesForPod(annotations map[string]string) []provider.CloudVolume {
+// cross-pod volume leakage on multi-tenant nodes. If annotations omit the UID,
+// lookupPodUID is called once, and only when a CSI volume entry is present.
+func GetCSIVolumesForPod(annotations map[string]string, lookupPodUID func() (string, error)) ([]provider.CloudVolume, error) {
 	var volumes []provider.CloudVolume
 
 	podUID := GetPodUID(annotations)
 
 	entries, err := os.ReadDir(KataDirectVolumesDir)
 	if err != nil {
-		return nil
+		return nil, nil
 	}
 
 	for _, entry := range entries {
@@ -206,7 +207,21 @@ func GetCSIVolumesForPod(annotations map[string]string) []provider.CloudVolume {
 			continue
 		}
 
-		if podUID != "" && !strings.Contains(decodedStr, "/pods/"+podUID+"/") {
+		// The remote hypervisor may send only Pod name and namespace. Resolve
+		// its UID once, before selecting any CSI volume from this shared tree.
+		if podUID == "" {
+			if lookupPodUID == nil {
+				return nil, fmt.Errorf("Pod UID is required to select CSI volumes")
+			}
+			podUID, err = lookupPodUID()
+			if err != nil {
+				return nil, fmt.Errorf("look up Pod UID for CSI volumes: %w", err)
+			}
+			if podUID == "" {
+				return nil, fmt.Errorf("Pod UID lookup returned an empty UID")
+			}
+		}
+		if !strings.Contains(decodedStr, "/pods/"+podUID+"/") {
 			continue
 		}
 
@@ -239,5 +254,5 @@ func GetCSIVolumesForPod(annotations map[string]string) []provider.CloudVolume {
 		})
 	}
 
-	return volumes
+	return volumes, nil
 }
