+// Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package util
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestDecodeCloudVolumeAnnotations(t *testing.T) {
+	valid := `{"vol-0":{"mount_point":"/workspace","fs_type":"ext4","lun":"0","disk_id":"d-workspace123","readonly":true,"options":["noatime","ro"],"fs_group":"2000"}}`
+	volumes, err := DecodeCloudVolumeAnnotations(valid)
+	require.NoError(t, err)
+	require.Len(t, volumes, 1)
+	assert.True(t, volumes["vol-0"].ReadOnly)
+	assert.Equal(t, []string{"noatime", "ro"}, volumes["vol-0"].Options)
+
+	for name, annotation := range map[string]string{
+		"unsupported filesystem": strings.Replace(valid, "ext4", "btrfs", 1),
+		"unsafe option":          strings.Replace(valid, "noatime", "bind", 1),
+		"conflicting options":    strings.Replace(valid, "noatime", "rw", 1),
+	} {
+		t.Run(name, func(t *testing.T) {
+			_, err := DecodeCloudVolumeAnnotations(annotation)
+			require.Error(t, err)
+		})
+	}
+
+	optionReadOnly := `{"vol-0":{"mount_point":"/workspace","fs_type":"ext4","lun":"0","disk_id":"d-one","readonly":false,"options":["ro"]}}`
+	volumes, err = DecodeCloudVolumeAnnotations(optionReadOnly)
+	require.NoError(t, err)
+	assert.True(t, volumes["vol-0"].ReadOnly)
+	assert.Equal(t, []string{"ro"}, volumes["vol-0"].Options)
+
+	unknownField := `{"vol-0":{"mount_point":"/workspace","fs_type":"ext4","lun":"0","disk_id":"d-one","future_field":true}}`
+	_, err = DecodeCloudVolumeAnnotations(unknownField)
+	require.NoError(t, err)
+	legacy := `{"vol-0":{"mount_point":"/data","lun":"0","disk_id":"disk-0"}}`
+	volumes, err = DecodeCloudVolumeAnnotations(legacy)
+	require.NoError(t, err)
+	assert.False(t, volumes["vol-0"].ReadOnly)
+	assert.Equal(t, "ext4", volumes["vol-0"].FSType)
+}
+
+func TestNormalizeDirectVolumeOptions(t *testing.T) {
+	options, readOnly, err := NormalizeDirectVolumeOptions([]string{"noexec", "ro"}, false)
+	require.NoError(t, err)
+	assert.True(t, readOnly)
+	assert.Equal(t, []string{"noexec", "ro"}, options)
+
+	_, _, err = NormalizeDirectVolumeOptions([]string{"rw"}, true)
+	require.ErrorContains(t, err, "readonly volume conflicts")
+}
+
+func TestDecodeCloudVolumeAnnotationsPreservesExistingIdentities(t *testing.T) {
+	volumes := make(map[string]CloudVolumeAnnotation)
+	for index := 0; index < 65; index++ {
+		volumes[fmt.Sprintf("data-%d", index)] = CloudVolumeAnnotation{
+			MountPoint: "/data", LUN: "7", DiskID: "shared-disk",
+		}
+	}
+	encoded, err := json.Marshal(volumes)
+	require.NoError(t, err)
+	decoded, err := DecodeCloudVolumeAnnotations(string(encoded))
+	require.NoError(t, err)
+	require.Len(t, decoded, 65)
+	assert.Equal(t, "7", decoded["data-0"].LUN)
+	_, err = DecodeCloudVolumeAnnotations(`{"data":{"mount_point":"/data","lun":"7"}}`)
+	require.NoError(t, err, "legacy LUN discovery does not require a disk ID")
+}
+
+func TestNormalizeDirectVolumeOptionsPreservesFilesystemFlags(t *testing.T) {
+	flags := []string{"commit=30", "nouuid", "context=CaseSensitive", "sync", "async"}
+	normalized, readOnly, err := NormalizeDirectVolumeOptions(flags, false)
+	require.NoError(t, err)
+	assert.False(t, readOnly)
+	assert.Equal(t, flags, normalized)
+	_, _, err = NormalizeDirectVolumeOptions([]string{"nodev,rw"}, true)
+	require.ErrorContains(t, err, "readonly volume conflicts")
+}
