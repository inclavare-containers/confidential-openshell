+func TestCloudVolumesReadsCurrentMountProperties(t *testing.T) {
+	dir := t.TempDir()
+	overrideKataDirectVolumesDir(t, dir)
+	service, cleanup := setupMockAgentAndService(t)
+	defer cleanup()
+	uid := "pod-current-properties"
+	source := "/var/lib/kubelet/pods/" + uid + "/volumes/kubernetes.io~csi/pvc-data/mount"
+	for _, properties := range []struct {
+		readonly bool
+		group    string
+		option   string
+	}{
+		{false, "2000", "noatime"}, {true, "3000", "nodev"},
+	} {
+		writeTestMountInfo(t, dir, source, map[string]interface{}{
+			"device": "disk-properties", "readonly": properties.readonly,
+			"fs-group": properties.group, "options": []string{properties.option},
+		})
+		req := newCreateContainerRequest("current-properties").
+			withAnnotations(map[string]string{"io.kubernetes.cri.sandbox-uid": uid}).
+			withMounts(&pb.Mount{Destination: "/data", Source: source, Type: "bind"}).build()
+		_, err := service.CreateContainer(context.Background(), req)
+		require.NoError(t, err)
+		volumes, err := util.DecodeCloudVolumeAnnotations(req.OCI.Annotations[util.CloudVolumesAnnotationKey])
+		require.NoError(t, err)
+		require.Len(t, volumes, 1)
+		assert.Equal(t, properties.readonly, volumes["vol-0"].ReadOnly)
+		assert.Equal(t, properties.group, volumes["vol-0"].FSGroup)
+		assert.Contains(t, volumes["vol-0"].Options, properties.option)
+	}
+}
