+func TestCloudVolumes_MountProperties(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		readOnly bool
+		options  []string
+	}{
+		{name: "readonly field", readOnly: true, options: []string{"nodev"}},
+		{name: "ro option", options: []string{"ro", "nosuid"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := t.TempDir()
+			overrideKataDirectVolumesDir(t, dir)
+			service, cleanup := setupMockAgentAndService(t)
+			defer cleanup()
+			source := "/var/lib/kubelet/pods/uid-properties/volumes/kubernetes.io~csi/pvc-data/mount"
+			writeTestMountInfo(t, dir, source, map[string]interface{}{
+				"device": "disk-properties", "readonly": tc.readOnly, "options": tc.options,
+				"fs-group": "2000", "future-extension": true,
+			})
+			req := newCreateContainerRequest("mount-properties").
+				withAnnotations(map[string]string{"io.kubernetes.cri.sandbox-uid": "uid-properties"}).
+				withMounts(&pb.Mount{Destination: "/data", Source: source, Type: "bind"}).build()
+			_, err := service.CreateContainer(context.Background(), req)
+			require.NoError(t, err)
+			decoded, err := util.DecodeCloudVolumeAnnotations(req.OCI.Annotations[util.CloudVolumesAnnotationKey])
+			require.NoError(t, err)
+			require.Len(t, decoded, 1)
+			volume := decoded["vol-0"]
+			assert.True(t, volume.ReadOnly)
+			assert.Contains(t, volume.Options, "ro")
+			for _, option := range tc.options {
+				assert.Contains(t, volume.Options, option)
+			}
+			assert.Equal(t, "2000", volume.FSGroup)
+			assert.Equal(t, "ext4", volume.FSType)
+		})
+	}
+}
