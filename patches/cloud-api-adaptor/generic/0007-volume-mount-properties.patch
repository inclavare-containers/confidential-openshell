+// SPDX-License-Identifier: Apache-2.0
+
+package util
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"path/filepath"
+	"strconv"
+	"strings"
+)
+
+type CloudVolumeAnnotation struct {
+	MountPoint string   `json:"mount_point"`
+	FSType     string   `json:"fs_type"`
+	LUN        string   `json:"lun"`
+	DiskID     string   `json:"disk_id"`
+	ReadOnly   bool     `json:"readonly"`
+	Options    []string `json:"options,omitempty"`
+	FSGroup    string   `json:"fs_group,omitempty"`
+}
+
+// DecodeCloudVolumeAnnotations preserves the existing guest mount checks and
+// normalizes access options without imposing a new volume identity scheme.
+func DecodeCloudVolumeAnnotations(data string) (map[string]CloudVolumeAnnotation, error) {
+	var volumes map[string]CloudVolumeAnnotation
+	if err := json.Unmarshal([]byte(data), &volumes); err != nil {
+		return nil, err
+	}
+	for name, volume := range volumes {
+		if filepath.Base(name) != name || name == "." || name == ".." {
+			return nil, fmt.Errorf("cloud volume %q has unsafe name", name)
+		}
+		if volume.MountPoint == "" || volume.LUN == "" {
+			return nil, fmt.Errorf("cloud volume %s missing required mount_point or lun field", name)
+		}
+		if volume.FSType == "" {
+			volume.FSType = "ext4"
+		}
+		if !allowedDirectVolumeFSType(volume.FSType) {
+			return nil, fmt.Errorf("cloud volume %s has unsupported filesystem type", name)
+		}
+		lun, err := strconv.Atoi(volume.LUN)
+		if err != nil || lun < 0 {
+			return nil, fmt.Errorf("cloud volume %s has invalid lun %q", name, volume.LUN)
+		}
+		volume.Options, volume.ReadOnly, err = NormalizeDirectVolumeOptions(volume.Options, volume.ReadOnly)
+		if err != nil {
+			return nil, err
+		}
+		volumes[name] = volume
+	}
+	return volumes, nil
+}
+
+func allowedDirectVolumeFSType(fsType string) bool {
+	return fsType == "ext4" || fsType == "ext3" || fsType == "xfs"
+}
+
+// NormalizeDirectVolumeOptions keeps filesystem-specific options and their
+// order intact. Access flags must agree; operation flags cannot replace the
+// requested device/filesystem mount with a bind, remount or propagation change.
+func NormalizeDirectVolumeOptions(values []string, readOnly bool) ([]string, bool, error) {
+	options := make([]string, 0, len(values)+1)
+	hasRO, hasRW := false, false
+	for _, value := range values {
+		for _, item := range strings.Split(value, ",") {
+			option := strings.TrimSpace(item)
+			if option == "" {
+				continue
+			}
+			switch option {
+			case "bind", "rbind", "remount", "move", "shared", "rshared", "slave", "rslave", "private", "rprivate", "unbindable", "runbindable":
+				return nil, false, fmt.Errorf("mount operation %q is not a filesystem option", option)
+			case "ro":
+				hasRO = true
+			case "rw":
+				hasRW = true
+			}
+			options = append(options, option)
+		}
+	}
+	readOnly = readOnly || hasRO
+	if readOnly && hasRW {
+		return nil, false, errors.New("readonly volume conflicts with mount option \"rw\"")
+	}
+	if readOnly && !hasRO {
+		options = append(options, "ro")
+	}
+	return options, readOnly, nil
+}
