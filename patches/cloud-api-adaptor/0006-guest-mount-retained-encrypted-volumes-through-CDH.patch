diff --git a/src/cloud-api-adaptor/pkg/forwarder/interceptor/workspace.go b/src/cloud-api-adaptor/pkg/forwarder/interceptor/workspace.go
new file mode 100644
index 00000000..09d75a6d
--- /dev/null
+++ b/src/cloud-api-adaptor/pkg/forwarder/interceptor/workspace.go
@@ -0,0 +1,267 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package interceptor
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"golang.org/x/sys/unix"
+	"io"
+	"net/url"
+	"os"
+	"os/exec"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-api-adaptor/pkg/initdata"
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-api-adaptor/pkg/util"
+	toml "github.com/pelletier/go-toml/v2"
+)
+
+const (
+	workspacePolicyName   = "workspace.toml"
+	workspaceInitdataPath = "/run/peerpod/initdata"
+	workspaceInitializer  = "/usr/libexec/peerpod/initialize-workspace-volume"
+	workspaceMaxInitdata  = 2 << 20
+)
+
+// The disk list comes from the operator's workspace journal, measured as exact
+// initdata bytes. Host-provided annotations cannot authorize another disk/key.
+type workspacePolicy struct {
+	Version         string   `toml:"version"`
+	KeyURI          string   `toml:"key_uri"`
+	DiskIDs         []string `toml:"disk_ids"`
+	AllowInitialize bool     `toml:"allow_initialize"`
+	EncryptionType  string   `toml:"encryption_type"`
+	FilesystemType  string   `toml:"filesystem_type"`
+}
+
+func loadWorkspacePolicy(path string) (workspacePolicy, error) {
+	var policy workspacePolicy
+	info, err := os.Lstat(path)
+	if err != nil {
+		return policy, err
+	}
+	if !info.Mode().IsRegular() || info.Size() > workspaceMaxInitdata {
+		return policy, errors.New("measured initdata must be a bounded regular file")
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return policy, err
+	}
+	defer file.Close()
+	parsed, err := initdata.Parse(io.LimitReader(file, workspaceMaxInitdata+1))
+	if err != nil {
+		return policy, fmt.Errorf("parse measured initdata: %w", err)
+	}
+	raw, ok := parsed.Body.Data[workspacePolicyName]
+	if !ok {
+		return policy, fmt.Errorf("measured initdata is missing %s", workspacePolicyName)
+	}
+	if err := toml.NewDecoder(strings.NewReader(raw)).DisallowUnknownFields().Decode(&policy); err != nil {
+		return policy, fmt.Errorf("parse %s: %w", workspacePolicyName, err)
+	}
+	if policy.Version != "0.1.0" || policy.EncryptionType != "luks2" || policy.FilesystemType != "ext4" {
+		return policy, errors.New("workspace policy requires version 0.1.0, luks2 and ext4")
+	}
+	if err := validateKBSResourceURI(policy.KeyURI); err != nil {
+		return policy, err
+	}
+	if len(policy.DiskIDs) == 0 || len(policy.DiskIDs) > util.MaxDirectVolumesPerPod {
+		return policy, errors.New("workspace policy requires a bounded nonempty disk_ids list")
+	}
+	seen := map[string]bool{}
+	for _, id := range policy.DiskIDs {
+		if !alibabaDiskIDPattern.MatchString(id) || seen[id] {
+			return policy, fmt.Errorf("invalid or duplicate workspace disk_id %q", id)
+		}
+		seen[id] = true
+	}
+	return policy, nil
+}
+
+func validateKBSResourceURI(value string) error {
+	resource, err := url.Parse(value)
+	if err != nil || resource.Scheme != "kbs" || resource.Host != "" || resource.RawQuery != "" || resource.Fragment != "" || resource.RawPath != "" || !strings.HasPrefix(value, "kbs:///") {
+		return errors.New("key_uri must be an unescaped kbs:/// resource URI")
+	}
+	parts := strings.Split(strings.TrimPrefix(resource.Path, "/"), "/")
+	if len(parts) != 3 {
+		return errors.New("key_uri must identify a KBS repository, type, and tag")
+	}
+	for _, part := range parts {
+		if part == "" || part == "." || part == ".." || strings.TrimSpace(part) != part {
+			return errors.New("key_uri has an invalid resource component")
+		}
+	}
+	return nil
+}
+
+func (p workspacePolicy) authorize(volume util.CloudVolumeAnnotation) error {
+	bound := false
+	for _, id := range p.DiskIDs {
+		bound = bound || id == volume.DiskID
+	}
+	if !bound || !alibabaDiskIDPattern.MatchString(volume.DiskID) {
+		return errors.New("disk ID is not bound by measured workspace policy")
+	}
+	if volume.FSType != p.FilesystemType {
+		return errors.New("filesystem differs from measured workspace policy")
+	}
+	if volume.EncryptType != "" && volume.EncryptType != p.EncryptionType {
+		return errors.New("encryption differs from measured workspace policy")
+	}
+	if volume.KeyID != "" && "kbs:///"+volume.KeyID != p.KeyURI {
+		return errors.New("key differs from measured workspace policy")
+	}
+	return nil
+}
+
+func ensureWorkspaceInitialized(ctx context.Context, device string, volume util.CloudVolumeAnnotation, policy workspacePolicy, initialize func(context.Context, string, string, string, string) error) error {
+	if err := policy.authorize(volume); err != nil {
+		return err
+	}
+	luks, err := isLuks(device)
+	if err != nil {
+		return err
+	}
+	if luks {
+		return nil
+	}
+	if volume.ReadOnly {
+		return errors.New("readonly workspace device is not initialized")
+	}
+	if !policy.AllowInitialize {
+		return errors.New("workspace initialization is disabled by measured policy")
+	}
+	if err := initialize(ctx, device, volume.DiskID, volume.FSType, policy.KeyURI); err != nil {
+		return fmt.Errorf("initialize workspace device: %w", err)
+	}
+	luks, err = isLuks(device)
+	if err != nil {
+		return err
+	}
+	if !luks {
+		return errors.New("workspace initializer did not create an embedded LUKS header")
+	}
+	return nil
+}
+
+func initializeWorkspaceVolume(ctx context.Context, device, diskID, fsType, keyURI string, prepared *preparedCloudVolume) error {
+	var stat unix.Stat_t
+	if err := unix.Stat(device, &stat); err != nil {
+		return err
+	}
+	if stat.Mode&unix.S_IFMT != unix.S_IFBLK {
+		return errors.New("workspace initializer requires a block device")
+	}
+	name := fmt.Sprintf("workspace-init-%d-%d", unix.Major(uint64(stat.Rdev)), unix.Minor(uint64(stat.Rdev)))
+	path := "/dev/mapper/" + name
+	if exists, err := blockDeviceExists(path); err != nil {
+		return err
+	} else if exists {
+		return errors.New("workspace initializer mapper already exists; refusing to borrow it")
+	}
+	// Reuse existing mapper ownership while this first-use helper is active.
+	// After success its temporary mapper must be closed before CDH opens one.
+	prepared.cdhMapperName, prepared.cdhMapperPath = name, path
+	prepared.openedCDHMapperHere = true
+	client, err := newCDHClient(ctx, cdhSocketPath)
+	if err != nil {
+		return err
+	}
+	defer client.close()
+	key, err := client.getResource(ctx, keyURI)
+	if err != nil {
+		return err
+	}
+	defer clear(key)
+	if len(key) != 32 {
+		return errors.New("workspace key must be exactly 32 bytes")
+	}
+	// The measured helper rechecks disk identity, policy and the entire blank
+	// device before formatting. The key travels only through a private pipe.
+	command := exec.CommandContext(ctx, workspaceInitializer, device, diskID, fsType, keyURI)
+	command.Stdin = bytes.NewReader(key)
+	if err := runWorkspaceInitializer(ctx, command, prepared); err != nil {
+		return fmt.Errorf("workspace initializer failed: %w", err)
+	}
+	if exists, err := blockDeviceExists(path); err != nil {
+		return err
+	} else if exists {
+		return errors.New("workspace initializer left its temporary mapper open")
+	}
+	prepared.openedCDHMapperHere = false
+	return nil
+}
+
+func runWorkspaceInitializer(ctx context.Context, command *exec.Cmd, prepared *preparedCloudVolume) error {
+	command.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	command.Cancel = func() error { return syscall.Kill(-command.Process.Pid, syscall.SIGKILL) }
+	command.WaitDelay = 5 * time.Second
+	err := command.Run()
+	if ctx.Err() != nil && command.Process != nil {
+		// Cleanup waits until every descendant has exited, before inspecting
+		// or closing a mapper that cryptsetup could have acquired late.
+		prepared.initializerProcessGroup = command.Process.Pid
+	}
+	return err
+}
+
+func waitInitializerProcessGroup(ctx context.Context, pid int) error {
+	for {
+		err := syscall.Kill(-pid, 0)
+		if errors.Is(err, syscall.ESRCH) {
+			return nil
+		}
+		if err != nil {
+			return fmt.Errorf("inspect workspace initializer process group: %w", err)
+		}
+		select {
+		case <-ctx.Done():
+			return fmt.Errorf("wait for workspace initializer descendants: %w", ctx.Err())
+		case <-time.After(20 * time.Millisecond):
+		}
+	}
+}
+
+func blockDeviceReadOnly(ctx context.Context, device string) (bool, error) {
+	output, err := exec.CommandContext(ctx, "blockdev", "--getro", device).CombinedOutput()
+	if err != nil {
+		return false, fmt.Errorf("query readonly state for %s: %w", device, err)
+	}
+	value := strings.TrimSpace(string(output))
+	if value != "0" && value != "1" {
+		return false, fmt.Errorf("invalid readonly state for %s", device)
+	}
+	return value == "1", nil
+}
+
+func setBlockDeviceMode(ctx context.Context, device string, readOnly bool) error {
+	mode := "--setrw"
+	if readOnly {
+		mode = "--setro"
+	}
+	if err := exec.CommandContext(ctx, "blockdev", mode, device).Run(); err != nil {
+		return fmt.Errorf("set block device %s mode %s: %w", device, mode, err)
+	}
+	return nil
+}
+
+func blockDeviceExists(path string) (bool, error) {
+	info, err := os.Stat(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return false, nil
+	}
+	if err != nil {
+		return false, err
+	}
+	if info.Mode()&os.ModeDevice == 0 || info.Mode()&os.ModeCharDevice != 0 {
+		return false, fmt.Errorf("expected block device at %s", path)
+	}
+	return true, nil
+}
