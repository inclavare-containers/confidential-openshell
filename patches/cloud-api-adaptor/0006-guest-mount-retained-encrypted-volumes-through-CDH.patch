@@ -0,0 +1,127 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package interceptor
+
+import (
+	"context"
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-api-adaptor/pkg/initdata"
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-api-adaptor/pkg/util"
+	"github.com/stretchr/testify/require"
+)
+
+const testWorkspaceDocument = `version = "0.1.0"
+key_uri = "kbs:///default/openshell/workspace-key"
+disk_ids = ["d-abc123", "d-second456"]
+allow_initialize = true
+encryption_type = "luks2"
+filesystem_type = "ext4"
+`
+
+func testWorkspacePolicy() workspacePolicy {
+	return workspacePolicy{Version: "0.1.0", KeyURI: "kbs:///default/openshell/workspace-key", DiskIDs: []string{"d-abc123", "d-second456"}, AllowInitialize: true, EncryptionType: "luks2", FilesystemType: "ext4"}
+}
+
+func writeWorkspaceInitdata(t *testing.T, document string) string {
+	t.Helper()
+	encoded, err := initdata.Encode("version = \"0.1.0\"\nalgorithm = \"sha384\"\n[data]\n\"workspace.toml\" = '''\n" + document + "'''\n")
+	require.NoError(t, err)
+	path := filepath.Join(t.TempDir(), "initdata")
+	require.NoError(t, os.WriteFile(path, []byte(encoded), 0o600))
+	return path
+}
+
+func TestWorkspaceMeasuredPolicyRejectsUnboundDiskAndKey(t *testing.T) {
+	policy, err := loadWorkspacePolicy(writeWorkspaceInitdata(t, testWorkspaceDocument))
+	require.NoError(t, err)
+	volume := util.CloudVolumeAnnotation{DiskID: "d-second456", FSType: "ext4"}
+	require.NoError(t, policy.authorize(volume))
+	volume.DiskID = "d-replaced"
+	require.ErrorContains(t, policy.authorize(volume), "not bound")
+	volume.DiskID = "d-abc123"
+	volume.KeyID = "default/openshell/other-key"
+	require.ErrorContains(t, policy.authorize(volume), "key differs")
+	volume.KeyID = ""
+	volume.FSType = "xfs"
+	require.ErrorContains(t, policy.authorize(volume), "filesystem differs")
+	for _, document := range []string{
+		testWorkspaceDocument + "unknown = true\n",
+		strings.Replace(testWorkspaceDocument, "[\"d-abc123\", \"d-second456\"]", "[]", 1),
+		strings.Replace(testWorkspaceDocument, "d-second456", "d-abc123", 1),
+		strings.Replace(testWorkspaceDocument, "luks2", "plain", 1),
+	} {
+		_, err := loadWorkspacePolicy(writeWorkspaceInitdata(t, document))
+		require.Error(t, err)
+	}
+}
+
+func TestWorkspaceInitializeGateAndAppliedFailure(t *testing.T) {
+	device := filepath.Join(t.TempDir(), "device")
+	require.NoError(t, os.WriteFile(device, make([]byte, 4096), 0o600))
+	volume := util.CloudVolumeAnnotation{DiskID: "d-abc123", FSType: "ext4", ReadOnly: true}
+	policy := testWorkspacePolicy()
+	called := false
+	initialize := func(context.Context, string, string, string, string) error {
+		called = true
+		return errors.New("must not run")
+	}
+	require.ErrorContains(t, ensureWorkspaceInitialized(context.Background(), device, volume, policy, initialize), "readonly")
+	require.False(t, called)
+	volume.ReadOnly = false
+	policy.AllowInitialize = false
+	require.ErrorContains(t, ensureWorkspaceInitialized(context.Background(), device, volume, policy, initialize), "disabled")
+	require.False(t, called)
+	policy.AllowInitialize = true
+	volume.DiskID = "d-replaced"
+	require.ErrorContains(t, ensureWorkspaceInitialized(context.Background(), device, volume, policy, initialize), "not bound")
+	require.False(t, called)
+	volume.DiskID = "d-abc123"
+	initialize = func(_ context.Context, device, disk, fs, uri string) error {
+		require.Equal(t, "d-abc123", disk)
+		require.Equal(t, policy.KeyURI, uri)
+		// Applied failures stay failures. A retry recognizes the embedded
+		// header and must never format this device a second time.
+		require.NoError(t, os.WriteFile(device, append(luksMagic, make([]byte, 4096)...), 0o600))
+		return errors.New("initialization interrupted")
+	}
+	require.ErrorContains(t, ensureWorkspaceInitialized(context.Background(), device, volume, policy, initialize), "interrupted")
+	initialize = func(context.Context, string, string, string, string) error {
+		t.Fatal("formatted an existing LUKS device")
+		return nil
+	}
+	require.NoError(t, ensureWorkspaceInitialized(context.Background(), device, volume, policy, initialize))
+}
+
+func TestKBSResourceURIRejectsAliases(t *testing.T) {
+	require.NoError(t, validateKBSResourceURI("kbs:///default/openshell/workspace-key"))
+	for _, invalid := range []string{"kbs://host/default/type/tag", "kbs:///default/type/..", "kbs:///default/type/tag?q=1", "kbs:///default/type/%74ag", "https://host/key", "kbs:///a/b/c/d"} {
+		require.Error(t, validateKBSResourceURI(invalid), invalid)
+	}
+}
+
+func TestWorkspaceCanceledInitializerRollsBackWithIndependentContext(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
+	defer cancel()
+	prepared := &preparedCloudVolume{openedCDHMapperHere: true, cdhMapperName: "owned-initializer", cdhMapperPath: "/dev/mapper/owned-initializer"}
+	closed := false
+	prepared.closeCDHMapper = func(ctx context.Context, _, _ string) error {
+		require.NoError(t, ctx.Err(), "rollback borrowed the canceled request context")
+		require.Zero(t, prepared.initializerProcessGroup, "mapper closed before initializer process group exited")
+		closed = true
+		return nil
+	}
+	command := exec.CommandContext(ctx, "/bin/sh", "-c", "exec sleep 30")
+	require.Error(t, runWorkspaceInitializer(ctx, command, prepared))
+	require.NotZero(t, prepared.initializerProcessGroup)
+	require.NoError(t, cleanupPreparedCloudVolumes(ctx, []*preparedCloudVolume{prepared}))
+	require.True(t, closed)
+	require.False(t, prepared.owned())
+}
