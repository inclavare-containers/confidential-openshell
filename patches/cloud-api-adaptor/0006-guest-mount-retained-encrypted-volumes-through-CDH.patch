+// Delegate fsGroup permission semantics without following symlinks outside
+// the mounted volume. Apply the root last, after all existing content succeeds.
+func applyCloudVolumeFSGroup(path, name string, volume util.CloudVolumeAnnotation) error {
+	if volume.FSGroup == "" || volume.ReadOnly {
+		return nil
+	}
+	root, err := os.OpenRoot(path)
+	if err != nil {
+		return fmt.Errorf("open fsGroup volume %s: %w", name, err)
+	}
+	defer root.Close()
+	gid, _ := strconv.ParseUint(volume.FSGroup, 10, 32) // decoded and validated
+	apply := func(path string, info os.FileInfo) error {
+		if info.Mode()&os.ModeSymlink != 0 {
+			return nil
+		}
+		mode := info.Mode() | 0o660
+		if info.IsDir() {
+			mode |= 0o110 | os.ModeSetgid
+		}
+		if err := root.Chown(path, -1, int(gid)); err != nil {
+			return err
+		}
+		return root.Chmod(path, mode)
+	}
+	err = fs.WalkDir(root.FS(), ".", func(current string, entry os.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if current == "." {
+			return nil
+		}
+		info, err := entry.Info()
+		if err != nil {
+			return err
+		}
+		return apply(current, info)
+	})
+	if err == nil {
+		var info os.FileInfo
+		info, err = root.Lstat(".")
+		if err == nil {
+			err = apply(".", info)
+		}
+	}
+	if err != nil {
+		return fmt.Errorf("apply fsGroup to %s: %w", name, err)
+	}
+	return nil
+}
