+// CDH 0.22's filesystem mount ignores readonly/flags. Ask it only to open
+// the encrypted device, then enforce underlay, mapper and filesystem modes here.
+func prepareCDHCloudVolume(ctx context.Context, prepared *preparedCloudVolume, name, device string, volume util.CloudVolumeAnnotation, measuredWorkspace bool) error {
+	prepared.cdhMapperName = "caa-" + name
+	prepared.cdhMapperPath = filepath.Join("/dev/mapper", prepared.cdhMapperName)
+	prepared.cdhDevicePath = filepath.Join(cloudVolumeMountBase, "."+prepared.cdhMapperName+".device")
+	mapperExisted, err := blockDeviceExists(prepared.cdhMapperPath)
+	if err != nil {
+		return err
+	}
+	if mapperExisted {
+		if err := verifyCDHMapper(ctx, prepared.cdhMapperPath, device, measuredWorkspace); err != nil {
+			return err
+		}
+		if volume.ReadOnly {
+			for _, path := range []string{device, prepared.cdhMapperPath} {
+				ro, err := blockDeviceReadOnly(ctx, path)
+				if err != nil {
+					return err
+				}
+				if !ro {
+					return fmt.Errorf("reused encrypted device %s is writable after a readonly request", path)
+				}
+			}
+		}
+		mounted, err := mountedCloudDevice(prepared.cdhMapperPath, prepared.sourcePath, volume.FSType, volume.ReadOnly, volume.Options)
+		if err != nil || mounted {
+			return err
+		}
+	} else {
+		if mounted, err := mountinfo.Mounted(prepared.sourcePath); err != nil {
+			return err
+		} else if mounted {
+			return fmt.Errorf("mount point for %s is already backed by an unexpected device", name)
+		}
+		if _, err := os.Lstat(prepared.cdhDevicePath); !errors.Is(err, os.ErrNotExist) {
+			return fmt.Errorf("CDH device path for %s must not already exist", name)
+		}
+		if volume.ReadOnly {
+			ro, err := blockDeviceReadOnly(ctx, device)
+			if err != nil {
+				return err
+			}
+			if !ro {
+				prepared.setRawReadOnlyHere = true
+				if err := setBlockDeviceMode(ctx, device, true); err != nil {
+					return err
+				}
+			}
+		}
+		// Mark acquisition before RPC so an applied-but-unreported open is
+		// reclaimed, while mappings borrowed from an earlier call stay open.
+		prepared.openedCDHMapperHere = true
+		secureErr := secureMount(ctx, device, prepared.cdhDevicePath, volume.EncryptType, volume.KeyID, prepared.cdhMapperName)
+		exists, statErr := blockDeviceExists(prepared.cdhMapperPath)
+		if !exists && statErr == nil {
+			prepared.openedCDHMapperHere = false
+		}
+		if target, err := os.Readlink(prepared.cdhDevicePath); err == nil && target == prepared.cdhMapperPath {
+			prepared.createdCDHPathHere = true
+		}
+		if secureErr != nil || statErr != nil {
+			return errors.Join(secureErr, statErr)
+		}
+		if !exists || !prepared.createdCDHPathHere {
+			return fmt.Errorf("CDH did not open expected encrypted device for %s", name)
+		}
+		if err := verifyCDHMapper(ctx, prepared.cdhMapperPath, device, measuredWorkspace); err != nil {
+			return err
+		}
+		if volume.ReadOnly {
+			if err := setBlockDeviceMode(ctx, prepared.cdhMapperPath, true); err != nil {
+				return err
+			}
+			for _, path := range []string{device, prepared.cdhMapperPath} {
+				ro, err := blockDeviceReadOnly(ctx, path)
+				if err != nil {
+					return err
+				}
+				if !ro {
+					return fmt.Errorf("encrypted device %s remains writable", path)
+				}
+			}
+		}
+	}
+	// Existing encrypted data is never repaired or formatted. Only the
+	// measured first-use initializer may create its embedded header and FS.
+	output, err := exec.CommandContext(ctx, "blkid", "-p", "-s", "TYPE", "-o", "value", prepared.cdhMapperPath).CombinedOutput()
+	if err != nil || strings.TrimSpace(string(output)) != volume.FSType {
+		return fmt.Errorf("encrypted device for %s lacks expected filesystem %s; refusing to format", name, volume.FSType)
+	}
+	prepared.mountedHere, err = mountEncryptedCloudFilesystem(ctx, prepared.cdhMapperPath, prepared.sourcePath, volume.FSType, volume.ReadOnly, volume.Options)
+	return err
+}
+
+// The encrypted path has no formatting fallback, even if the host corrupts
+// ciphertext between the filesystem probe and the mount attempt.
+func mountEncryptedCloudFilesystem(ctx context.Context, device, mountPoint, fsType string, readOnly bool, options []string) (bool, error) {
+	if mounted, err := mountedCloudDevice(device, mountPoint, fsType, readOnly, options); err != nil || mounted {
+		return false, err
+	}
+	args := []string{"-t", fsType}
+	if len(options) != 0 {
+		args = append(args, "-o", strings.Join(options, ","))
+	}
+	args = append(args, device, mountPoint)
+	mountErr := exec.CommandContext(ctx, "mount", args...).Run()
+	// Observe ownership independently of exit status and validation so a
+	// partial/incorrect mount is still unwound before its mapper closes.
+	mounted, inspectErr := mountinfo.Mounted(mountPoint)
+	if inspectErr != nil {
+		return mounted, errors.Join(mountErr, inspectErr)
+	}
+	if mounted {
+		_, validateErr := mountedCloudDevice(device, mountPoint, fsType, readOnly, options)
+		return true, errors.Join(mountErr, validateErr)
+	}
+	return false, errors.Join(mountErr, fmt.Errorf("encrypted filesystem was not mounted at %s", mountPoint))
+}
+
+func verifyCDHMapper(ctx context.Context, mapper, device string, measuredWorkspace bool) error {
+	resolved, err := filepath.EvalSymlinks(mapper)
+	if err != nil {
+		return err
+	}
+	if !blockDeviceGraphContains("/sys/class/block", filepath.Base(resolved), filepath.Base(device)) {
+		return fmt.Errorf("encrypted mapper %s is not backed by expected device %s", mapper, device)
+	}
+	if measuredWorkspace {
+		return verifyWorkspaceMapperEncryption(ctx, mapper)
+	}
+	return nil
+}
+
+// Inspect the active kernel mapping, not the mutable on-disk header. The
+// first-use initializer fixes these parameters; CDH opens existing volumes.
+func verifyWorkspaceMapperEncryption(ctx context.Context, mapper string) error {
+	command := exec.CommandContext(ctx, "cryptsetup", "status", mapper)
+	command.Env = append(os.Environ(), "LC_ALL=C")
+	status, err := command.Output()
+	if err != nil {
+		return fmt.Errorf("inspect workspace encryption: %w", err)
+	}
+	return validateWorkspaceMapperStatus(string(status))
+}
+
+func validateWorkspaceMapperStatus(status string) error {
+	fields := make(map[string]string)
+	for _, line := range strings.Split(status, "\n") {
+		key, value, ok := strings.Cut(line, ":")
+		if ok {
+			fields[strings.TrimSpace(key)] = strings.Join(strings.Fields(value), " ")
+		}
+	}
+	if fields["type"] != "LUKS2" || fields["cipher"] != "aes-xts-plain64" ||
+		fields["keysize"] != "512 [bits]" || fields["sector size"] != "4096 [bytes]" {
+		return errors.New("workspace mapper does not use required LUKS2 AES-XTS-512 encryption with 4096-byte sectors")
+	}
+	return nil
+}
+
+func closeCryptsetupMapper(ctx context.Context, name, path string) error {
+	exists, err := blockDeviceExists(path)
+	if err != nil || !exists {
+		return err
+	}
+	output, closeErr := exec.CommandContext(ctx, "cryptsetup", "close", name).CombinedOutput()
+	exists, statErr := blockDeviceExists(path)
+	if statErr != nil {
+		return errors.Join(closeErr, statErr)
+	}
+	if closeErr != nil && exists {
+		return fmt.Errorf("close CDH mapper %s: %s: %w", name, strings.TrimSpace(string(output)), closeErr)
+	}
+	if exists {
+		return fmt.Errorf("CDH mapper %s remains open after close", name)
+	}
+	return nil
+}
+
+func rewriteCloudMount(req *pb.CreateContainerRequest, name string, volume util.CloudVolumeAnnotation, source string) error {
+	matched := -1
+	for index, mount := range req.OCI.Mounts {
+		if mount.Destination != volume.MountPoint {
+			continue
+		}
+		if matched >= 0 {
+			return fmt.Errorf("cloud volume %s mount point %q is ambiguous in container mounts", name, volume.MountPoint)
+		}
+		matched = index
+	}
+	if matched < 0 {
+		return fmt.Errorf("cloud volume %s mount point %q is absent from container mounts", name, volume.MountPoint)
+	}
+	mount := req.OCI.Mounts[matched]
+	mount.Source = source
+	mount.Type = "bind"
+	mount.Options = normalizeBindMountOptions(mount.Options, volume.ReadOnly)
+	return nil
+}
+
+// mountedCloudDevice rejects reuse of a mount point backed by a different
+// device, filesystem, or access mode.
+func mountedCloudDevice(device, mountPoint, fsType string, readOnly bool, options []string) (bool, error) {
+	resolved, err := filepath.EvalSymlinks(mountPoint)
+	if err != nil {
+		return false, err
+	}
+	mounts, err := mountinfo.GetMounts(func(info *mountinfo.Info) (skip, stop bool) {
+		return info.Mountpoint != resolved, false
+	})
+	if err != nil || len(mounts) == 0 {
+		return false, err
+	}
+	mount := mounts[len(mounts)-1]
+	var stat unix.Stat_t
+	if err := unix.Stat(device, &stat); err != nil {
+		return false, fmt.Errorf("stat mounted device %s: %w", device, err)
+	}
+	if err := validateReusableCloudMount(mountPoint, mount, &stat, fsType, readOnly, options); err != nil {
+		return false, err
+	}
+	return true, nil
+}
+
+func validateReusableCloudMount(mountPoint string, mount *mountinfo.Info, stat *unix.Stat_t, fsType string, readOnly bool, options []string) error {
+	if mount.Root != "/" {
+		return fmt.Errorf("mount point %s exposes filesystem root %q, expected /", mountPoint, mount.Root)
+	}
+	if stat.Mode&unix.S_IFMT != unix.S_IFBLK || mount.Major != int(unix.Major(uint64(stat.Rdev))) ||
+		mount.Minor != int(unix.Minor(uint64(stat.Rdev))) || mount.FSType != fsType {
+		return fmt.Errorf("mount point %s is backed by an unexpected device or filesystem", mountPoint)
+	}
+	actual := make(map[string]bool)
+	for _, option := range strings.Split(mount.Options+","+mount.VFSOptions, ",") {
+		actual[option] = true
+	}
+	expected := map[string]bool{"ro": readOnly, "nodev": false, "noexec": false, "nosuid": false}
+	for _, option := range options {
+		if _, tracked := expected[option]; tracked {
+			expected[option] = true
+		}
+	}
+	for _, option := range []string{"ro", "nodev", "noexec", "nosuid"} {
+		if actual[option] != expected[option] {
+			return fmt.Errorf("mount point %s option %s=%t, expected %t", mountPoint, option, actual[option], expected[option])
+		}
+	}
+	return nil
+}
