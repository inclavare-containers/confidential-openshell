+func prepareCloudVolume(ctx context.Context, name string, volume util.CloudVolumeAnnotation, workspace *workspacePolicy) (*preparedCloudVolume, error) {
+	lun, _ := strconv.Atoi(volume.LUN) // validated by DecodeCloudVolumeAnnotations
+	if workspace != nil {
+		if err := workspace.authorize(volume); err != nil {
+			return nil, fmt.Errorf("cloud volume %s: %w", name, err)
+		}
+		volume.EncryptType = workspace.EncryptionType
+		volume.KeyID = strings.TrimPrefix(workspace.KeyURI, "kbs:///")
+	}
+	device, err := findDataDiskDevice(lun, volume.DiskID)
+	if err != nil {
+		return nil, fmt.Errorf("cloud volume %s device discovery: %w", name, err)
+	}
+
+	if err := os.MkdirAll(cloudVolumeMountBase, 0o755); err != nil {
+		return nil, fmt.Errorf("create cloud volume directory: %w", err)
+	}
+	prepared := &preparedCloudVolume{sourcePath: filepath.Join(cloudVolumeMountBase, name), rawDevice: device}
+	if err := os.Mkdir(prepared.sourcePath, 0o755); err == nil {
+		prepared.createdDirHere = true
+	} else if !errors.Is(err, os.ErrExist) {
+		return prepared, fmt.Errorf("create mount point for %s: %w", name, err)
+	} else if info, statErr := os.Lstat(prepared.sourcePath); statErr != nil || !info.IsDir() {
+		if statErr != nil {
+			err = statErr
+		} else {
+			err = fmt.Errorf("existing path is not a directory")
+		}
+		return prepared, fmt.Errorf("use mount point for %s: %w", name, err)
+	}
+
+	if volume.EncryptType != "" {
+		if workspace != nil {
+			if err := ensureWorkspaceInitialized(ctx, device, volume, *workspace, func(ctx context.Context, device, diskID, fsType, uri string) error {
+				return initializeWorkspaceVolume(ctx, device, diskID, fsType, uri, prepared)
+			}); err != nil {
+				return prepared, preserveOriginalError(err, cleanupPreparedCloudVolumes(ctx, prepared))
+			}
+		}
+		if err := prepareCDHCloudVolume(ctx, prepared, name, device, volume, workspace != nil); err != nil {
+			return prepared, preserveOriginalError(err, cleanupPreparedCloudVolumes(ctx, prepared))
+		}
+		if err := applyCloudVolumeFSGroup(prepared.sourcePath, name, volume); err != nil {
+			return prepared, preserveOriginalError(err, cleanupPreparedCloudVolumes(ctx, prepared))
+		}
+		return prepared, nil
+	}
+	prepared.mountedHere, err = formatAndMount(device, prepared.sourcePath, volume.FSType, volume.ReadOnly, volume.Options)
+	if err != nil {
+		return prepared, fmt.Errorf("mount cloud volume %s: %w", name, err)
+	}
+	if err := applyCloudVolumeFSGroup(prepared.sourcePath, name, volume); err != nil {
+		return prepared, preserveOriginalError(err, cleanupPreparedCloudVolumes(ctx, prepared))
+	}
+	return prepared, nil
+}
