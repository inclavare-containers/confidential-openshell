+	defer f.mu.Unlock()
+
+	var diskIDs []string
+	if instanceID := tea.StringValue(request.InstanceId); instanceID != "" {
+		f.describeAttachedCalls++
+		for diskID, disk := range f.disks {
+			if disk.instanceID == instanceID {
