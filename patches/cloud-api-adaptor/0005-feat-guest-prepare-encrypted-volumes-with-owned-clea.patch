+// preparedCloudVolume tracks only resources acquired by one CreateContainer
+// call. Reused mounts and mappers are intentionally not owned by that call.
+type preparedCloudVolume struct {
+	mu                      sync.Mutex
+	initializerProcessGroup int
+	sourcePath              string
+	mountedHere             bool
+	createdDirHere          bool
+	rawDevice               string
+	setRawReadOnlyHere      bool
+	cdhDevicePath           string
+	createdCDHPathHere      bool
+	setReadOnly             func(context.Context, string, bool) error
+	cdhMapperName           string
+	cdhMapperPath           string
+	openedCDHMapperHere     bool
+	unmount                 func(string, int) error
+	closeCDHMapper          func(context.Context, string, string) error
+}
+
+func (v *preparedCloudVolume) owned() bool {
+	return v != nil && (v.mountedHere || v.createdDirHere ||
+		v.openedCDHMapperHere || v.setRawReadOnlyHere || v.createdCDHPathHere || v.initializerProcessGroup != 0)
+}
+
+func (v *preparedCloudVolume) cleanup(ctx context.Context) error {
+	if v == nil {
+		return nil
+	}
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	if v.initializerProcessGroup != 0 {
+		if err := waitInitializerProcessGroup(ctx, v.initializerProcessGroup); err != nil {
+			return err
+		}
+		v.initializerProcessGroup = 0
+	}
+
+	if v.mountedHere {
+		unmount := v.unmount
+		if unmount == nil {
+			unmount = syscall.Unmount
+		}
+		if err := unmount(v.sourcePath, 0); err != nil && !errors.Is(err, syscall.EINVAL) && !errors.Is(err, syscall.ENOENT) {
+			return fmt.Errorf("unmount %s: %w", v.sourcePath, err)
+		}
+		v.mountedHere = false
+	}
+	if v.createdCDHPathHere {
+		if err := os.Remove(v.cdhDevicePath); err != nil && !errors.Is(err, os.ErrNotExist) {
+			return fmt.Errorf("remove CDH device path: %w", err)
+		}
+		v.createdCDHPathHere = false
+	}
+	if v.openedCDHMapperHere {
+		closeMapper := v.closeCDHMapper
+		if closeMapper == nil {
+			closeMapper = closeCryptsetupMapper
+		}
+		if err := closeMapper(ctx, v.cdhMapperName, v.cdhMapperPath); err != nil {
+			return err
+		}
+		v.openedCDHMapperHere = false
+	}
+	if v.setRawReadOnlyHere {
+		setMode := v.setReadOnly
+		if setMode == nil {
+			setMode = setBlockDeviceMode
+		}
+		if err := setMode(ctx, v.rawDevice, false); err != nil {
+			return err
+		}
+		v.setRawReadOnlyHere = false
+	}
+	if v.createdDirHere {
+		if err := os.Remove(v.sourcePath); err != nil && !errors.Is(err, os.ErrNotExist) {
+			return fmt.Errorf("remove mount directory %s: %w", v.sourcePath, err)
+		}
+		v.createdDirHere = false
+	}
+	return nil
+}
+
+func cleanupPreparedCloudVolumes(ctx context.Context, volumes []*preparedCloudVolume) error {
+	// Rollback must finish even when the caller canceled CreateContainer.
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 30*time.Second)
+	defer cancel()
+	var cleanupErrors []error
+	for index := len(volumes) - 1; index >= 0; index-- {
+		if err := volumes[index].cleanup(ctx); err != nil {
+			cleanupErrors = append(cleanupErrors, err)
+		}
+	}
+	return errors.Join(cleanupErrors...)
+}
+
+func preserveOriginalError(original, cleanup error) error {
+	if cleanup == nil {
+		return original
+	}
+	return errors.Join(original, fmt.Errorf("rollback cloud volumes: %w", cleanup))
+}
+
+func (i *interceptor) trackOwnedCloudVolumes(volumes []*preparedCloudVolume) {
+	for _, volume := range volumes {
+		if volume.owned() {
+			i.cloudVolumes = append(i.cloudVolumes, volume)
+		}
+	}
+}
+
+func (i *interceptor) prepareCloudVolumes(ctx context.Context, req *pb.CreateContainerRequest, encoded string) ([]*preparedCloudVolume, error) {
+	volumes, err := util.DecodeCloudVolumeAnnotations(encoded)
+	if err != nil {
+		return nil, fmt.Errorf("corrupt cloud_volumes annotation (pod would start without volumes): %w", err)
+	}
+	var workspace *workspacePolicy
+	if i.requireEncryptedVolumes && len(volumes) != 0 {
+		if i.workspace == nil {
+			policy, err := loadWorkspacePolicy(workspaceInitdataPath)
+			if err != nil {
+				return nil, fmt.Errorf("encrypted volumes are required: %w", err)
+			}
+			i.workspace = &policy
+		}
+		workspace = i.workspace
+	}
+
+	names := make([]string, 0, len(volumes))
+	for name := range volumes {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	prepared := make([]*preparedCloudVolume, 0, len(names))
+	for _, name := range names {
+		volume, err := prepareCloudVolume(ctx, name, volumes[name], workspace)
+		if volume != nil {
+			prepared = append(prepared, volume)
+		}
+		if err != nil {
+			return prepared, preserveOriginalError(err, cleanupPreparedCloudVolumes(ctx, prepared))
+		}
+		if err := rewriteCloudMount(req, name, volumes[name], volume.sourcePath); err != nil {
+			return prepared, preserveOriginalError(err, cleanupPreparedCloudVolumes(ctx, prepared))
+		}
+	}
+	return prepared, nil
+}
+
+func prepareCloudVolume(ctx context.Context, name string, volume util.CloudVolumeAnnotation, workspace *workspacePolicy) (*preparedCloudVolume, error) {
+	lun, _ := strconv.Atoi(volume.LUN) // validated by DecodeCloudVolumeAnnotations
+	if workspace != nil {
+		if err := workspace.authorize(volume); err != nil {
+			return nil, fmt.Errorf("cloud volume %s: %w", name, err)
+		}
+		volume.EncryptType = workspace.EncryptionType
+		volume.KeyID = strings.TrimPrefix(workspace.KeyURI, "kbs:///")
+	}
+	device, err := findDataDiskDevice(lun, volume.DiskID)
+	if err != nil {
+		return nil, fmt.Errorf("cloud volume %s device discovery: %w", name, err)
+	}
+
+	if err := os.MkdirAll(cloudVolumeMountBase, 0o755); err != nil {
+		return nil, fmt.Errorf("create cloud volume directory: %w", err)
+	}
+	prepared := &preparedCloudVolume{sourcePath: filepath.Join(cloudVolumeMountBase, name), rawDevice: device}
+	if err := os.Mkdir(prepared.sourcePath, 0o755); err == nil {
+		prepared.createdDirHere = true
+	} else if !errors.Is(err, os.ErrExist) {
+		return prepared, fmt.Errorf("create mount point for %s: %w", name, err)
+	} else if info, statErr := os.Lstat(prepared.sourcePath); statErr != nil || !info.IsDir() {
+		if statErr != nil {
+			err = statErr
+		} else {
+			err = fmt.Errorf("existing path is not a directory")
+		}
+		return prepared, fmt.Errorf("use mount point for %s: %w", name, err)
+	}
+
+	if volume.EncryptType != "" {
+		if workspace != nil {
+			if err := ensureWorkspaceInitialized(ctx, device, volume, *workspace, func(ctx context.Context, device, diskID, fsType, uri string) error {
+				return initializeWorkspaceVolume(ctx, device, diskID, fsType, uri, prepared)
+			}); err != nil {
+				return prepared, err
+			}
+		}
+		if err := prepareCDHCloudVolume(ctx, prepared, name, device, volume); err != nil {
+			return prepared, err
+		}
+		if err := applyCloudVolumeFSGroup(prepared.sourcePath, name, volume); err != nil {
+			return prepared, err
+		}
+		return prepared, nil
+	}
+	prepared.mountedHere, err = formatAndMount(device, prepared.sourcePath, volume.FSType, volume.ReadOnly, volume.Options)
+	if err != nil {
+		return prepared, fmt.Errorf("mount cloud volume %s: %w", name, err)
+	}
+	if err := applyCloudVolumeFSGroup(prepared.sourcePath, name, volume); err != nil {
+		return prepared, err
+	}
+	return prepared, nil
+}
+
+func applyCloudVolumeFSGroup(path, name string, volume util.CloudVolumeAnnotation) error {
+	if volume.FSGroup == "" || volume.ReadOnly {
+		return nil
+	}
+	gid, _ := strconv.ParseUint(volume.FSGroup, 10, 32) // validated by DecodeCloudVolumeAnnotations
+	if err := os.Chown(path, -1, int(gid)); err != nil {
+		return fmt.Errorf("apply fsGroup to %s: %w", name, err)
+	}
+	if err := os.Chmod(path, 0o2775); err != nil {
+		return fmt.Errorf("apply fsGroup mode to %s: %w", name, err)
+	}
+	return nil
+}
+
+// CDH 0.22's filesystem mount ignores readonly/flags. Ask it only to open
+// the encrypted device, then enforce underlay, mapper and filesystem modes here.
+func prepareCDHCloudVolume(ctx context.Context, prepared *preparedCloudVolume, name, device string, volume util.CloudVolumeAnnotation) error {
+	prepared.cdhMapperName = "caa-" + name
+	prepared.cdhMapperPath = filepath.Join("/dev/mapper", prepared.cdhMapperName)
+	prepared.cdhDevicePath = filepath.Join(cloudVolumeMountBase, "."+prepared.cdhMapperName+".device")
+	mapperExisted, err := blockDeviceExists(prepared.cdhMapperPath)
+	if err != nil {
+		return err
+	}
+	if mapperExisted {
+		if err := verifyMapperUnderlay(prepared.cdhMapperPath, device); err != nil {
+			return err
+		}
+		if volume.ReadOnly {
+			for _, path := range []string{device, prepared.cdhMapperPath} {
+				ro, err := blockDeviceReadOnly(ctx, path)
+				if err != nil {
+					return err
+				}
+				if !ro {
+					return fmt.Errorf("reused encrypted device %s is writable after a readonly request", path)
+				}
+			}
+		}
+		mounted, err := mountedCloudDevice(prepared.cdhMapperPath, prepared.sourcePath, volume.FSType, volume.ReadOnly, volume.Options)
+		if err != nil || mounted {
+			return err
+		}
+	} else {
+		if mounted, err := mountinfo.Mounted(prepared.sourcePath); err != nil {
+			return err
+		} else if mounted {
+			return fmt.Errorf("mount point for %s is already backed by an unexpected device", name)
+		}
+		if _, err := os.Lstat(prepared.cdhDevicePath); !errors.Is(err, os.ErrNotExist) {
+			return fmt.Errorf("CDH device path for %s must not already exist", name)
+		}
+		if volume.ReadOnly {
+			ro, err := blockDeviceReadOnly(ctx, device)
+			if err != nil {
+				return err
+			}
+			if !ro {
+				prepared.setRawReadOnlyHere = true
+				if err := setBlockDeviceMode(ctx, device, true); err != nil {
+					return err
+				}
+			}
+		}
+		// Mark acquisition before RPC so an applied-but-unreported open is
+		// reclaimed, while mappings borrowed from an earlier call stay open.
+		prepared.openedCDHMapperHere = true
+		secureErr := secureMount(ctx, device, prepared.cdhDevicePath, volume.FSType, volume.EncryptType, volume.KeyID, prepared.cdhMapperName, volume.ReadOnly, volume.Options)
+		exists, statErr := blockDeviceExists(prepared.cdhMapperPath)
+		if !exists && statErr == nil {
+			prepared.openedCDHMapperHere = false
+		}
+		if target, err := os.Readlink(prepared.cdhDevicePath); err == nil && target == prepared.cdhMapperPath {
+			prepared.createdCDHPathHere = true
+		}
+		if secureErr != nil || statErr != nil {
+			return errors.Join(secureErr, statErr)
+		}
+		if !exists || !prepared.createdCDHPathHere {
+			return fmt.Errorf("CDH did not open expected encrypted device for %s", name)
+		}
+		if err := verifyMapperUnderlay(prepared.cdhMapperPath, device); err != nil {
+			return err
+		}
+		if volume.ReadOnly {
+			if err := setBlockDeviceMode(ctx, prepared.cdhMapperPath, true); err != nil {
+				return err
+			}
+			for _, path := range []string{device, prepared.cdhMapperPath} {
+				ro, err := blockDeviceReadOnly(ctx, path)
+				if err != nil {
+					return err
+				}
+				if !ro {
+					return fmt.Errorf("encrypted device %s remains writable", path)
+				}
+			}
+		}
+	}
+	// Existing encrypted data is never repaired or formatted. Only the
+	// measured first-use initializer may create its embedded header and FS.
+	output, err := exec.CommandContext(ctx, "blkid", "-p", "-s", "TYPE", "-o", "value", prepared.cdhMapperPath).CombinedOutput()
+	if err != nil || strings.TrimSpace(string(output)) != volume.FSType {
+		return fmt.Errorf("encrypted device for %s lacks expected filesystem %s; refusing to format", name, volume.FSType)
+	}
+	prepared.mountedHere, err = mountEncryptedCloudFilesystem(ctx, prepared.cdhMapperPath, prepared.sourcePath, volume.FSType, volume.ReadOnly, volume.Options)
+	return err
+}
+
+// The encrypted path has no formatting fallback, even if the host corrupts
+// ciphertext between the filesystem probe and the mount attempt.
+func mountEncryptedCloudFilesystem(ctx context.Context, device, mountPoint, fsType string, readOnly bool, options []string) (bool, error) {
+	if mounted, err := mountedCloudDevice(device, mountPoint, fsType, readOnly, options); err != nil || mounted {
+		return false, err
+	}
+	args := []string{"-t", fsType}
+	if len(options) != 0 {
+		args = append(args, "-o", strings.Join(options, ","))
+	}
+	args = append(args, device, mountPoint)
+	mountErr := exec.CommandContext(ctx, "mount", args...).Run()
+	// Observe ownership independently of exit status and validation so a
+	// partial/incorrect mount is still unwound before its mapper closes.
+	mounted, inspectErr := mountinfo.Mounted(mountPoint)
+	if inspectErr != nil {
+		return mounted, errors.Join(mountErr, inspectErr)
+	}
+	if mounted {
+		_, validateErr := mountedCloudDevice(device, mountPoint, fsType, readOnly, options)
+		return true, errors.Join(mountErr, validateErr)
+	}
+	return false, errors.Join(mountErr, fmt.Errorf("encrypted filesystem was not mounted at %s", mountPoint))
+}
+
+func verifyMapperUnderlay(mapper, device string) error {
+	resolved, err := filepath.EvalSymlinks(mapper)
+	if err != nil {
+		return err
+	}
+	if !blockDeviceGraphContains("/sys/class/block", filepath.Base(resolved), filepath.Base(device)) {
+		return fmt.Errorf("encrypted mapper %s is not backed by expected device %s", mapper, device)
+	}
+	return nil
+}
+
+func closeCryptsetupMapper(ctx context.Context, name, path string) error {
+	exists, err := blockDeviceExists(path)
+	if err != nil || !exists {
+		return err
+	}
+	output, closeErr := exec.CommandContext(ctx, "cryptsetup", "close", name).CombinedOutput()
+	exists, statErr := blockDeviceExists(path)
+	if statErr != nil {
+		return errors.Join(closeErr, statErr)
+	}
+	if closeErr != nil && exists {
+		return fmt.Errorf("close CDH mapper %s: %s: %w", name, strings.TrimSpace(string(output)), closeErr)
+	}
+	if exists {
+		return fmt.Errorf("CDH mapper %s remains open after close", name)
+	}
+	return nil
+}
+
+func rewriteCloudMount(req *pb.CreateContainerRequest, name string, volume util.CloudVolumeAnnotation, source string) error {
+	matched := -1
+	for index, mount := range req.OCI.Mounts {
+		if mount.Destination != volume.MountPoint {
+			continue
+		}
+		if matched >= 0 {
+			return fmt.Errorf("cloud volume %s mount point %q is ambiguous in container mounts", name, volume.MountPoint)
+		}
+		matched = index
+	}
+	if matched < 0 {
+		return fmt.Errorf("cloud volume %s mount point %q is absent from container mounts", name, volume.MountPoint)
+	}
+	mount := req.OCI.Mounts[matched]
+	mount.Source = source
+	mount.Type = "bind"
+	mount.Options = normalizeBindMountOptions(mount.Options, volume.ReadOnly)
+	return nil
+}
+
+// mountedCloudDevice rejects reuse of a mount point backed by a different
+// device, filesystem, or access mode.
+func mountedCloudDevice(device, mountPoint, fsType string, readOnly bool, options []string) (bool, error) {
+	resolved, err := filepath.EvalSymlinks(mountPoint)
+	if err != nil {
+		return false, err
+	}
+	mounts, err := mountinfo.GetMounts(func(info *mountinfo.Info) (skip, stop bool) {
+		return info.Mountpoint != resolved, false
+	})
+	if err != nil || len(mounts) == 0 {
+		return false, err
+	}
+	mount := mounts[len(mounts)-1]
+	var stat unix.Stat_t
+	if err := unix.Stat(device, &stat); err != nil {
+		return false, fmt.Errorf("stat mounted device %s: %w", device, err)
+	}
+	if err := validateReusableCloudMount(mountPoint, mount, &stat, fsType, readOnly, options); err != nil {
+		return false, err
+	}
+	return true, nil
+}
+
+func validateReusableCloudMount(mountPoint string, mount *mountinfo.Info, stat *unix.Stat_t, fsType string, readOnly bool, options []string) error {
+	if mount.Root != "/" {
+		return fmt.Errorf("mount point %s exposes filesystem root %q, expected /", mountPoint, mount.Root)
+	}
+	if stat.Mode&unix.S_IFMT != unix.S_IFBLK || mount.Major != int(unix.Major(uint64(stat.Rdev))) ||
+		mount.Minor != int(unix.Minor(uint64(stat.Rdev))) || mount.FSType != fsType {
+		return fmt.Errorf("mount point %s is backed by an unexpected device or filesystem", mountPoint)
+	}
+	actual := make(map[string]bool)
+	for _, option := range strings.Split(mount.Options+","+mount.VFSOptions, ",") {
+		actual[option] = true
+	}
+	expected := map[string]bool{"ro": readOnly, "nodev": false, "noexec": false, "nosuid": false}
+	for _, option := range options {
+		if _, tracked := expected[option]; tracked {
+			expected[option] = true
+		}
+	}
+	for _, option := range []string{"ro", "nodev", "noexec", "nosuid"} {
+		if actual[option] != expected[option] {
+			return fmt.Errorf("mount point %s option %s=%t, expected %t", mountPoint, option, actual[option], expected[option])
+		}
+	}
+	return nil
+}
