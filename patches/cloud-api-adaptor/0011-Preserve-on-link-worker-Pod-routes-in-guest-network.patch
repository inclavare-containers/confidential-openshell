@@ -203,6 +204,76 @@ func TestPodNode(t *testing.T) {
 	}
 }
 
+func TestOnlinkRouteReplay(t *testing.T) {
+	testutils.SkipTestIfNotRoot(t)
+
+	const mockTunnelType = "mock-onlink"
+	tunneler.Register(mockTunnelType, newMockWorkerNodeTunneler, newMockPodNodeTunneler)
+
+	workerNS, _ := tuntest.NewNamedNS(t, "test-onlink-worker")
+	defer tuntest.DeleteNamedNS(t, workerNS)
+	tuntest.BridgeAdd(t, workerNS, "ens0")
+	tuntest.AddrAdd(t, workerNS, "ens0", "192.168.0.2/24")
+	tuntest.RouteAdd(t, workerNS, "", "192.168.0.1", "ens0")
+
+	workerPodNS, _ := tuntest.NewNamedNS(t, "test-onlink-source")
+	defer tuntest.DeleteNamedNS(t, workerPodNS)
+	tuntest.BridgeAdd(t, workerPodNS, "eth0")
+	tuntest.AddrAdd(t, workerPodNS, "eth0", "10.0.0.2/32")
+	defaultRoute := &netops.Route{
+		Destination: netip.MustParsePrefix("0.0.0.0/0"),
+		Gateway:     netip.MustParseAddr("169.254.1.1"),
+		Device:      "eth0",
+		Onlink:      true,
+	}
+	require.NoError(t, workerPodNS.RouteAdd(defaultRoute))
+
+	guestPodNS, _ := tuntest.NewNamedNS(t, "test-onlink-target")
+	defer tuntest.DeleteNamedNS(t, guestPodNS)
+	tuntest.BridgeAdd(t, guestPodNS, "eth0")
+	tuntest.AddrAdd(t, guestPodNS, "eth0", "10.0.0.2/32")
+
+	require.NoError(t, workerNS.Run(func() error {
+		workerNode, err := NewWorkerNode(&tunneler.NetworkConfig{TunnelType: mockTunnelType})
+		if err != nil {
+			return err
+		}
+		config, err := workerNode.Inspect(workerPodNS.Path())
+		if err != nil {
+			return err
+		}
+		require.Len(t, config.Routes, 1)
+		require.True(t, config.Routes[0].Onlink)
+
+		// Inspect's JSON is the actual worker-to-guest transport for PodNode.Setup.
+		encoded, err := json.Marshal(config)
+		if err != nil {
+			return err
+		}
+		var guestConfig tunneler.Config
+		if err := json.Unmarshal(encoded, &guestConfig); err != nil {
+			return err
+		}
+		require.True(t, guestConfig.Routes[0].Onlink)
+
+		// A /32 Pod IP cannot reach this link-local gateway without RTNH_F_ONLINK.
+		withoutOnlink := guestConfig
+		withoutOnlink.Routes = []*tunneler.Route{{
+			Dst: guestConfig.Routes[0].Dst, GW: guestConfig.Routes[0].GW,
+			Dev: guestConfig.Routes[0].Dev,
+		}}
+		require.Error(t, NewPodNode(guestPodNS.Path(), "", &withoutOnlink).Setup())
+		require.NoError(t, NewPodNode(guestPodNS.Path(), "", &guestConfig).Setup())
+		routes, err := guestPodNS.RouteList()
+		if err != nil {
+			return err
+		}
+		require.Len(t, routes, 1)
+		require.True(t, routes[0].Onlink)
+		return nil
+	}))
+}
