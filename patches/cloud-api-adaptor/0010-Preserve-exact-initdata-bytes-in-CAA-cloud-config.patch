+++ b/src/cloud-api-adaptor/pkg/adaptor/cloud/initdata_cloudconfig_test.go
@@ -0,0 +1,96 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package cloud
+
+import (
+	"encoding/base64"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-api-adaptor/pkg/paths"
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-providers/util/cloudinit"
+	yaml "gopkg.in/yaml.v2"
+)
+
+func TestExactInitdataCloudConfig(t *testing.T) {
+	config := &cloudinit.CloudConfig{WriteFiles: []cloudinit.WriteFile{
+		{Path: "/run/peerpod/apf.json", Content: "{\"tls\":true}"},
+		{Path: "/run/peerpod/auth.json", Content: "{\"auths\":{}}\n"},
+		{Path: paths.InitDataPath, Content: "Zg=="},
+		{Path: "/run/peerpod/scratch-space", Content: ""},
+	}}
+	original, err := config.Generate()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var before cloudinit.CloudConfig
+	if err := yaml.UnmarshalStrict([]byte(original), &before); err != nil {
+		t.Fatal(err)
+	}
+	if got := before.WriteFiles[2].Content; got != "Zg==\n" {
+		t.Fatalf("fixture did not reproduce the extra newline: %q", got)
+	}
+
+	result, err := cloudConfigForInstance(config).Generate()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.HasPrefix(result, "#cloud-config\n") {
+		t.Fatal("missing cloud-config header")
+	}
+	var after cloudinit.CloudConfig
+	if err := yaml.UnmarshalStrict([]byte(result), &after); err != nil {
+		t.Fatal(err)
+	}
+	if len(after.WriteFiles) != len(before.WriteFiles) {
+		t.Fatal("write_files count changed")
+	}
+	for index := range before.WriteFiles {
+		if index == 2 {
+			continue
+		}
+		if !reflect.DeepEqual(before.WriteFiles[index], after.WriteFiles[index]) {
+			t.Fatalf("non-initdata write_file %d changed", index)
+		}
+	}
+	if got := after.WriteFiles[2].Content; got != "Zg==" {
+		t.Fatalf("initdata bytes changed: %q", got)
+	}
+	if _, err := base64.StdEncoding.Strict().DecodeString(after.WriteFiles[2].Content); err != nil {
+		t.Fatalf("initdata is not strict padded base64: %v", err)
+	}
+}
+
+func TestExactInitdataCloudConfigRejectsDuplicatesAndNewlines(t *testing.T) {
+	for _, test := range []struct {
+		name  string
+		files []cloudinit.WriteFile
+	}{
+		{name: "duplicate", files: []cloudinit.WriteFile{
+			{Path: paths.InitDataPath, Content: "Zg=="},
+			{Path: paths.InitDataPath, Content: "Zg=="},
+		}},
+		{name: "newline", files: []cloudinit.WriteFile{
+			{Path: paths.InitDataPath, Content: "Zg==\n"},
+		}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			config := &cloudinit.CloudConfig{WriteFiles: test.files}
+			if _, err := cloudConfigForInstance(config).Generate(); err == nil {
+				t.Fatal("invalid initdata cloud-config was accepted")
+			}
+		})
+	}
+}
+
+func TestCloudConfigWithoutInitdataIsUnchanged(t *testing.T) {
+	config := &cloudinit.CloudConfig{WriteFiles: []cloudinit.WriteFile{
+		{Path: "/run/peerpod/apf.json", Content: "{}"},
+	}}
+	wrapped := cloudConfigForInstance(config)
+	if wrapped != config {
+		t.Fatal("cloud-config without initdata must use upstream generator")
+	}
+}
