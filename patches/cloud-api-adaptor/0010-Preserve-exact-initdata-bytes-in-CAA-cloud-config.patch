+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package cloud
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-api-adaptor/pkg/paths"
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-providers/util/cloudinit"
+	yaml "gopkg.in/yaml.v2"
+)
+
+// cloudConfigForInstance preserves the default cloud-config format for VMs
+// without initdata. The initdata annotation is a single-line base64 value;
+// its YAML block scalar must not add a newline before the guest reads it.
+func cloudConfigForInstance(config *cloudinit.CloudConfig) cloudinit.CloudConfigGenerator {
+	for _, file := range config.WriteFiles {
+		if file.Path == paths.InitDataPath {
+			return exactInitdataCloudConfig{config: config}
+		}
+	}
+	return config
+}
+
+type exactInitdataCloudConfig struct {
+	config *cloudinit.CloudConfig
+}
+
+func (config exactInitdataCloudConfig) Generate() (string, error) {
+	var encoded string
+	count := 0
+	for _, file := range config.config.WriteFiles {
+		if file.Path == paths.InitDataPath {
+			encoded = file.Content
+			count++
+		}
+	}
+	if count != 1 || encoded == "" || strings.ContainsAny(encoded, "\r\n") {
+		return "", fmt.Errorf("cloud-config requires one single-line initdata file")
+	}
+
+	original, err := config.config.Generate()
+	if err != nil {
+		return "", err
+	}
+	var parsed cloudinit.CloudConfig
+	if err := yaml.UnmarshalStrict([]byte(original), &parsed); err != nil {
+		return "", fmt.Errorf("parse generated cloud-config: %w", err)
+	}
+	count = 0
+	changed := false
+	for index := range parsed.WriteFiles {
+		if parsed.WriteFiles[index].Path != paths.InitDataPath {
+			continue
+		}
+		count++
+		switch parsed.WriteFiles[index].Content {
+		case encoded:
+			// A future cloudinit generator may already preserve exact bytes.
+		case encoded + "\n":
+			parsed.WriteFiles[index].Content = encoded
+			changed = true
+		default:
+			return "", fmt.Errorf("generated initdata differs from exact annotation")
+		}
+	}
+	if count != 1 {
+		return "", fmt.Errorf("generated cloud-config has %d initdata files", count)
+	}
+	if !changed {
+		return original, nil
+	}
+
+	body, err := yaml.Marshal(&parsed)
+	if err != nil {
+		return "", fmt.Errorf("serialize exact initdata cloud-config: %w", err)
+	}
+	var verified cloudinit.CloudConfig
+	if err := yaml.UnmarshalStrict(body, &verified); err != nil {
+		return "", fmt.Errorf("verify exact initdata cloud-config: %w", err)
+	}
+	if !reflect.DeepEqual(parsed.WriteFiles, verified.WriteFiles) {
+		return "", fmt.Errorf("cloud-config write_files changed while preserving initdata")
+	}
+	return "#cloud-config\n" + string(body), nil
+}
