+		Annotations: map[string]string{util.CloudVolumesAnnotationKey: "{}", "io.kubernetes.cri.container-name": "unmeasured"},
+		Mounts:      []*pb.Mount{{Destination: "/secrets"}}}}
+	_, err := i.createContainer(context.Background(), req, func(context.Context, *pb.CreateContainerRequest, string) ([]*preparedCloudVolume, error) {
+		return []*preparedCloudVolume{volume}, nil
+	})
+	require.ErrorContains(t, err, "unmeasured container")
