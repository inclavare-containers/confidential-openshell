diff --git a/src/cloud-api-adaptor/pkg/forwarder/interceptor/sealed_volume.go b/src/cloud-api-adaptor/pkg/forwarder/interceptor/sealed_volume.go
new file mode 100644
index 00000000..64608354
--- /dev/null
+++ b/src/cloud-api-adaptor/pkg/forwarder/interceptor/sealed_volume.go
@@ -0,0 +1,216 @@
+// Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package interceptor
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+
+	pb "github.com/kata-containers/kata-containers/src/runtime/virtcontainers/pkg/agent/protocols/grpc"
+	"golang.org/x/sys/unix"
+)
+
+const (
+	sealedVolumePrivateRoot = "/run/peerpod/verified-secrets"
+	sealedVolumeMaxManifest = 64 << 10
+	sealedVolumeMaxFile     = 1 << 20
+	sealedVolumeMaxFiles    = 16
+	sharedContainersRoot    = "/run/kata-containers/shared/containers"
+)
+
+var (
+	sealedVolumeFilename = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$`)
+	sealedVolumeDigest   = regexp.MustCompile(`^[a-f0-9]{64}$`)
+	sealedContainerID    = regexp.MustCompile(`^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$`)
+)
+
+// The manifest is supplied by measured initdata in the guest.
+type sealedVolumeManifest struct {
+	Schema           int               `json:"schema"`
+	Container        string            `json:"sealed_volume_container"`
+	Destination      string            `json:"sealed_volume_destination"`
+	DescriptorSHA256 map[string]string `json:"sealed_descriptor_sha256"`
+}
+
+type sealedVolumeGate struct {
+	manifest                sealedVolumeManifest
+	privateRoot, sharedRoot string
+	requireTmpfs            bool
+	mu                      sync.Mutex
+}
+
+// Read only regular, bounded files. O_NONBLOCK prevents a substituted FIFO
+// from blocking before its type can be checked; os.Root confines symlinks.
+func readSealedFile(root *os.Root, name string, limit int64, flags int) ([]byte, error) {
+	file, err := root.OpenFile(name, os.O_RDONLY|unix.O_NONBLOCK|flags, 0)
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() || info.Size() <= 0 || info.Size() > limit {
+		return nil, errors.New("sealed input must be a bounded regular file")
+	}
+	data, err := io.ReadAll(io.LimitReader(file, limit+1))
+	if len(data) > int(limit) {
+		return nil, errors.New("sealed input exceeds size limit")
+	}
+	return data, err
+}
+
+func loadSealedVolumeGate(path string) (*sealedVolumeGate, error) {
+	if !filepath.IsAbs(path) || filepath.Clean(path) != path {
+		return nil, errors.New("manifest path must be absolute and clean")
+	}
+	root, err := os.OpenRoot(filepath.Dir(path))
+	if err != nil {
+		return nil, err
+	}
+	defer root.Close()
+	data, err := readSealedFile(root, filepath.Base(path), sealedVolumeMaxManifest, unix.O_NOFOLLOW)
+	if err != nil {
+		return nil, err
+	}
+	var manifest sealedVolumeManifest
+	if err := json.Unmarshal(data, &manifest); err != nil {
+		return nil, err
+	}
+	if err := validateSealedVolumeManifest(manifest); err != nil {
+		return nil, err
+	}
+	return &sealedVolumeGate{manifest: manifest, privateRoot: sealedVolumePrivateRoot, sharedRoot: sharedContainersRoot, requireTmpfs: true}, nil
+}
+
+func validateSealedVolumeManifest(m sealedVolumeManifest) error {
+	if m.Schema != 1 || !sealedContainerID.MatchString(m.Container) || !filepath.IsAbs(m.Destination) || filepath.Clean(m.Destination) != m.Destination || m.Destination == "/" || len(m.DescriptorSHA256) == 0 || len(m.DescriptorSHA256) > sealedVolumeMaxFiles {
+		return errors.New("invalid measured sealed-volume manifest")
+	}
+	for name, digest := range m.DescriptorSHA256 {
+		if !sealedVolumeFilename.MatchString(name) || name == "." || name == ".." || !sealedVolumeDigest.MatchString(digest) {
+			return errors.New("invalid sealed filename or digest")
+		}
+	}
+	return nil
+}
+
+func isWithin(path, root string) bool {
+	return path == root || strings.HasPrefix(path, root+string(os.PathSeparator))
+}
+
+func (g *sealedVolumeGate) privateDirectory(containerID string) (string, error) {
+	if !sealedContainerID.MatchString(containerID) || containerID == "." || containerID == ".." {
+		return "", errors.New("invalid container ID")
+	}
+	if err := os.MkdirAll(g.privateRoot, 0700); err != nil {
+		return "", err
+	}
+	info, err := os.Lstat(g.privateRoot)
+	if err != nil || !info.IsDir() || info.Mode().Perm() != 0700 {
+		return "", errors.New("verified-secret root is not private")
+	}
+	if g.requireTmpfs {
+		var stat unix.Statfs_t
+		if err := unix.Statfs(g.privateRoot, &stat); err != nil || stat.Type != unix.TMPFS_MAGIC {
+			return "", errors.New("verified-secret root must reside on tmpfs")
+		}
+	}
+	path := filepath.Join(g.privateRoot, containerID)
+	return path, os.Mkdir(path, 0750)
+}
+
+func (g *sealedVolumeGate) verifyAndUnseal(ctx context.Context, req *pb.CreateContainerRequest, unseal func(context.Context, []byte) ([]byte, error)) (private string, err error) {
+	if req == nil || req.OCI == nil || req.OCI.Process == nil || req.OCI.Process.User == nil {
+		return "", errors.New("CreateContainer lacks process identity")
+	}
+	if !sealedContainerID.MatchString(req.ContainerId) || req.OCI.Root == nil || req.OCI.Root.Path != filepath.Join("/run/kata-containers", req.ContainerId, "rootfs") {
+		return "", errors.New("container ID does not match OCI root bundle")
+	}
+	var target *pb.Mount
+	for _, m := range req.OCI.Mounts {
+		if m.Destination == g.manifest.Destination {
+			if target != nil || m.Type != "bind" || !hasMountOption(m.Options, "ro") || hasMountOption(m.Options, "rw") {
+				return "", errors.New("invalid sealed-volume bind mount")
+			}
+			target = m
+		}
+	}
+	if target == nil {
+		return "", errors.New("expected sealed-volume mount is absent")
+	}
+	// Root confinement replaces assumptions about Kata's generated directory name.
+	shared, err := os.OpenRoot(g.sharedRoot)
+	if err != nil {
+		return "", err
+	}
+	defer shared.Close()
+	relative, err := filepath.Rel(g.sharedRoot, target.Source)
+	if err != nil {
+		return "", err
+	}
+	source, err := shared.OpenRoot(relative)
+	if err != nil {
+		return "", err
+	}
+	defer source.Close()
+	private, err = g.privateDirectory(req.ContainerId)
+	if err != nil {
+		return "", err
+	}
+	// A fresh private directory receives only measured filenames. Extra host
+	// files, including preseeded *.unsealed files, can never enter the container.
+	directory := private
+	defer func() {
+		if err != nil {
+			_ = os.RemoveAll(directory)
+		}
+	}()
+	if err = os.Chown(private, 0, int(req.OCI.Process.User.GID)); err != nil {
+		return "", err
+	}
+	for name, expected := range g.manifest.DescriptorSHA256 {
+		sealed, readErr := readSealedFile(source, name, sealedVolumeMaxFile, 0)
+		if readErr != nil {
+			return "", readErr
+		}
+		digest := sha256.Sum256(sealed)
+		if !strings.HasPrefix(string(sealed), "sealed.") || hex.EncodeToString(digest[:]) != expected {
+			return "", fmt.Errorf("descriptor %s differs from measured manifest", name)
+		}
+		plaintext, unsealErr := unseal(ctx, sealed)
+		if unsealErr != nil || len(plaintext) == 0 || len(plaintext) > sealedVolumeMaxFile {
+			return "", fmt.Errorf("CDH failed to unseal %s: %v", name, unsealErr)
+		}
+		output := filepath.Join(private, name)
+		if err = os.WriteFile(output, plaintext, 0440); err != nil {
+			return "", err
+		}
+		if err = os.Chown(output, 0, int(req.OCI.Process.User.GID)); err != nil {
+			return "", err
+		}
+	}
+	target.Source = private
+	return private, nil
+}
+
+func hasMountOption(options []string, wanted string) bool {
+	for _, option := range options {
+		if option == wanted {
+			return true
+		}
+	}
+	return false
+}
