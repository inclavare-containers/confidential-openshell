+func TestRequiredWorkspaceCannotBeRemovedOrChangedBeforePreparation(t *testing.T) {
+	policy := testWorkspacePolicy()
+	policy.Mounts = map[string][]workspaceMount{"agent": {{MountPoint: "/sandbox", DiskID: "d-abc123"}}}
+	valid := util.CloudVolumeAnnotation{MountPoint: "/sandbox", DiskID: "d-abc123", LUN: "0", FSType: "ext4", FSGroup: "1000"}
+	for _, tc := range []struct{ name, encoded string }{
+		{"missing annotation", ""}, {"empty object", "{}"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			i := &interceptor{requireEncryptedVolumes: true, workspace: &policy, Redirector: &mockRedirector{}}
+			req := &pb.CreateContainerRequest{OCI: &pb.Spec{Linux: &pb.Linux{}, Annotations: map[string]string{"io.kubernetes.cri.container-name": "agent", util.CloudVolumesAnnotationKey: tc.encoded}, Mounts: []*pb.Mount{{Destination: "/sandbox", Source: t.TempDir(), Type: "bind"}}}}
+			_, err := i.createContainer(context.Background(), req, i.prepareWorkspaceVolumes)
+			require.ErrorContains(t, err, "workspace")
+			require.Empty(t, i.workspaceVolumes)
+		})
+	}
+	encoded, _ := json.Marshal(map[string]util.CloudVolumeAnnotation{"alias-one": valid, "alias-two": valid})
+	require.Error(t, policy.authorizeMounts("agent", mustDecodeVolumes(t, string(encoded))))
+	// Bootstrap init has no workspace and must still reach the native agent.
+	i := &interceptor{requireEncryptedVolumes: true, workspace: &policy, Redirector: &mockRedirector{}}
+	req := &pb.CreateContainerRequest{OCI: &pb.Spec{Linux: &pb.Linux{}, Annotations: map[string]string{"io.kubernetes.cri.container-name": "openshell-sandbox-bootstrap"}}}
+	_, err := i.createContainer(context.Background(), req, i.prepareWorkspaceVolumes)
+	require.NoError(t, err)
+}
