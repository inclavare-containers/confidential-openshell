diff --git a/src/cloud-api-adaptor/pkg/forwarder/interceptor/workspace.go b/src/cloud-api-adaptor/pkg/forwarder/interceptor/workspace.go
new file mode 100644
index 00000000..77e60fc4
--- /dev/null
+++ b/src/cloud-api-adaptor/pkg/forwarder/interceptor/workspace.go
@@ -0,0 +1,281 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package interceptor
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"golang.org/x/sys/unix"
+	"net/url"
+	"os"
+	"os/exec"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-api-adaptor/pkg/initdata"
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-api-adaptor/pkg/util"
+	toml "github.com/pelletier/go-toml/v2"
+)
+
+const (
+	workspacePolicyName   = "workspace.toml"
+	workspaceInitdataPath = "/run/peerpod/initdata"
+	workspaceInitializer  = "/usr/libexec/peerpod/initialize-workspace-volume"
+)
+
+// The disk list comes from the operator's workspace journal, measured as exact
+// initdata bytes. Host-provided annotations cannot authorize another disk/key.
+type workspaceMount struct {
+	MountPoint string `toml:"mount_point"`
+	DiskID     string `toml:"disk_id"`
+}
+
+type workspacePolicy struct {
+	Mounts          map[string][]workspaceMount `toml:"mounts"`
+	Version         string                      `toml:"version"`
+	KeyURI          string                      `toml:"key_uri"`
+	DiskIDs         []string                    `toml:"disk_ids"`
+	AllowInitialize bool                        `toml:"allow_initialize"`
+	EncryptionType  string                      `toml:"encryption_type"`
+	FilesystemType  string                      `toml:"filesystem_type"`
+}
+
+func loadWorkspacePolicy(path string) (workspacePolicy, error) {
+	var policy workspacePolicy
+	file, err := os.Open(path)
+	if err != nil {
+		return policy, err
+	}
+	defer file.Close()
+	parsed, err := initdata.Parse(file)
+	if err != nil {
+		return policy, fmt.Errorf("parse measured initdata: %w", err)
+	}
+	raw, ok := parsed.Body.Data[workspacePolicyName]
+	if !ok {
+		return policy, fmt.Errorf("measured initdata is missing %s", workspacePolicyName)
+	}
+	if err := toml.NewDecoder(strings.NewReader(raw)).DisallowUnknownFields().Decode(&policy); err != nil {
+		return policy, fmt.Errorf("parse %s: %w", workspacePolicyName, err)
+	}
+	if policy.Version != "0.1.0" || policy.EncryptionType != "luks2" {
+		return policy, errors.New("workspace policy requires version 0.1.0 and luks2")
+	}
+	if err := validateKBSResourceURI(policy.KeyURI); err != nil {
+		return policy, err
+	}
+	if len(policy.Mounts) == 0 {
+		return policy, errors.New("workspace policy requires container mounts")
+	}
+	if len(policy.DiskIDs) == 0 {
+		return policy, errors.New("workspace policy requires a nonempty disk_ids list")
+	}
+	seen := map[string]bool{}
+	for _, id := range policy.DiskIDs {
+		if !alibabaDiskIDPattern.MatchString(id) || seen[id] {
+			return policy, fmt.Errorf("invalid or duplicate workspace disk_id %q", id)
+		}
+		seen[id] = true
+	}
+	return policy, nil
+}
+
+func validateKBSResourceURI(value string) error {
+	resource, err := url.Parse(value)
+	if err != nil || resource.Scheme != "kbs" || resource.Host != "" || resource.RawQuery != "" || resource.Fragment != "" || resource.RawPath != "" || !strings.HasPrefix(value, "kbs:///") {
+		return errors.New("key_uri must be an unescaped kbs:/// resource URI")
+	}
+	parts := strings.Split(strings.TrimPrefix(resource.Path, "/"), "/")
+	if len(parts) != 3 {
+		return errors.New("key_uri must identify a KBS repository, type, and tag")
+	}
+	for _, part := range parts {
+		if part == "" || part == "." || part == ".." || strings.TrimSpace(part) != part {
+			return errors.New("key_uri has an invalid resource component")
+		}
+	}
+	return nil
+}
+
+func (p workspacePolicy) authorize(volume util.CloudVolumeAnnotation) error {
+	bound := false
+	for _, id := range p.DiskIDs {
+		bound = bound || id == volume.DiskID
+	}
+	if !bound || !alibabaDiskIDPattern.MatchString(volume.DiskID) {
+		return errors.New("disk ID is not bound by measured workspace policy")
+	}
+	if volume.FSType != p.FilesystemType {
+		return errors.New("filesystem differs from measured workspace policy")
+	}
+	return nil
+}
+
+// Validate the entire container's measured mounts before opening any device.
+func (p workspacePolicy) authorizeMounts(container string, volumes map[string]util.CloudVolumeAnnotation) error {
+	expected := p.Mounts[container]
+	if len(volumes) != len(expected) {
+		return fmt.Errorf("container %s requires %d workspace mounts, got %d", container, len(expected), len(volumes))
+	}
+	remaining := make(map[string]workspaceMount, len(expected))
+	for _, mount := range expected {
+		remaining[mount.MountPoint] = mount
+	}
+	for _, volume := range volumes {
+		if err := p.authorize(volume); err != nil {
+			return err
+		}
+		mount, ok := remaining[volume.MountPoint]
+		if !ok || mount.DiskID != volume.DiskID {
+			return fmt.Errorf("workspace mount %s differs from measured policy", volume.MountPoint)
+		}
+		delete(remaining, volume.MountPoint)
+	}
+	return nil
+}
+
+func ensureWorkspaceInitialized(ctx context.Context, device string, volume util.CloudVolumeAnnotation, policy workspacePolicy, initialize func(context.Context, string, string, string, string) error) error {
+	luks, err := isLuks(device)
+	if err != nil {
+		return err
+	}
+	if luks {
+		return nil
+	}
+	if volume.ReadOnly {
+		return errors.New("readonly workspace device is not initialized")
+	}
+	if !policy.AllowInitialize {
+		return errors.New("workspace initialization is disabled by measured policy")
+	}
+	if err := initialize(ctx, device, volume.DiskID, volume.FSType, policy.KeyURI); err != nil {
+		return fmt.Errorf("initialize workspace device: %w", err)
+	}
+	luks, err = isLuks(device)
+	if err != nil {
+		return err
+	}
+	if !luks {
+		return errors.New("workspace initializer did not create an embedded LUKS header")
+	}
+	return nil
+}
+
+func initializeWorkspaceVolume(ctx context.Context, device, diskID, fsType, keyURI string, prepared *preparedWorkspaceVolume) error {
+	var stat unix.Stat_t
+	if err := unix.Stat(device, &stat); err != nil {
+		return err
+	}
+	if stat.Mode&unix.S_IFMT != unix.S_IFBLK {
+		return errors.New("workspace initializer requires a block device")
+	}
+	name := fmt.Sprintf("workspace-init-%d-%d", unix.Major(uint64(stat.Rdev)), unix.Minor(uint64(stat.Rdev)))
+	path := "/dev/mapper/" + name
+	if exists, err := blockDeviceExists(path); err != nil {
+		return err
+	} else if exists {
+		return errors.New("workspace initializer mapper already exists; refusing to borrow it")
+	}
+	// Reuse existing mapper ownership while this first-use helper is active.
+	// After success its temporary mapper must be closed before CDH opens one.
+	prepared.cdhMapperName, prepared.cdhMapperPath = name, path
+	prepared.openedCDHMapperHere = true
+	client, err := newCDHClient(ctx, cdhSocketPath)
+	if err != nil {
+		return err
+	}
+	defer client.close()
+	key, err := client.getResource(ctx, keyURI)
+	if err != nil {
+		return err
+	}
+	defer clear(key)
+	if len(key) != 32 {
+		return errors.New("workspace key must be exactly 32 bytes")
+	}
+	// The measured helper rechecks disk identity, policy and the entire blank
+	// device before formatting. The key travels only through a private pipe.
+	command := exec.CommandContext(ctx, workspaceInitializer, device, diskID, fsType, keyURI)
+	command.Stdin = bytes.NewReader(key)
+	if err := runWorkspaceInitializer(ctx, command, prepared); err != nil {
+		return fmt.Errorf("workspace initializer failed: %w", err)
+	}
+	if exists, err := blockDeviceExists(path); err != nil {
+		return err
+	} else if exists {
+		return errors.New("workspace initializer left its temporary mapper open")
+	}
+	prepared.openedCDHMapperHere = false
+	return nil
+}
+
+func runWorkspaceInitializer(ctx context.Context, command *exec.Cmd, prepared *preparedWorkspaceVolume) error {
+	command.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	command.Cancel = func() error { return syscall.Kill(-command.Process.Pid, syscall.SIGKILL) }
+	command.WaitDelay = 5 * time.Second
+	err := command.Run()
+	if ctx.Err() != nil && command.Process != nil {
+		// Cleanup waits until every descendant has exited, before inspecting
+		// or closing a mapper that cryptsetup could have acquired late.
+		prepared.initializerProcessGroup = command.Process.Pid
+	}
+	return err
+}
+
+func waitInitializerProcessGroup(ctx context.Context, pid int) error {
+	for {
+		err := syscall.Kill(-pid, 0)
+		if errors.Is(err, syscall.ESRCH) {
+			return nil
+		}
+		if err != nil {
+			return fmt.Errorf("inspect workspace initializer process group: %w", err)
+		}
+		select {
+		case <-ctx.Done():
+			return fmt.Errorf("wait for workspace initializer descendants: %w", ctx.Err())
+		case <-time.After(20 * time.Millisecond):
+		}
+	}
+}
+
+func blockDeviceReadOnly(ctx context.Context, device string) (bool, error) {
+	output, err := exec.CommandContext(ctx, "blockdev", "--getro", device).CombinedOutput()
+	if err != nil {
+		return false, fmt.Errorf("query readonly state for %s: %w", device, err)
+	}
+	value := strings.TrimSpace(string(output))
+	if value != "0" && value != "1" {
+		return false, fmt.Errorf("invalid readonly state for %s", device)
+	}
+	return value == "1", nil
+}
+
+func setBlockDeviceMode(ctx context.Context, device string, readOnly bool) error {
+	mode := "--setrw"
+	if readOnly {
+		mode = "--setro"
+	}
+	if err := exec.CommandContext(ctx, "blockdev", mode, device).Run(); err != nil {
+		return fmt.Errorf("set block device %s mode %s: %w", device, mode, err)
+	}
+	return nil
+}
+
+func blockDeviceExists(path string) (bool, error) {
+	info, err := os.Stat(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return false, nil
+	}
+	if err != nil {
+		return false, err
+	}
+	if info.Mode()&os.ModeDevice == 0 || info.Mode()&os.ModeCharDevice != 0 {
+		return false, fmt.Errorf("expected block device at %s", path)
+	}
+	return true, nil
+}
diff --git a/src/cloud-api-adaptor/pkg/forwarder/interceptor/workspace_mount.go b/src/cloud-api-adaptor/pkg/forwarder/interceptor/workspace_mount.go
new file mode 100644
index 00000000..2f65859b
--- /dev/null
+++ b/src/cloud-api-adaptor/pkg/forwarder/interceptor/workspace_mount.go
@@ -0,0 +1,494 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package interceptor
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-api-adaptor/pkg/util"
+	ctdmount "github.com/containerd/containerd/mount"
+	pb "github.com/kata-containers/kata-containers/src/runtime/virtcontainers/pkg/agent/protocols/grpc"
+	"github.com/moby/sys/mountinfo"
+	"golang.org/x/sys/unix"
+)
+
+// preparedWorkspaceVolume tracks only resources acquired by one CreateContainer
+// call. Reused mounts and mappers are intentionally not owned by that call.
+type preparedWorkspaceVolume struct {
+	initializerProcessGroup int
+	sourcePath              string
+	mountedHere             bool
+	createdDirHere          bool
+	rawDevice               string
+	setRawReadOnlyHere      bool
+	cdhDevicePath           string
+	createdCDHPathHere      bool
+	setReadOnly             func(context.Context, string, bool) error
+	cdhMapperName           string
+	cdhMapperPath           string
+	openedCDHMapperHere     bool
+	unmount                 func(string, int) error
+	closeCDHMapper          func(context.Context, string, string) error
+}
+
+func (v *preparedWorkspaceVolume) owned() bool {
+	return v != nil && (v.mountedHere || v.createdDirHere ||
+		v.openedCDHMapperHere || v.setRawReadOnlyHere || v.createdCDHPathHere || v.initializerProcessGroup != 0)
+}
+
+func (v *preparedWorkspaceVolume) cleanup(ctx context.Context) error {
+	if v == nil {
+		return nil
+	}
+	if v.initializerProcessGroup != 0 {
+		if err := waitInitializerProcessGroup(ctx, v.initializerProcessGroup); err != nil {
+			return err
+		}
+		v.initializerProcessGroup = 0
+	}
+
+	if v.mountedHere {
+		unmount := v.unmount
+		if unmount == nil {
+			unmount = syscall.Unmount
+		}
+		if err := unmount(v.sourcePath, 0); err != nil && !errors.Is(err, syscall.EINVAL) && !errors.Is(err, syscall.ENOENT) {
+			return fmt.Errorf("unmount %s: %w", v.sourcePath, err)
+		}
+		v.mountedHere = false
+	}
+	if v.createdCDHPathHere {
+		if err := os.Remove(v.cdhDevicePath); err != nil && !errors.Is(err, os.ErrNotExist) {
+			return fmt.Errorf("remove CDH device path: %w", err)
+		}
+		v.createdCDHPathHere = false
+	}
+	if v.openedCDHMapperHere {
+		closeMapper := v.closeCDHMapper
+		if closeMapper == nil {
+			closeMapper = closeCryptsetupMapper
+		}
+		if err := closeMapper(ctx, v.cdhMapperName, v.cdhMapperPath); err != nil {
+			return err
+		}
+		v.openedCDHMapperHere = false
+	}
+	if v.setRawReadOnlyHere {
+		setMode := v.setReadOnly
+		if setMode == nil {
+			setMode = setBlockDeviceMode
+		}
+		if err := setMode(ctx, v.rawDevice, false); err != nil {
+			return err
+		}
+		v.setRawReadOnlyHere = false
+	}
+	if v.createdDirHere {
+		if err := os.Remove(v.sourcePath); err != nil && !errors.Is(err, os.ErrNotExist) {
+			return fmt.Errorf("remove mount directory %s: %w", v.sourcePath, err)
+		}
+		v.createdDirHere = false
+	}
+	return nil
+}
+
+func cleanupWorkspaceVolumes(ctx context.Context, volumes []*preparedWorkspaceVolume) error {
+	// Rollback must finish even when the caller canceled CreateContainer.
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 30*time.Second)
+	defer cancel()
+	var cleanupErrors []error
+	for index := len(volumes) - 1; index >= 0; index-- {
+		if err := volumes[index].cleanup(ctx); err != nil {
+			cleanupErrors = append(cleanupErrors, err)
+		}
+	}
+	return errors.Join(cleanupErrors...)
+}
+
+func preserveOriginalError(original, cleanup error) error {
+	if cleanup == nil {
+		return original
+	}
+	return errors.Join(original, fmt.Errorf("rollback cloud volumes: %w", cleanup))
+}
+
+func (i *interceptor) trackOwnedWorkspaceVolumes(volumes []*preparedWorkspaceVolume) {
+	for _, volume := range volumes {
+		if volume.owned() {
+			i.workspaceVolumes = append(i.workspaceVolumes, volume)
+		}
+	}
+}
+
+func (i *interceptor) prepareWorkspaceVolumes(ctx context.Context, req *pb.CreateContainerRequest, encoded string) ([]*preparedWorkspaceVolume, error) {
+	if i.workspace == nil {
+		policy, err := loadWorkspacePolicy(workspaceInitdataPath)
+		if err != nil {
+			return nil, fmt.Errorf("encrypted volumes are required: %w", err)
+		}
+		i.workspace = &policy
+	}
+	if encoded == "" {
+		encoded = "{}"
+	}
+	volumes, err := util.DecodeCloudVolumeAnnotations(encoded)
+	if err != nil {
+		return nil, fmt.Errorf("corrupt cloud_volumes annotation: %w", err)
+	}
+	workspace := i.workspace
+	if err := workspace.authorizeMounts(req.OCI.Annotations["io.kubernetes.cri.container-name"], volumes); err != nil {
+		return nil, err
+	}
+	// Resolve every mount before any persistent device operation. DiskID is the
+	// guest mount identity; host-supplied aliases cannot open a second mapper.
+	for name, volume := range volumes {
+		if err := rewriteWorkspaceMount(req, name, volume, filepath.Join(cloudVolumeMountBase, volume.DiskID)); err != nil {
+			return nil, err
+		}
+	}
+
+	names := make([]string, 0, len(volumes))
+	for name := range volumes {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	prepared := make([]*preparedWorkspaceVolume, 0, len(names))
+	for _, name := range names {
+		volume, err := prepareWorkspaceVolume(ctx, volumes[name].DiskID, volumes[name], workspace)
+		if volume != nil {
+			prepared = append(prepared, volume)
+		}
+		if err != nil {
+			return prepared, err
+		}
+	}
+	return prepared, nil
+}
+
+func prepareWorkspaceVolume(ctx context.Context, name string, volume util.CloudVolumeAnnotation, workspace *workspacePolicy) (*preparedWorkspaceVolume, error) {
+	lun, _ := strconv.Atoi(volume.LUN) // validated by DecodeCloudVolumeAnnotations
+	device, err := findDataDiskDevice(lun, volume.DiskID)
+	if err != nil {
+		return nil, fmt.Errorf("cloud volume %s device discovery: %w", name, err)
+	}
+
+	if err := os.MkdirAll(cloudVolumeMountBase, 0o755); err != nil {
+		return nil, fmt.Errorf("create cloud volume directory: %w", err)
+	}
+	prepared := &preparedWorkspaceVolume{sourcePath: filepath.Join(cloudVolumeMountBase, name), rawDevice: device}
+	if err := os.Mkdir(prepared.sourcePath, 0o755); err == nil {
+		prepared.createdDirHere = true
+	} else if !errors.Is(err, os.ErrExist) {
+		return prepared, fmt.Errorf("create mount point for %s: %w", name, err)
+	} else if info, statErr := os.Lstat(prepared.sourcePath); statErr != nil || !info.IsDir() {
+		if statErr != nil {
+			err = statErr
+		} else {
+			err = fmt.Errorf("existing path is not a directory")
+		}
+		return prepared, fmt.Errorf("use mount point for %s: %w", name, err)
+	}
+
+	if err := ensureWorkspaceInitialized(ctx, device, volume, *workspace, func(ctx context.Context, device, diskID, fsType, uri string) error {
+		return initializeWorkspaceVolume(ctx, device, diskID, fsType, uri, prepared)
+	}); err != nil {
+		return prepared, err
+	}
+	if err := prepareCDHWorkspace(ctx, prepared, name, device, volume, workspace.KeyURI); err != nil {
+		return prepared, err
+	}
+	if err := applyCloudVolumeFSGroup(prepared.sourcePath, volume.FSGroup, volume.ReadOnly); err != nil {
+		return prepared, err
+	}
+	return prepared, nil
+
+}
+
+// CDH opens the encrypted device; mount flags are enforced on its filesystem.
+
+func prepareCDHWorkspace(ctx context.Context, prepared *preparedWorkspaceVolume, name, device string, volume util.CloudVolumeAnnotation, keyURI string) error {
+	prepared.cdhMapperName = "caa-" + name
+	prepared.cdhMapperPath = filepath.Join("/dev/mapper", prepared.cdhMapperName)
+	prepared.cdhDevicePath = filepath.Join(cloudVolumeMountBase, "."+prepared.cdhMapperName+".device")
+	mapperExisted, err := blockDeviceExists(prepared.cdhMapperPath)
+	if err != nil {
+		return err
+	}
+	if mapperExisted {
+		if err := verifyCDHMapper(ctx, prepared.cdhMapperPath, device); err != nil {
+			return err
+		}
+		if volume.ReadOnly {
+			for _, path := range []string{device, prepared.cdhMapperPath} {
+				ro, err := blockDeviceReadOnly(ctx, path)
+				if err != nil {
+					return err
+				}
+				if !ro {
+					return fmt.Errorf("reused encrypted device %s is writable after a readonly request", path)
+				}
+			}
+		}
+		mounted, err := mountedWorkspaceDevice(prepared.cdhMapperPath, prepared.sourcePath, volume.FSType, volume.ReadOnly)
+		if err != nil || mounted {
+			return err
+		}
+	} else {
+		if mounted, err := mountinfo.Mounted(prepared.sourcePath); err != nil {
+			return err
+		} else if mounted {
+			return fmt.Errorf("mount point for %s is already backed by an unexpected device", name)
+		}
+		if _, err := os.Lstat(prepared.cdhDevicePath); !errors.Is(err, os.ErrNotExist) {
+			return fmt.Errorf("CDH device path for %s must not already exist", name)
+		}
+		if volume.ReadOnly {
+			ro, err := blockDeviceReadOnly(ctx, device)
+			if err != nil {
+				return err
+			}
+			if !ro {
+				prepared.setRawReadOnlyHere = true
+				if err := setBlockDeviceMode(ctx, device, true); err != nil {
+					return err
+				}
+			}
+		}
+		// Mark acquisition before RPC so an applied-but-unreported open is
+		// reclaimed, while mappings borrowed from an earlier call stay open.
+		prepared.openedCDHMapperHere = true
+		secureErr := secureMount(ctx, device, prepared.cdhDevicePath, keyURI, prepared.cdhMapperName)
+		exists, statErr := blockDeviceExists(prepared.cdhMapperPath)
+		if !exists && statErr == nil {
+			prepared.openedCDHMapperHere = false
+		}
+		if target, err := os.Readlink(prepared.cdhDevicePath); err == nil && target == prepared.cdhMapperPath {
+			prepared.createdCDHPathHere = true
+		}
+		if secureErr != nil || statErr != nil {
+			return errors.Join(secureErr, statErr)
+		}
+		if !exists || !prepared.createdCDHPathHere {
+			return fmt.Errorf("CDH did not open expected encrypted device for %s", name)
+		}
+		if err := verifyCDHMapper(ctx, prepared.cdhMapperPath, device); err != nil {
+			return err
+		}
+		if volume.ReadOnly {
+			if err := setBlockDeviceMode(ctx, prepared.cdhMapperPath, true); err != nil {
+				return err
+			}
+			for _, path := range []string{device, prepared.cdhMapperPath} {
+				ro, err := blockDeviceReadOnly(ctx, path)
+				if err != nil {
+					return err
+				}
+				if !ro {
+					return fmt.Errorf("encrypted device %s remains writable", path)
+				}
+			}
+		}
+	}
+	// Existing encrypted data is never repaired or formatted. Only the
+	// measured first-use initializer may create its embedded header and FS.
+	output, err := exec.CommandContext(ctx, "blkid", "-p", "-s", "TYPE", "-o", "value", prepared.cdhMapperPath).CombinedOutput()
+	if err != nil || strings.TrimSpace(string(output)) != volume.FSType {
+		return fmt.Errorf("encrypted device for %s lacks expected filesystem %s; refusing to format", name, volume.FSType)
+	}
+	prepared.mountedHere, err = mountWorkspaceFilesystem(ctx, prepared.cdhMapperPath, prepared.sourcePath, volume.FSType, volume.ReadOnly, volume.Options)
+	return err
+}
+
+// Mount an initialized encrypted workspace without formatting it.
+func mountWorkspaceFilesystem(ctx context.Context, device, mountPoint, fsType string, readOnly bool, options []string) (bool, error) {
+	if mounted, err := mountedWorkspaceDevice(device, mountPoint, fsType, readOnly); err != nil || mounted {
+		return false, err
+	}
+	if err := ctx.Err(); err != nil {
+		return false, err
+	}
+	mountErr := ctdmount.All([]ctdmount.Mount{{Type: fsType, Source: device, Options: options}}, mountPoint)
+
+	// Observe ownership independently of exit status and validation so a
+	// partial/incorrect mount is still unwound before its mapper closes.
+	mounted, inspectErr := mountinfo.Mounted(mountPoint)
+	if inspectErr != nil {
+		return mounted, errors.Join(mountErr, inspectErr)
+	}
+	if mounted {
+		_, validateErr := mountedWorkspaceDevice(device, mountPoint, fsType, readOnly)
+		return true, errors.Join(mountErr, validateErr)
+	}
+	return false, errors.Join(mountErr, fmt.Errorf("filesystem was not mounted at %s", mountPoint))
+}
+
+func verifyCDHMapper(ctx context.Context, mapper, device string) error {
+	resolved, err := filepath.EvalSymlinks(mapper)
+	if err != nil {
+		return err
+	}
+	if !workspaceDeviceGraphContains("/sys/class/block", filepath.Base(resolved), filepath.Base(device)) {
+		return fmt.Errorf("encrypted mapper %s is not backed by expected device %s", mapper, device)
+	}
+	return verifyWorkspaceMapperEncryption(ctx, mapper)
+}
+
+// Inspect the active kernel mapping, not the mutable on-disk header. The
+// first-use initializer fixes these parameters; CDH opens existing volumes.
+func verifyWorkspaceMapperEncryption(ctx context.Context, mapper string) error {
+	command := exec.CommandContext(ctx, "cryptsetup", "status", mapper)
+	command.Env = append(os.Environ(), "LC_ALL=C")
+	status, err := command.Output()
+	if err != nil {
+		return fmt.Errorf("inspect workspace encryption: %w", err)
+	}
+	return validateWorkspaceMapperStatus(string(status))
+}
+
+func validateWorkspaceMapperStatus(status string) error {
+	fields := make(map[string]string)
+	for _, line := range strings.Split(status, "\n") {
+		key, value, ok := strings.Cut(line, ":")
+		if ok {
+			fields[strings.TrimSpace(key)] = strings.Join(strings.Fields(value), " ")
+		}
+	}
+	if fields["type"] != "LUKS2" || fields["cipher"] != "aes-xts-plain64" ||
+		fields["keysize"] != "512 [bits]" || fields["sector size"] != "4096 [bytes]" {
+		return errors.New("workspace mapper does not use required LUKS2 AES-XTS-512 encryption with 4096-byte sectors")
+	}
+	return nil
+}
+
+func closeCryptsetupMapper(ctx context.Context, name, path string) error {
+	exists, err := blockDeviceExists(path)
+	if err != nil || !exists {
+		return err
+	}
+	output, closeErr := exec.CommandContext(ctx, "cryptsetup", "close", name).CombinedOutput()
+	exists, statErr := blockDeviceExists(path)
+	if statErr != nil {
+		return errors.Join(closeErr, statErr)
+	}
+	if closeErr != nil && exists {
+		return fmt.Errorf("close CDH mapper %s: %s: %w", name, strings.TrimSpace(string(output)), closeErr)
+	}
+	if exists {
+		return fmt.Errorf("CDH mapper %s remains open after close", name)
+	}
+	return nil
+}
+
+func rewriteWorkspaceMount(req *pb.CreateContainerRequest, name string, volume util.CloudVolumeAnnotation, source string) error {
+	matched := -1
+	for index, mount := range req.OCI.Mounts {
+		if mount.Destination != volume.MountPoint {
+			continue
+		}
+		if matched >= 0 {
+			return fmt.Errorf("cloud volume %s mount point %q is ambiguous in container mounts", name, volume.MountPoint)
+		}
+		matched = index
+	}
+	if matched < 0 {
+		return fmt.Errorf("cloud volume %s mount point %q is absent from container mounts", name, volume.MountPoint)
+	}
+	mount := req.OCI.Mounts[matched]
+	mount.Source = source
+	mount.Type = "bind"
+	mount.Options = normalizeBindMountOptions(mount.Options, volume.ReadOnly)
+	return nil
+}
+
+// mountedWorkspaceDevice rejects reuse of a mount point backed by a different
+// device, filesystem, or access mode.
+func mountedWorkspaceDevice(device, mountPoint, fsType string, readOnly bool) (bool, error) {
+	resolved, err := filepath.EvalSymlinks(mountPoint)
+	if err != nil {
+		return false, err
+	}
+	mounts, err := mountinfo.GetMounts(func(info *mountinfo.Info) (skip, stop bool) {
+		return info.Mountpoint != resolved, false
+	})
+	if err != nil || len(mounts) == 0 {
+		return false, err
+	}
+	mount := mounts[len(mounts)-1]
+	var stat unix.Stat_t
+	if err := unix.Stat(device, &stat); err != nil {
+		return false, fmt.Errorf("stat mounted device %s: %w", device, err)
+	}
+	if err := validateReusableWorkspaceMount(mountPoint, mount, &stat, fsType, readOnly); err != nil {
+		return false, err
+	}
+	return true, nil
+}
+
+func validateReusableWorkspaceMount(mountPoint string, mount *mountinfo.Info, stat *unix.Stat_t, fsType string, readOnly bool) error {
+	if mount.Root != "/" {
+		return fmt.Errorf("mount point %s exposes filesystem root %q, expected /", mountPoint, mount.Root)
+	}
+	if stat.Mode&unix.S_IFMT != unix.S_IFBLK || mount.Major != int(unix.Major(uint64(stat.Rdev))) ||
+		mount.Minor != int(unix.Minor(uint64(stat.Rdev))) || mount.FSType != fsType {
+		return fmt.Errorf("mount point %s is backed by an unexpected device or filesystem", mountPoint)
+	}
+	actualReadOnly := false
+	for _, option := range strings.Split(mount.Options+","+mount.VFSOptions, ",") {
+		actualReadOnly = actualReadOnly || option == "ro"
+	}
+	if actualReadOnly != readOnly {
+		return fmt.Errorf("mount point %s readonly=%t, expected %t", mountPoint, actualReadOnly, readOnly)
+	}
+	return nil
+}
+
+// workspaceDeviceGraphContains follows the kernel block graph instead of assuming
+// that a workspace filesystem is mounted directly from a whole disk. This
+// follows backing devices (slaves) and partition parents. Holder links point
+// toward consumers, not backing devices, and must not establish ownership.
+func workspaceDeviceGraphContains(classBlockRoot, start, target string) bool {
+	seen := make(map[string]struct{})
+	var visit func(string) bool
+	visit = func(name string) bool {
+		name = filepath.Base(filepath.Clean(name))
+		if name == "" || name == "." {
+			return false
+		}
+		if name == target {
+			return true
+		}
+		if _, exists := seen[name]; exists {
+			return false
+		}
+		seen[name] = struct{}{}
+
+		devicePath := filepath.Join(classBlockRoot, name)
+		if _, err := os.Stat(filepath.Join(devicePath, "partition")); err == nil {
+			if resolved, err := filepath.EvalSymlinks(devicePath); err == nil {
+				parent := filepath.Base(filepath.Dir(resolved))
+				if parent != name && visit(parent) {
+					return true
+				}
+			}
+		}
+		entries, _ := os.ReadDir(filepath.Join(devicePath, "slaves"))
+		for _, entry := range entries {
+			if visit(entry.Name()) {
+				return true
+			}
+		}
+		return false
+	}
+	return visit(start)
+}
