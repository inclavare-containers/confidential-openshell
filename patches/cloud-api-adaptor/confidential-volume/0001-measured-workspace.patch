+// Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package interceptor
+
+import (
+	"context"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/sys/unix"
+)
+
+// Opt in inside a private mount namespace. Only the fresh loop device allocated
+// from this test's temporary file is formatted; no host disk is selected.
+func TestWorkspaceFilesystemLoopDevice(t *testing.T) {
+	if os.Getenv("CAA_TEST_LOOP_MOUNT") != "1" {
+		t.Skip("requires root, loop devices and a private mount namespace")
+	}
+	directory := t.TempDir()
+	backing := filepath.Join(directory, "disk")
+	file, err := os.Create(backing)
+	require.NoError(t, err)
+	require.NoError(t, file.Truncate(64<<20))
+	require.NoError(t, file.Close())
+	output, err := exec.Command("losetup", "--find", "--show", backing).CombinedOutput()
+	require.NoError(t, err, string(output))
+	device := strings.TrimSpace(string(output))
+	t.Cleanup(func() {
+		output, err := exec.Command("losetup", "--detach", device).CombinedOutput()
+		require.NoError(t, err, string(output))
+	})
+	target := filepath.Join(directory, "mount")
+	require.NoError(t, os.Mkdir(target, 0755))
+	t.Cleanup(func() { _ = unix.Unmount(target, 0) })
+	ctx := context.Background()
+
+	// The mount operation never formats an empty disk.
+	mounted, err := mountWorkspaceFilesystem(ctx, device, target, "ext4", false, nil)
+	require.Error(t, err)
+	require.False(t, mounted)
+	output, err = exec.Command("mkfs.ext4", device).CombinedOutput()
+	require.NoError(t, err, string(output))
+	mounted, err = mountWorkspaceFilesystem(ctx, device, target, "ext4", false, []string{"nodev", "nosuid"})
+	require.NoError(t, err)
+	require.True(t, mounted)
+	marker := filepath.Join(target, "retained")
+	require.NoError(t, os.WriteFile(marker, []byte("retained-data"), 0600))
+	mounted, err = mountWorkspaceFilesystem(ctx, device, target, "ext4", false, []string{"nodev", "nosuid"})
+	require.NoError(t, err)
+	require.False(t, mounted, "reused mount must not transfer cleanup ownership")
+	_, err = mountWorkspaceFilesystem(ctx, device, target, "ext4", true, []string{"ro"})
+	require.Error(t, err, "writable mount must not satisfy readonly reuse")
+	require.NoError(t, unix.Unmount(target, 0))
+
+	mounted, err = mountWorkspaceFilesystem(ctx, device, target, "ext4", true, []string{"ro", "nodev", "nosuid"})
+	require.NoError(t, err)
+	require.True(t, mounted)
+	data, err := os.ReadFile(marker)
+	require.NoError(t, err)
+	require.Equal(t, "retained-data", string(data))
+	require.ErrorIs(t, os.WriteFile(marker, []byte("changed"), 0600), unix.EROFS)
+}
diff --git a/src/cloud-api-adaptor/pkg/forwarder/interceptor/workspace_mount_test.go b/src/cloud-api-adaptor/pkg/forwarder/interceptor/workspace_mount_test.go
