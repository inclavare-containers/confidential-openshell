+func TestCreateContainerRollsBackWorkspacePreparationAndAgentFailure(t *testing.T) {
+	for _, tc := range []struct {
+		name                               string
+		preparationFailure, cleanupFailure bool
+	}{
+		{name: "agent rejection"}, {name: "preparation failure", preparationFailure: true}, {name: "failed rollback retained for destroy", cleanupFailure: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			owned := filepath.Join(t.TempDir(), "owned")
+			require.NoError(t, os.Mkdir(owned, 0700))
+			borrowed := filepath.Join(t.TempDir(), "borrowed")
+			require.NoError(t, os.Mkdir(borrowed, 0700))
+			unmountErr := errors.New("device busy")
+			cleaned := false
+			mapperClosed := false
+			v := &preparedWorkspaceVolume{sourcePath: owned, createdDirHere: true, mountedHere: true, unmount: func(string, int) error {
+				cleaned = true
+				if tc.cleanupFailure {
+					return unmountErr
+				}
+				return nil
+			}}
+			v.openedCDHMapperHere = true
+			v.closeCDHMapper = func(context.Context, string, string) error { mapperClosed = true; return nil }
+			i := &interceptor{requireEncryptedVolumes: true, Redirector: &mockRedirector{createContainerError: errors.New("agent rejected container")}}
+			req := &pb.CreateContainerRequest{OCI: &pb.Spec{Linux: &pb.Linux{}, Annotations: map[string]string{util.CloudVolumesAnnotationKey: "{}"}}}
+			_, err := i.createContainer(context.Background(), req, func(context.Context, *pb.CreateContainerRequest, string) ([]*preparedWorkspaceVolume, error) {
+				volumes := []*preparedWorkspaceVolume{v, {sourcePath: borrowed}}
+				if tc.preparationFailure {
+					return volumes, errors.New("preparation failed")
+				}
+				return volumes, nil
+			})
+			require.Error(t, err)
+			require.True(t, cleaned, "early error skipped resource rollback")
+			require.DirExists(t, borrowed, "rollback removed a borrowed resource")
+			if tc.cleanupFailure {
+				require.ErrorIs(t, err, unmountErr)
+				require.Len(t, i.workspaceVolumes, 1, "failed cleanup lost ownership")
+				tc.cleanupFailure = false
+				require.NoError(t, cleanupWorkspaceVolumes(context.Background(), i.workspaceVolumes))
+			} else {
+				require.Empty(t, i.workspaceVolumes)
+			}
+			require.NoDirExists(t, owned)
+			require.True(t, mapperClosed)
+		})
+	}
+}
