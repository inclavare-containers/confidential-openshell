@@ -0,0 +1,122 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package interceptor
+
+import (
+	"context"
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-api-adaptor/pkg/initdata"
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-api-adaptor/pkg/util"
+	"github.com/stretchr/testify/require"
+)
+
+const testWorkspaceDocument = `version = "0.1.0"
+key_uri = "kbs:///default/openshell/workspace-key"
+disk_ids = ["d-abc123", "d-second456"]
+allow_initialize = true
+encryption_type = "luks2"
+filesystem_type = "ext4"
+[mounts]
+agent = [{mount_point="/data",disk_id="d-abc123"}]
+`
+
+func testWorkspacePolicy() workspacePolicy {
+	return workspacePolicy{Version: "0.1.0", KeyURI: "kbs:///default/openshell/workspace-key", DiskIDs: []string{"d-abc123", "d-second456"}, AllowInitialize: true, EncryptionType: "luks2", FilesystemType: "ext4"}
+}
+
+func writeWorkspaceInitdata(t *testing.T, document string) string {
+	t.Helper()
+	encoded, err := initdata.Encode("version = \"0.1.0\"\nalgorithm = \"sha384\"\n[data]\n\"workspace.toml\" = '''\n" + document + "'''\n")
+	require.NoError(t, err)
+	path := filepath.Join(t.TempDir(), "initdata")
+	require.NoError(t, os.WriteFile(path, []byte(encoded), 0o600))
+	return path
+}
+
+func TestWorkspaceMeasuredPolicyRejectsUnboundDiskAndKey(t *testing.T) {
+	policy, err := loadWorkspacePolicy(writeWorkspaceInitdata(t, testWorkspaceDocument))
+	require.NoError(t, err)
+	volume := util.CloudVolumeAnnotation{DiskID: "d-second456", FSType: "ext4"}
+	require.NoError(t, policy.authorize(volume))
+	volume.DiskID = "d-replaced"
+	require.ErrorContains(t, policy.authorize(volume), "not bound")
+	volume.DiskID = "d-abc123"
+	volume.FSType = "xfs"
+	require.ErrorContains(t, policy.authorize(volume), "filesystem differs")
+	for _, document := range []string{
+		testWorkspaceDocument + "unknown = true\n",
+		strings.Replace(testWorkspaceDocument, "[\"d-abc123\", \"d-second456\"]", "[]", 1),
+		strings.Replace(testWorkspaceDocument, "d-second456", "d-abc123", 1),
+		strings.Replace(testWorkspaceDocument, "luks2", "plain", 1),
+	} {
+		_, err := loadWorkspacePolicy(writeWorkspaceInitdata(t, document))
+		require.Error(t, err)
+	}
+}
