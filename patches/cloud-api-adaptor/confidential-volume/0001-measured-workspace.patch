@@ -0,0 +1,204 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package interceptor
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/confidential-containers/cloud-api-adaptor/src/cloud-api-adaptor/pkg/util"
+	pb "github.com/kata-containers/kata-containers/src/runtime/virtcontainers/pkg/agent/protocols/grpc"
+	"github.com/moby/sys/mountinfo"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"golang.org/x/sys/unix"
+)
+
+func TestPreparedWorkspaceVolumeCleanupOwnsResourcesIndependently(t *testing.T) {
+	directory := filepath.Join(t.TempDir(), "volume")
+	require.NoError(t, os.Mkdir(directory, 0o755))
+	events := []string{}
+	mapperExists := true
+	rawReadOnly := true
+	volume := &preparedWorkspaceVolume{
+		sourcePath: directory, mountedHere: true, createdDirHere: true,
+		cdhMapperName: "caa-vol-0", cdhMapperPath: "/dev/mapper/caa-vol-0", rawDevice: "/dev/vdb",
+		openedCDHMapperHere: true, setRawReadOnlyHere: true,
+		closeCDHMapper: func(context.Context, string, string) error {
+			events = append(events, "close")
+			mapperExists = false
+			return nil
+		},
+		setReadOnly: func(_ context.Context, _ string, value bool) error {
+			events = append(events, "setrw")
+			rawReadOnly = value
+			return nil
+		},
+		unmount: func(string, int) error {
+			events = append(events, "unmount")
+			return nil
+		},
+	}
+
+	require.NoError(t, volume.cleanup(context.Background()))
+	assert.Equal(t, []string{"unmount", "close", "setrw"}, events)
+	assert.NoDirExists(t, directory)
+	assert.False(t, mapperExists)
+	assert.False(t, rawReadOnly)
+
+	// Cleanup is idempotent and performs no second release.
+	require.NoError(t, volume.cleanup(context.Background()))
+	assert.Equal(t, []string{"unmount", "close", "setrw"}, events)
+}
+
+func TestPreparedWorkspaceVolumeDoesNotCloseReusedMapper(t *testing.T) {
+	closed := false
+	volume := &preparedWorkspaceVolume{
+		cdhMapperName: "reused", cdhMapperPath: "/dev/mapper/reused",
+		closeCDHMapper: func(context.Context, string, string) error { closed = true; return nil },
+	}
+	require.NoError(t, volume.cleanup(context.Background()))
+	assert.False(t, closed)
+}
+
+func TestPreparedWorkspaceVolumeCleanupRetriesInDependencyOrder(t *testing.T) {
+	directory := filepath.Join(t.TempDir(), "volume")
+	require.NoError(t, os.Mkdir(directory, 0o755))
+	closeCalled := false
+	unmountFails := true
+	volume := &preparedWorkspaceVolume{
+		sourcePath: directory, mountedHere: true, createdDirHere: true,
+		cdhMapperName: "owned", cdhMapperPath: "/dev/mapper/owned", openedCDHMapperHere: true,
+		closeCDHMapper: func(context.Context, string, string) error { closeCalled = true; return nil },
+		unmount: func(string, int) error {
+			if unmountFails {
+				return errors.New("busy")
+			}
+			return nil
+		},
+	}
+
+	assert.ErrorContains(t, volume.cleanup(context.Background()), "busy")
+	assert.False(t, closeCalled, "mapper must remain open while its filesystem is mounted")
+	assert.DirExists(t, directory)
+
+	unmountFails = false
+	require.NoError(t, volume.cleanup(context.Background()))
+	assert.True(t, closeCalled)
+	assert.NoDirExists(t, directory)
+}
+
+func TestEncryptedVolumeRequiredNeverFallsBackToRawDisk(t *testing.T) {
+	policy := testWorkspacePolicy()
+	policy.Mounts = map[string][]workspaceMount{"": {{MountPoint: "/data", DiskID: "d-abc123"}}}
+	i := &interceptor{requireEncryptedVolumes: true, workspace: &policy}
+	req := &pb.CreateContainerRequest{OCI: &pb.Spec{Mounts: []*pb.Mount{{Destination: "/data"}}}}
+	_, err := i.prepareWorkspaceVolumes(context.Background(), req,
+		`{"vol-0":{"mount_point":"/data","fs_type":"ext4","lun":"0","disk_id":"d-replaced","readonly":false}}`)
+	assert.ErrorContains(t, err, "not bound by measured workspace policy")
+}
+
+func TestValidateReusableWorkspaceMountRequiresFilesystemRoot(t *testing.T) {
+	stat := &unix.Stat_t{Mode: unix.S_IFBLK, Rdev: unix.Mkdev(8, 1)}
+	mount := &mountinfo.Info{
+		Major: 8, Minor: 1, Root: "/workspace", FSType: "ext4", Options: "rw,relatime",
+	}
+
+	err := validateReusableWorkspaceMount("/run/cloud-volumes/vol-0", mount, stat, "ext4", false)
+	require.ErrorContains(t, err, "filesystem root")
+
+	mount.Root = "/"
+	require.NoError(t, validateReusableWorkspaceMount("/run/cloud-volumes/vol-0", mount, stat, "ext4", false))
+}
+
+func TestRewriteWorkspaceMountRejectsDuplicateDestination(t *testing.T) {
+	req := &pb.CreateContainerRequest{OCI: &pb.Spec{Mounts: []*pb.Mount{
+		{Destination: "/workspace", Source: "/host-controlled"},
+		{Destination: "/workspace", Source: "/csi-source"},
+	}}}
+	volume := util.CloudVolumeAnnotation{MountPoint: "/workspace", ReadOnly: true}
+
+	err := rewriteWorkspaceMount(req, "vol-0", volume, "/run/cloud-volumes/vol-0")
+	require.ErrorContains(t, err, "ambiguous")
+	assert.Equal(t, "/host-controlled", req.OCI.Mounts[0].Source)
+	assert.Equal(t, "/csi-source", req.OCI.Mounts[1].Source)
+}
+
+func TestValidateReusableWorkspaceMountRequiresReadOnly(t *testing.T) {
+	stat := &unix.Stat_t{Mode: unix.S_IFBLK, Rdev: unix.Mkdev(8, 1)}
+	mount := &mountinfo.Info{
+		Major: 8, Minor: 1, Root: "/", FSType: "ext4",
+		Options: "ro,nosuid,nodev,relatime", VFSOptions: "rw",
+	}
+	require.NoError(t, validateReusableWorkspaceMount(
+		"/run/cloud-volumes/vol-0", mount, stat, "ext4", true,
+	))
+	mount.Options = "rw,nosuid,nodev,relatime"
+	err := validateReusableWorkspaceMount(
+		"/run/cloud-volumes/vol-0", mount, stat, "ext4", true,
+	)
+	require.ErrorContains(t, err, "readonly=false, expected true")
+}
+
+func TestWorkspaceMapperEncryptionParameters(t *testing.T) {
+	valid := "/dev/mapper/caa-vol-0 is active.\n  type: LUKS2\n  cipher: aes-xts-plain64\n  keysize: 512 [bits]\n  sector size: 4096 [bytes]\n"
+	require.NoError(t, validateWorkspaceMapperStatus(valid))
+	for _, change := range [][2]string{{"LUKS2", "PLAIN"}, {"aes-xts-plain64", "cipher_null-ecb"}, {"512 [bits]", "256 [bits]"}, {"4096 [bytes]", "512 [bytes]"}} {
+		t.Run(change[1], func(t *testing.T) {
+			require.Error(t, validateWorkspaceMapperStatus(strings.Replace(valid, change[0], change[1], 1)))
+		})
+	}
+	require.Error(t, validateWorkspaceMapperStatus("inactive"))
+}
+
+func TestWorkspaceDeviceGraphFollowsBackingDisk(t *testing.T) {
+	root := t.TempDir()
+	classBlock := filepath.Join(root, "sys", "class", "block")
+	devices := filepath.Join(root, "sys", "devices", "pci", "block", "vda")
+	requireMkdir := func(path string) {
+		t.Helper()
+		if err := os.MkdirAll(path, 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	requireMkdir(filepath.Join(classBlock, "dm-0", "slaves"))
+	requireMkdir(filepath.Join(devices, "vda2"))
+	requireMkdir(filepath.Join(classBlock, "vda"))
+	if err := os.WriteFile(filepath.Join(devices, "vda2", "partition"), []byte("2\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(filepath.Join(devices, "vda2"), filepath.Join(classBlock, "vda2")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(filepath.Join(classBlock, "vda2"), filepath.Join(classBlock, "dm-0", "slaves", "vda2")); err != nil {
+		t.Fatal(err)
+	}
+
+	if !workspaceDeviceGraphContains(classBlock, "dm-0", "vda") {
+		t.Fatal("dm/LVM root did not resolve to its whole-disk backing device")
+	}
+	if workspaceDeviceGraphContains(classBlock, "dm-0", "vdb") {
+		t.Fatal("unrelated data disk was classified as a system-disk backing device")
+	}
+}
+
+func TestWorkspaceDeviceGraphIgnoresHolders(t *testing.T) {
+	classBlock := filepath.Join(t.TempDir(), "sys", "class", "block")
+	if err := os.MkdirAll(filepath.Join(classBlock, "vda", "holders"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(filepath.Join(classBlock, "dm-0"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(filepath.Join(classBlock, "dm-0"), filepath.Join(classBlock, "vda", "holders", "dm-0")); err != nil {
+		t.Fatal(err)
+	}
+	if workspaceDeviceGraphContains(classBlock, "vda", "dm-0") {
+		t.Fatal("consumer was mistaken for a backing device")
+	}
+}
