index 00000000..b5a7d236
--- /dev/null
+++ b/src/cloud-api-adaptor/pkg/forwarder/interceptor/sealed_volume.go
@@ -0,0 +1,262 @@
+// Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package interceptor
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"sync"
+
+	pb "github.com/kata-containers/kata-containers/src/runtime/virtcontainers/pkg/agent/protocols/grpc"
+	"golang.org/x/sys/unix"
+)
+
+const (
+	sealedVolumePrivateRoot = "/run/peerpod/verified-secrets"
+	sealedVolumeMaxManifest = 64 << 10
+	sealedVolumeMaxFile     = 1 << 20
+	sealedVolumeMaxFiles    = 16
+	sharedContainersRoot    = "/run/kata-containers/shared/containers"
+)
+
+var (
+	sealedVolumeFilename = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$`)
+	sealedVolumeDigest   = regexp.MustCompile(`^[a-f0-9]{64}$`)
+	sealedContainerID    = regexp.MustCompile(`^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$`)
+)
+
+// The manifest is materialized by measured initdata in the guest. This layer
+// deliberately needs no knowledge of the operator's role or Secret names.
+type sealedVolumeManifest struct {
+	Schema           int               `json:"schema"`
+	Container        string            `json:"sealed_volume_container"`
+	Destination      string            `json:"sealed_volume_destination"`
+	DescriptorSHA256 map[string]string `json:"sealed_descriptor_sha256"`
+}
+
+type sealedVolumeGate struct {
+	manifest     sealedVolumeManifest
+	privateRoot  string
+	sharedRoot   string
+	requireTmpfs bool
+	mu           sync.Mutex
+}
+
+func loadSealedVolumeGate(path string) (*sealedVolumeGate, error) {
+	if path == "" || !filepath.IsAbs(path) || filepath.Clean(path) != path {
+		return nil, errors.New("sealed-volume manifest path must be absolute and canonical")
+	}
+	fd, err := unix.Open(path, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return nil, fmt.Errorf("open measured sealed-volume manifest: %w", err)
+	}
+	file := os.NewFile(uintptr(fd), path)
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil || !info.Mode().IsRegular() || info.Size() <= 0 || info.Size() > sealedVolumeMaxManifest {
+		return nil, errors.New("measured sealed-volume manifest must be a bounded regular file")
+	}
+	data, err := io.ReadAll(io.LimitReader(file, sealedVolumeMaxManifest+1))
+	if err != nil || len(data) > sealedVolumeMaxManifest {
+		return nil, errors.New("read measured sealed-volume manifest failed")
+	}
+	var manifest sealedVolumeManifest
+	if err := json.Unmarshal(data, &manifest); err != nil {
+		return nil, fmt.Errorf("parse measured sealed-volume manifest: %w", err)
+	}
+	if err := validateSealedVolumeManifest(manifest); err != nil {
+		return nil, err
+	}
+	return &sealedVolumeGate{manifest: manifest, privateRoot: sealedVolumePrivateRoot,
+		sharedRoot: sharedContainersRoot, requireTmpfs: true}, nil
+}
+
+func validateSealedVolumeManifest(m sealedVolumeManifest) error {
+	if m.Schema != 1 || !sealedContainerID.MatchString(m.Container) ||
+		!filepath.IsAbs(m.Destination) || filepath.Clean(m.Destination) != m.Destination ||
+		m.Destination == "/" || len(m.DescriptorSHA256) == 0 ||
+		len(m.DescriptorSHA256) > sealedVolumeMaxFiles {
+		return errors.New("invalid measured sealed-volume manifest shape")
+	}
+	for name, digest := range m.DescriptorSHA256 {
+		if !sealedVolumeFilename.MatchString(name) || name == "." || name == ".." ||
+			!sealedVolumeDigest.MatchString(digest) {
+			return errors.New("invalid measured sealed-volume filename or digest")
+		}
+	}
+	return nil
+}
+
+func isWithin(path, root string) bool {
+	return path == root || strings.HasPrefix(path, root+string(os.PathSeparator))
+}
+
+func (g *sealedVolumeGate) privateDirectory(containerID string) (string, error) {
+	if !sealedContainerID.MatchString(containerID) || containerID == "." || containerID == ".." {
+		return "", errors.New("invalid container ID for verified secret directory")
+	}
+	if err := os.MkdirAll(g.privateRoot, 0700); err != nil {
+		return "", fmt.Errorf("create verified-secret root: %w", err)
+	}
+	rootInfo, err := os.Lstat(g.privateRoot)
+	if err != nil || !rootInfo.IsDir() || rootInfo.Mode().Perm() != 0700 {
+		return "", errors.New("verified-secret root is not a private directory")
+	}
+	if g.requireTmpfs {
+		var stat unix.Statfs_t
+		if err := unix.Statfs(g.privateRoot, &stat); err != nil || stat.Type != unix.TMPFS_MAGIC {
+			return "", errors.New("verified-secret root must reside on tmpfs")
+		}
+	}
+	path := filepath.Join(g.privateRoot, containerID)
+	if err := os.Mkdir(path, 0750); err != nil {
+		return "", fmt.Errorf("create new verified-secret directory: %w", err)
+	}
+	return path, nil
+}
+
+func readSealedDescriptor(directory, name string) ([]byte, error) {
+	rootFD, err := unix.Open(directory, unix.O_PATH|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return nil, fmt.Errorf("open bootstrap mount root: %w", err)
+	}
+	defer unix.Close(rootFD)
+	fd, err := unix.Openat2(rootFD, name, &unix.OpenHow{
+		Flags:   unix.O_RDONLY | unix.O_CLOEXEC,
+		Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_MAGICLINKS,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("open sealed descriptor %s beneath mount: %w", name, err)
+	}
+	file := os.NewFile(uintptr(fd), name)
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil || !info.Mode().IsRegular() || info.Size() <= 0 || info.Size() > sealedVolumeMaxFile {
+		return nil, fmt.Errorf("sealed descriptor %s is not a bounded regular file", name)
+	}
+	data, err := io.ReadAll(io.LimitReader(file, sealedVolumeMaxFile+1))
+	if err != nil || len(data) > sealedVolumeMaxFile {
+		return nil, fmt.Errorf("read sealed descriptor %s failed", name)
+	}
+	if !strings.HasPrefix(string(data), "sealed.") {
+		return nil, fmt.Errorf("descriptor %s is not a native sealed JWS", name)
+	}
+	return data, nil
+}
+
+func (g *sealedVolumeGate) verifyAndUnseal(ctx context.Context, req *pb.CreateContainerRequest,
+	unseal func(context.Context, []byte) ([]byte, error)) (string, error) {
+	if req == nil || req.OCI == nil || req.OCI.Process == nil || req.OCI.Process.User == nil {
+		return "", errors.New("CreateContainer lacks process identity for verified secrets")
+	}
+	if !sealedContainerID.MatchString(req.ContainerId) ||
+		req.OCI.Root == nil || req.OCI.Root.Path != filepath.Join("/run/kata-containers", req.ContainerId, "rootfs") {
+		return "", errors.New("container ID does not match OCI root bundle")
+	}
+	var target *pb.Mount
+	baseName := filepath.Base(g.manifest.Destination)
+	expectedSource := regexp.MustCompile(`^` + regexp.QuoteMeta(g.sharedRoot) + `(?:/passthrough)?/(?:watchable/)?` + regexp.QuoteMeta(req.ContainerId) + `-[a-z0-9]{16}-` + regexp.QuoteMeta(baseName) + `$`)
+	for _, mount := range req.OCI.Mounts {
+		if mount.Destination == g.manifest.Destination {
+			if target != nil || mount.Type != "bind" || !expectedSource.MatchString(mount.Source) ||
+				!hasMountOption(mount.Options, "ro") || hasMountOption(mount.Options, "rw") {
+				return "", errors.New("invalid sealed-volume bind mount")
+			}
+			target = mount
+		}
+	}
+	if target == nil {
+		return "", errors.New("expected sealed-volume bind mount is absent")
+	}
+	entries, err := os.ReadDir(target.Source)
+	if err != nil {
+		return "", fmt.Errorf("read sealed-volume source: %w", err)
+	}
+	visible := make([]string, 0, len(entries))
+	for _, entry := range entries {
+		if !strings.HasPrefix(entry.Name(), "..") {
+			visible = append(visible, entry.Name())
+		}
+	}
+	if len(visible) != len(g.manifest.DescriptorSHA256) {
+		return "", errors.New("sealed-volume filenames differ from measured manifest")
+	}
+	for _, name := range visible {
+		if _, ok := g.manifest.DescriptorSHA256[name]; !ok {
+			return "", errors.New("sealed-volume contains an unexpected filename")
+		}
+	}
+	sort.Strings(visible)
+	private, err := g.privateDirectory(req.ContainerId)
+	if err != nil {
+		return "", err
+	}
+	complete := false
+	defer func() {
+		if !complete {
+			_ = os.RemoveAll(private)
+		}
+	}()
+	if err = os.Chown(private, 0, int(req.OCI.Process.User.GID)); err != nil {
+		return "", fmt.Errorf("set verified-secret directory group: %w", err)
+	}
+	for _, name := range visible {
+		var sealed []byte
+		sealed, err = readSealedDescriptor(target.Source, name)
+		if err != nil {
+			return "", err
+		}
+		digest := sha256.Sum256(sealed)
+		if hex.EncodeToString(digest[:]) != g.manifest.DescriptorSHA256[name] {
+			return "", fmt.Errorf("sealed descriptor %s differs from measured manifest", name)
+		}
+		var plaintext []byte
+		plaintext, err = unseal(ctx, sealed)
+		if err != nil || len(plaintext) == 0 || len(plaintext) > sealedVolumeMaxFile {
+			return "", fmt.Errorf("CDH failed to unseal measured descriptor %s: %v", name, err)
+		}
+		output := filepath.Join(private, name)
+		fd, openErr := unix.Open(output, unix.O_WRONLY|unix.O_CREAT|unix.O_EXCL|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0440)
+		err = openErr
+		if err != nil {
+			return "", fmt.Errorf("create private unsealed file: %w", err)
+		}
+		file := os.NewFile(uintptr(fd), output)
+		if _, err = file.Write(plaintext); err == nil {
+			err = file.Sync()
+		}
+		closeErr := file.Close()
+		if err == nil {
+			err = closeErr
+		}
+		if err != nil {
+			return "", fmt.Errorf("write private unsealed file: %w", err)
+		}
+		if err = os.Chown(output, 0, int(req.OCI.Process.User.GID)); err != nil {
+			return "", fmt.Errorf("set private unsealed file group: %w", err)
+		}
+	}
+	target.Source = private
+	complete = true
+	return private, nil
+}
+
+func hasMountOption(options []string, wanted string) bool {
+	for _, option := range options {
+		if option == wanted {
+			return true
+		}
+	}
+	return false
+}
