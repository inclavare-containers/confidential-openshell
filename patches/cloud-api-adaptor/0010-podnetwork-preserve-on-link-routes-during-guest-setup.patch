From e32c515ef83987587241170514f337c6f847958c Mon Sep 17 00:00:00 2001
From: Weidong Sun <sunweidong@linux.alibaba.com>
Date: Tue, 3 Nov 2026 17:39:18 +0800
Subject: [PATCH] podnetwork: preserve on-link routes during guest setup

A Pod route may use a gateway outside the interface's connected prefix.
Dropping RTNH_F_ONLINK while transferring the worker's network
configuration makes such a route impossible to install in the guest.

Carry the flag through route inspection, JSON serialization and guest
setup. Extend the existing worker and guest network tests to verify
flag preservation and installation of a route with an off-subnet gateway.

Fixes: #3434
Generated-by: OpenAI Codex
Signed-off-by: Weidong Sun <sunweidong@linux.alibaba.com>
---
 .../pkg/podnetwork/podnetwork_test.go         | 29 ++++++++++++++++++-
 .../pkg/podnetwork/podnode.go                 |  1 +
 .../pkg/podnetwork/tunneler/tunneler.go       |  1 +
 .../pkg/podnetwork/workernode.go              |  1 +
 4 files changed, 31 insertions(+), 1 deletion(-)

diff --git a/src/cloud-api-adaptor/pkg/podnetwork/podnetwork_test.go b/src/cloud-api-adaptor/pkg/podnetwork/podnetwork_test.go
index 580edbb8..a5fcceb4 100644
--- a/src/cloud-api-adaptor/pkg/podnetwork/podnetwork_test.go
+++ b/src/cloud-api-adaptor/pkg/podnetwork/podnetwork_test.go
@@ -4,6 +4,7 @@
 package podnetwork
 
 import (
+	"encoding/json"
 	"fmt"
 	"net/netip"
 	"os"
@@ -73,7 +74,12 @@ func TestWorkerNode(t *testing.T) {
 
 	tuntest.BridgeAdd(t, workerPodNS, "eth0")
 	tuntest.AddrAdd(t, workerPodNS, "eth0", "172.16.0.2/24")
-	tuntest.RouteAdd(t, workerPodNS, "", "172.16.0.1", "eth0")
+	require.NoError(t, workerPodNS.RouteAdd(&netops.Route{
+		Destination: netip.MustParsePrefix("0.0.0.0/0"),
+		Gateway:     netip.MustParseAddr("172.16.0.1"),
+		Device:      "eth0",
+		Onlink:      true,
+	}))
 
 	for hostInterface, expected := range map[string]struct {
 		podNodeIP    string
@@ -98,6 +104,13 @@ func TestWorkerNode(t *testing.T) {
 			config, err := workerNode.Inspect(workerPodNS.Path())
 			require.Nil(t, err, "hostInterface=%q", hostInterface)
 
+			// Route flags must survive the worker-to-guest JSON transport.
+			data, err := json.Marshal(config)
+			require.NoError(t, err)
+			var received tunneler.Config
+			require.NoError(t, json.Unmarshal(data, &received))
+			config = &received
+
 			err = workerNode.Setup(workerPodNS.Path(), []netip.Addr{netip.MustParseAddr("192.168.0.3"), netip.MustParseAddr("192.168.0.3")}, config)
 			require.Nil(t, err, "hostInterface=%q", hostInterface)
 
@@ -113,9 +126,11 @@ func TestWorkerNode(t *testing.T) {
 			require.Equal(t, dstRoute, "0.0.0.0/0", "hostInterface=%q", hostInterface)
 			require.Equal(t, config.Routes[0].GW.String(), "172.16.0.1", "hostInterface=%q", hostInterface)
 			require.Equal(t, config.Routes[0].Dev, "eth0", "hostInterface=%q", hostInterface)
+			require.True(t, config.Routes[0].Onlink, "hostInterface=%q", hostInterface)
 			require.Equal(t, config.Routes[1].Dst.String(), "172.16.0.0/24", "hostInterface=%q", hostInterface)
 			require.Equal(t, config.Routes[1].GW.IsValid(), false, "hostInterface=%q", hostInterface)
 			require.Equal(t, config.Routes[1].Dev, "eth0", "hostInterface=%q", hostInterface)
+			require.False(t, config.Routes[1].Onlink, "hostInterface=%q", hostInterface)
 
 			err = workerNode.Teardown(workerPodNS.Path(), config)
 			require.Nil(t, err, "hostInterface=%q", hostInterface)
@@ -179,6 +194,13 @@ func TestPodNode(t *testing.T) {
 							Dst: netip.MustParsePrefix("172.16.0.0/24"),
 							Dev: "eth0",
 						},
+						{
+							// This gateway is outside the interface's connected subnet.
+							Dst:    netip.MustParsePrefix("10.0.0.0/24"),
+							GW:     netip.MustParseAddr("169.254.1.1"),
+							Dev:    "eth0",
+							Onlink: true,
+						},
 					},
 					InterfaceName: "eth0",
 					MTU:           1500,
@@ -193,6 +215,11 @@ func TestPodNode(t *testing.T) {
 				err := podNode.Setup()
 				require.Nil(t, err, "hostInterface=%q", hostInterface)
 
+				routes, err := podNS.RouteList(&netops.Route{Destination: netip.MustParsePrefix("10.0.0.0/24")})
+				require.NoError(t, err)
+				require.Len(t, routes, 1)
+				require.True(t, routes[0].Onlink)
+
 				err = podNode.Teardown()
 				require.Nil(t, err, "hostInterface=%q", hostInterface)
 
diff --git a/src/cloud-api-adaptor/pkg/podnetwork/podnode.go b/src/cloud-api-adaptor/pkg/podnetwork/podnode.go
index 50c4d898..3a5a8a09 100644
--- a/src/cloud-api-adaptor/pkg/podnetwork/podnode.go
+++ b/src/cloud-api-adaptor/pkg/podnetwork/podnode.go
@@ -132,6 +132,7 @@ func (n *podNode) Setup() error {
 			Device:      route.Dev,
 			Protocol:    route.Protocol,
 			Scope:       route.Scope,
+			Onlink:      route.Onlink,
 		}
 		if err := podNS.RouteAdd(&nRoute); err != nil {
 			return fmt.Errorf("failed to add a route to %s via %s on pod network namespace %s: %w", route.Dst, route.GW, podNS.Path(), err)
diff --git a/src/cloud-api-adaptor/pkg/podnetwork/tunneler/tunneler.go b/src/cloud-api-adaptor/pkg/podnetwork/tunneler/tunneler.go
index 0a6ce5b4..7d41d04e 100644
--- a/src/cloud-api-adaptor/pkg/podnetwork/tunneler/tunneler.go
+++ b/src/cloud-api-adaptor/pkg/podnetwork/tunneler/tunneler.go
@@ -37,6 +37,7 @@ type Route struct {
 	Dev      string               `json:"dev,omitempty"`
 	Protocol netops.RouteProtocol `json:"protocol,omitempty"`
 	Scope    netops.RouteScope    `json:"scope,omitempty"`
+	Onlink   bool                 `json:"onlink,omitempty"`
 }
 
 type Neighbor struct {
diff --git a/src/cloud-api-adaptor/pkg/podnetwork/workernode.go b/src/cloud-api-adaptor/pkg/podnetwork/workernode.go
index fedebe84..198e3c77 100644
--- a/src/cloud-api-adaptor/pkg/podnetwork/workernode.go
+++ b/src/cloud-api-adaptor/pkg/podnetwork/workernode.go
@@ -286,6 +286,7 @@ func (n *workerNode) Inspect(nsPath string) (*tunneler.Config, error) {
 			GW:       route.Gateway,
 			Protocol: route.Protocol,
 			Scope:    route.Scope,
+			Onlink:   route.Onlink,
 		}
 		config.Routes = append(config.Routes, r)
 	}
