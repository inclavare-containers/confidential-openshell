From 0c39886fa05637c01d859e3b8f10fcf5f061245c Mon Sep 17 00:00:00 2001
From: Weidong Sun <sunweidong@linux.alibaba.com>
Date: Tue, 3 Nov 2026 10:08:39 +0800
Subject: [PATCH 1/1] runtime: preserve no_new_privileges in exec requests

The containerd exec path copies OCI NoNewPrivileges into types.Cmd, but
cmdToKataProcess omits it from the guest-agent process. The guest
therefore receives false even when the caller requested true, and
genpolicy can reject an otherwise approved exec or probe.

Copy the existing value into grpc.Process and extend
TestCmdToKataProcess to cover false and true. This preserves the caller
setting without changing the guest agent or policy rules.

Assisted-by: OpenAI Codex <noreply@openai.com>
---
 src/runtime/virtcontainers/kata_agent.go      | 7 ++++---
 src/runtime/virtcontainers/kata_agent_test.go | 9 ++++++++-
 2 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/src/runtime/virtcontainers/kata_agent.go b/src/runtime/virtcontainers/kata_agent.go
index b6408fe5c90af00b895e277464a3a9077c196ae4..651172bc34fc5d7e377ddc58f904c443aad917d9 100644
--- a/src/runtime/virtcontainers/kata_agent.go
+++ b/src/runtime/virtcontainers/kata_agent.go
@@ -565,9 +565,10 @@ func cmdToKataProcess(cmd types.Cmd) (process *grpc.Process, err error) {
 			GID:            gid,
 			AdditionalGids: extraGids,
 		},
-		Args: cmd.Args,
-		Env:  cmdEnvsToStringSlice(cmd.Envs),
-		Cwd:  cmd.WorkDir,
+		Args:            cmd.Args,
+		Env:             cmdEnvsToStringSlice(cmd.Envs),
+		Cwd:             cmd.WorkDir,
+		NoNewPrivileges: cmd.NoNewPrivileges,
 	}
 
 	return process, nil
diff --git a/src/runtime/virtcontainers/kata_agent_test.go b/src/runtime/virtcontainers/kata_agent_test.go
index b80f8ac63a4b54ea91401333f56082050ada7fe1..d40c684d9834c59cb17f333ccde4633644063d47 100644
--- a/src/runtime/virtcontainers/kata_agent_test.go
+++ b/src/runtime/virtcontainers/kata_agent_test.go
@@ -857,8 +857,15 @@ func TestCmdToKataProcess(t *testing.T) {
 		User:         "1000",
 		PrimaryGroup: "1000",
 	}
-	_, err := cmdToKataProcess(cmd)
+	process, err := cmdToKataProcess(cmd)
 	assert.Nil(err)
+	assert.False(process.NoNewPrivileges)
+
+	restricted := cmd
+	restricted.NoNewPrivileges = true
+	process, err = cmdToKataProcess(restricted)
+	assert.Nil(err)
+	assert.True(process.NoNewPrivileges)
 
 	cmd1 := cmd
 	cmd1.User = "foobar"
