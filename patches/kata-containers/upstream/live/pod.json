{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "kata-nnp-probe",
    "namespace": "default"
  },
  "spec": {
    "runtimeClassName": "kata-nnp",
    "hostNetwork": true,
    "containers": [
      {
        "name": "probe",
        "image": "quay.io/prometheus/busybox@sha256:d0a5844b58b7745187851254c7bbe9d73d8493757909ba9219978bb18d0fa7a1",
        "command": [
          "/bin/sleep",
          "3600"
        ],
        "securityContext": {
          "runAsUser": 10001,
          "runAsGroup": 10001,
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        },
        "readinessProbe": {
          "exec": {
            "command": [
              "/bin/sh",
              "-c",
              "grep '^NoNewPrivs:' /proc/self/status"
            ]
          }
        },
        "livenessProbe": {
          "exec": {
            "command": [
              "/bin/true"
            ]
          }
        }
      }
    ],
    "securityContext": {
      "supplementalGroups": [
        0
      ]
    }
  }
}
