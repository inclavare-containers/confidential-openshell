{
  "metadata": {
    "name": "probe",
    "attempt": 0
  },
  "image": {
    "image": "quay.io/prometheus/busybox@sha256:d0a5844b58b7745187851254c7bbe9d73d8493757909ba9219978bb18d0fa7a1"
  },
  "command": [
    "/bin/sleep",
    "3600"
  ],
  "log_path": "probe/0.log",
  "linux": {
    "security_context": {
      "run_as_user": {
        "value": 10001
      },
      "run_as_group": {
        "value": 10001
      },
      "no_new_privs": true,
      "capabilities": {
        "drop_capabilities": [
          "ALL"
        ]
      },
      "namespace_options": {
        "pid": 1
      },
      "supplemental_groups": [
        0
      ],
      "masked_paths": [
        "/proc/acpi",
        "/proc/kcore",
        "/proc/keys",
        "/proc/latency_stats",
        "/proc/timer_list",
        "/proc/timer_stats",
        "/proc/sched_debug",
        "/proc/scsi",
        "/sys/firmware"
      ],
      "readonly_paths": [
        "/proc/asound",
        "/proc/bus",
        "/proc/fs",
        "/proc/irq",
        "/proc/sys",
        "/proc/sysrq-trigger"
      ]
    }
  }
}
