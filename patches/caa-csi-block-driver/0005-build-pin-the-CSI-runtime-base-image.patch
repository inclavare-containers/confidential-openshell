From fe6ebf85e07c2a234f83fe337cdc21ead9551978 Mon Sep 17 00:00:00 2001
From: Weidong Sun <sunweidong@linux.alibaba.com>
Date: Wed, 26 Aug 2026 12:06:11 +0800
Subject: [PATCH 5/5] build: pin the CSI runtime base image

Use an immutable digest for the runtime base image so published driver binaries do not silently inherit a different userspace from a mutable tag.

Signed-off-by: Weidong Sun <sunweidong@linux.alibaba.com>
---
 Dockerfile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Dockerfile b/Dockerfile
index 4386e9e75a368000ca004a677d5852c5430500f7..6d1f5482c3722461a1bd2b6230b6e66ec6aaf35e 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,4 +1,4 @@
-FROM alpine:3.19
+FROM alpine:3.19@sha256:b58899f069c47216f6002a6850143dc6fae0d35eb8b0df9300bbe6327b9c2171
 RUN apk add --no-cache e2fsprogs e2fsprogs-extra blkid
 COPY bin/caa-csi-block-driver /caa-csi-block-driver
 ENTRYPOINT ["/caa-csi-block-driver"]
-- 
2.43.7

