@@ -0,0 +1,95 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package driver
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	_ "github.com/confidential-devhub/caa-csi-block-driver/pkg/provider/libvirt"
+	"github.com/container-storage-interface/spec/lib/go/csi"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+func TestNodeModeNeedsNoControllerState(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "unusable-store")
+	if err := os.WriteFile(path, []byte("file"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg := Config{DriverName: "test", VendorVersion: "test", NodeID: "node", Component: "node", VolumeStoreDir: path}
+	node, err := NewDriver(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if node.store != nil {
+		t.Fatal("node initialized controller state")
+	}
+	server := grpc.NewServer()
+	node.registerServices(server)
+	services := server.GetServiceInfo()
+	if _, found := services["csi.v1.Controller"]; found {
+		t.Fatal("node serves controller RPCs")
+	}
+	if _, found := services["csi.v1.Node"]; !found {
+		t.Fatal("node RPCs missing")
+	}
+	cfg.Component = "controller"
+	if _, err := NewDriver(cfg); err == nil {
+		t.Fatal("controller accepted an unusable volume store directory")
+	}
+}
+
+func TestNodeStageUsesOnlyControllerIdentity(t *testing.T) {
+	node := newNodeServer("node")
+	req := &csi.NodeStageVolumeRequest{
+		VolumeId: "volume", StagingTargetPath: filepath.Join(t.TempDir(), "stage"),
+		VolumeCapability: &csi.VolumeCapability{AccessType: &csi.VolumeCapability_Mount{Mount: &csi.VolumeCapability_MountVolume{}}},
+		VolumeContext:    map[string]string{"cloud-volume-path": "disk", "cloudProvider": "not-a-registered-provider"},
+	}
+	if _, err := node.NodeStageVolume(t.Context(), req); err != nil {
+		t.Fatal(err)
+	}
+	req.VolumeContext["cloud-volume-path"] = "replacement"
+	if _, err := node.NodeStageVolume(t.Context(), req); status.Code(err) != codes.FailedPrecondition {
+		t.Fatalf("got %v", err)
+	}
+	delete(req.VolumeContext, "cloud-volume-path")
+	if _, err := node.NodeStageVolume(t.Context(), req); status.Code(err) != codes.FailedPrecondition {
+		t.Fatalf("got %v", err)
+	}
+}
+
+func TestControllerReplayKeepsNodeDeviceIdentity(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(dir, "pool"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("CSI_VOLUME_STORE_DIR", filepath.Join(dir, "records"))
+	request := &csi.CreateVolumeRequest{
+		Name:       "pvc-workspace",
+		Parameters: map[string]string{"cloudProvider": "libvirt", "cloudProviderVolumePath": filepath.Join(dir, "pool")},
+		VolumeCapabilities: []*csi.VolumeCapability{{
+			AccessType: &csi.VolumeCapability_Mount{Mount: &csi.VolumeCapability_MountVolume{}},
+			AccessMode: &csi.VolumeCapability_AccessMode{Mode: csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER},
+		}},
+	}
+	first, err := newControllerServer(newVolumeStore()).CreateVolume(t.Context(), request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	replayed, err := newControllerServer(newVolumeStore()).CreateVolume(t.Context(), request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := first.Volume.VolumeContext["cloud-volume-path"]
+	if path == "" || replayed.Volume.VolumeContext["cloud-volume-path"] != path {
+		t.Fatalf("replayed volume lost node device identity: %v", replayed.Volume.VolumeContext)
+	}
+	if _, err := os.Stat(path); err != nil {
+		t.Fatal(err)
