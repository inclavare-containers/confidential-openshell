diff --git a/pkg/provider/interface.go b/pkg/provider/interface.go
index 4394d091..4191f28a 100644
--- a/pkg/provider/interface.go
+++ b/pkg/provider/interface.go
@@ -3,7 +3,13 @@
 
 package provider
 
-import "context"
+import (
+	"context"
+	"errors"
+)
+
+// ErrCapacityOutOfRange reports a size range that cannot be provisioned.
+var ErrCapacityOutOfRange = errors.New("unsupported capacity range")
 
 // VolumeInfo holds provider-agnostic metadata about a block volume.
 type VolumeInfo struct {
@@ -18,9 +24,9 @@ type VolumeInfo struct {
 // All mutating methods must be idempotent: repeated calls with the same
 // arguments should produce the same result without side effects.
 type BlockVolumeProvider interface {
-	// CreateVolume provisions a new block volume of the given size.
+	// CreateVolume provisions at least sizeBytes without exceeding a nonzero limitBytes.
 	// Returns existing volume info if the volume already exists (idempotent).
-	CreateVolume(ctx context.Context, volumeID string, sizeBytes int64) (*VolumeInfo, error)
+	CreateVolume(ctx context.Context, volumeID string, sizeBytes, limitBytes int64) (*VolumeInfo, error)
 	// DeleteVolume removes a block volume.
 	// Returns nil if the volume does not exist (idempotent).
 	DeleteVolume(ctx context.Context, volumeID string) error
