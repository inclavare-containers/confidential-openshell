diff --git a/pkg/driver/directvolume.go b/pkg/driver/directvolume.go
new file mode 100644
index 00000000..4289511b
--- /dev/null
+++ b/pkg/driver/directvolume.go
@@ -0,0 +1,122 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package driver
+
+import (
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// mountInfoJSON carries the upstream fields plus CSI access and group options.
+type mountInfoJSON struct {
+	VolumeType string            `json:"volume-type"`
+	Device     string            `json:"device"`
+	FsType     string            `json:"fstype"`
+	ReadOnly   bool              `json:"readonly"`
+	Options    []string          `json:"options,omitempty"`
+	FSGroup    string            `json:"fs-group,omitempty"`
+	Metadata   map[string]string `json:"metadata,omitempty"`
+}
+
+func normalizeFilesystemType(fsType string) (string, error) {
+	fsType = strings.ToLower(strings.TrimSpace(fsType))
+	if fsType == "" {
+		fsType = "ext4"
+	}
+	switch fsType {
+	case "ext4", "ext3", "xfs":
+		return fsType, nil
+	default:
+		return "", fmt.Errorf("filesystem type %q is not supported", fsType)
+	}
+}
+
+func normalizeFSGroup(fsGroup string) (string, error) {
+	fsGroup = strings.TrimSpace(fsGroup)
+	if fsGroup == "" {
+		return "", nil
+	}
+	value, err := strconv.ParseUint(fsGroup, 10, 32)
+	if err != nil || strconv.FormatUint(value, 10) != fsGroup {
+		return "", fmt.Errorf("invalid volume mount group %q", fsGroup)
+	}
+	return fsGroup, nil
+}
+
+func normalizeMountOptions(flags []string, readOnly bool) ([]string, bool, error) {
+	allowed := map[string]bool{
+		"async": true, "atime": true, "defaults": true, "diratime": true,
+		"dev": true, "dirsync": true, "discard": true, "exec": true,
+		"lazytime": true, "noatime": true, "nodev": true, "nodiratime": true,
+		"noexec": true, "nosuid": true,
+		"relatime": true, "ro": true, "rw": true, "strictatime": true,
+		"suid": true, "sync": true,
+	}
+	conflictGroup := map[string]string{
+		"ro": "access", "rw": "access",
+		"sync": "io", "async": "io",
+		"atime": "atime", "noatime": "atime", "relatime": "atime", "strictatime": "atime",
+		"diratime": "diratime", "nodiratime": "diratime",
+		"exec": "exec", "noexec": "exec",
+		"dev": "dev", "nodev": "dev",
+		"suid": "suid", "nosuid": "suid",
+	}
+	seen := make(map[string]struct{}, len(flags)+1)
+	selected := make(map[string]string)
+	options := make([]string, 0, len(flags)+1)
+	for _, raw := range flags {
+		option := strings.TrimSpace(strings.ToLower(raw))
+		if option == "" {
+			continue
+		}
+		if strings.ContainsAny(option, " ,\t\r\n") || !allowed[option] {
+			return nil, false, fmt.Errorf("mount option %q is not allowed", raw)
+		}
+		if group := conflictGroup[option]; group != "" {
+			if previous := selected[group]; previous != "" && previous != option {
+				return nil, false, fmt.Errorf("mount options %q and %q conflict", previous, option)
+			}
+			selected[group] = option
+		}
+		if option == "ro" {
+			readOnly = true
+		}
+		if _, ok := seen[option]; ok {
+			continue
+		}
+		seen[option] = struct{}{}
+		options = append(options, option)
+	}
+	if readOnly {
+		if _, ok := seen["rw"]; ok {
+			return nil, false, fmt.Errorf("readonly volume conflicts with mount option %q", "rw")
+		}
+		if _, ok := seen["ro"]; !ok {
+			options = append(options, "ro")
+		}
+	}
+	sort.Strings(options)
+	return options, readOnly, nil
+}
+
+// directVolumeMetadataContext is the only provider metadata exposed across
+// the host/guest boundary. Controller parameters remain in the durable record
+// for idempotency and provider reconstruction, but are not copied wholesale
+// into mountInfo.json.
+func directVolumeMetadataContext(values map[string]string) map[string]string {
+	result := make(map[string]string, 4)
+	for _, key := range []string{
+		"cloud-provider", "cloud-volume-path", "cloud-volume-id",
+		// Preserve the existing upstream CDH contract. These are key
+		// references, never key material.
+		"encrypt-type", "kbs-key-id",
+	} {
+		if value := strings.TrimSpace(values[key]); value != "" {
+			result[key] = value
+		}
+	}
+	return result
+}
diff --git a/pkg/driver/mount_properties_test.go b/pkg/driver/mount_properties_test.go
new file mode 100644
index 00000000..b4882750
--- /dev/null
+++ b/pkg/driver/mount_properties_test.go
@@ -0,0 +1,136 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package driver
+
+import (
+	b64 "encoding/base64"
+	"encoding/json"
+	"github.com/container-storage-interface/spec/lib/go/csi"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func readPublishedMountInfo(path string) (*mountInfoJSON, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	var metadata mountInfoJSON
+	if err := json.Unmarshal(data, &metadata); err != nil {
+		return nil, err
+	}
+	return &metadata, nil
+}
+func publishRequest(target string, mode csi.VolumeCapability_AccessMode_Mode, readonly bool, flags ...string) *csi.NodePublishVolumeRequest {
+	return &csi.NodePublishVolumeRequest{
+		VolumeId:   "pvc-workspace",
+		TargetPath: target,
+		Readonly:   readonly,
+		VolumeContext: map[string]string{
+			"cloudProvider":              "testcloud",
+			"cloud-volume-path":          "cloud-disk-123",
+			"csi.storage.k8s.io/pod.uid": "pod-uid-123",
+			"cloudAccessKeySecret":       "must-not-leak",
+			"cloudSecurityToken":         "must-not-leak",
+			"custom-workload-context":    "must-not-cross-boundary",
+			"encrypt-type":               "luks2",
+			"kbs-key-id":                 "default/luks-key/workspace",
+		},
+		VolumeCapability: &csi.VolumeCapability{
+			AccessType: &csi.VolumeCapability_Mount{Mount: &csi.VolumeCapability_MountVolume{
+				FsType:           "ext4",
+				MountFlags:       flags,
+				VolumeMountGroup: "2000",
+			}},
+			AccessMode: &csi.VolumeCapability_AccessMode{Mode: mode},
+		},
+	}
+}
+
+func setupPublishedNode(t *testing.T) (*nodeServer, string, string) {
+	t.Helper()
+	root := t.TempDir()
+	t.Setenv("KATA_DIRECT_VOLUME_ROOT_PATH", root)
+	kubeletRoot := t.TempDir()
+	t.Setenv("KUBELET_ROOT_PATH", kubeletRoot)
+	target := filepath.Join(kubeletRoot, "pods", "pod-uid-123", "volumes", "kubernetes.io~csi", "pvc-workspace", "mount")
+	node := newNodeServer("node-1")
+	node.devices["pvc-workspace"] = "cloud-disk-123"
+	metadataPath := filepath.Join(root, b64.URLEncoding.EncodeToString([]byte(target)), mountInfoFileName)
+	return node, target, metadataPath
+}
+
+func TestNodePublishVolumeRejectsConflictingMountOptions(t *testing.T) {
+	for _, flags := range [][]string{
+		{"ro", "rw"}, {"sync", "async"}, {"atime", "noatime"},
+		{"diratime", "nodiratime"}, {"exec", "noexec"},
+		{"dev", "nodev"}, {"suid", "nosuid"},
+	} {
+		node, target, _ := setupPublishedNode(t)
+		_, err := node.NodePublishVolume(t.Context(), publishRequest(target, csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER, false, flags...))
+		if status.Code(err) != codes.InvalidArgument {
+			t.Fatalf("flags %v got %v, want InvalidArgument", flags, err)
+		}
+	}
+}
+
+func TestNodePublishVolumeReadOnlyContract(t *testing.T) {
+	tests := []struct {
+		name     string
+		mode     csi.VolumeCapability_AccessMode_Mode
+		readonly bool
+		flags    []string
+	}{
+		{name: "explicit readonly", mode: csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER, readonly: true},
+		{name: "reader-only access mode", mode: csi.VolumeCapability_AccessMode_SINGLE_NODE_READER_ONLY},
+		{name: "multi-node reader-only access mode", mode: csi.VolumeCapability_AccessMode_MULTI_NODE_READER_ONLY},
+		{name: "ro mount flag", mode: csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER, flags: []string{"noatime", "ro"}},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			node, target, metadataPath := setupPublishedNode(t)
+			if _, err := node.NodePublishVolume(t.Context(), publishRequest(target, test.mode, test.readonly, test.flags...)); err != nil {
+				t.Fatal(err)
+			}
+			metadata, err := readPublishedMountInfo(metadataPath)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !metadata.ReadOnly || metadata.FSGroup != "2000" {
+				t.Fatalf("unexpected metadata: %#v", metadata)
+			}
+			if !containsOption(metadata.Options, "ro") || containsOption(metadata.Options, "rw") {
+				t.Fatalf("readonly options not normalized: %v", metadata.Options)
+			}
+			if _, ok := metadata.Metadata["cloudAccessKeySecret"]; ok {
+				t.Fatal("access key secret leaked into direct-volume metadata")
+			}
+			if _, ok := metadata.Metadata["cloudSecurityToken"]; ok {
+				t.Fatal("security token leaked into direct-volume metadata")
+			}
+			if _, ok := metadata.Metadata["custom-workload-context"]; ok {
+				t.Fatal("unconsumed volume context crossed into direct-volume metadata")
+			}
+			if metadata.Metadata["cloud-provider"] != "testcloud" ||
+				metadata.Metadata["cloud-volume-path"] != "cloud-disk-123" ||
+				metadata.Metadata["encrypt-type"] != "luks2" ||
+				metadata.Metadata["kbs-key-id"] != "default/luks-key/workspace" ||
+				len(metadata.Metadata) != 5 {
+				t.Fatalf("unexpected direct-volume metadata projection: %v", metadata.Metadata)
+			}
+		})
+	}
+}
+
+func containsOption(options []string, wanted string) bool {
+	for _, option := range options {
+		if option == wanted {
+			return true
+		}
+	}
+	return false
+}
