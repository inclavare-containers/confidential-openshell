diff --git a/pkg/driver/directvolume.go b/pkg/driver/directvolume.go
new file mode 100644
index 00000000..2bece324
--- /dev/null
+++ b/pkg/driver/directvolume.go
@@ -0,0 +1,79 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package driver
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// mountInfoJSON carries the upstream fields plus CSI access and group options.
+type mountInfoJSON struct {
+	VolumeType string            `json:"volume-type"`
+	Device     string            `json:"device"`
+	FsType     string            `json:"fstype"`
+	ReadOnly   bool              `json:"readonly"`
+	Options    []string          `json:"options,omitempty"`
+	FSGroup    string            `json:"fs-group,omitempty"`
+	Metadata   map[string]string `json:"metadata,omitempty"`
+}
+
+func normalizeFilesystemType(fsType string) (string, error) {
+	fsType = strings.ToLower(strings.TrimSpace(fsType))
+	if fsType == "" {
+		fsType = "ext4"
+	}
+	switch fsType {
+	case "ext4", "ext3", "xfs":
+		return fsType, nil
+	default:
+		return "", fmt.Errorf("filesystem type %q is not supported", fsType)
+	}
+}
+
+func normalizeFSGroup(fsGroup string) (string, error) {
+	fsGroup = strings.TrimSpace(fsGroup)
+	if fsGroup == "" {
+		return "", nil
+	}
+	value, err := strconv.ParseUint(fsGroup, 10, 32)
+	if err != nil {
+		return "", fmt.Errorf("invalid volume mount group %q", fsGroup)
+	}
+	return strconv.FormatUint(value, 10), nil
+}
+
+// normalizeMountOptions keeps filesystem-specific options and their
+// order intact. Access flags must agree; operation flags cannot replace the
+// requested device/filesystem mount with a bind, remount or propagation change.
+func normalizeMountOptions(values []string, readOnly bool) ([]string, bool, error) {
+	options := make([]string, 0, len(values)+1)
+	hasRO, hasRW := false, false
+	for _, value := range values {
+		for _, item := range strings.Split(value, ",") {
+			option := strings.TrimSpace(item)
+			if option == "" {
+				continue
+			}
+			switch option {
+			case "bind", "rbind", "remount", "move", "shared", "rshared", "slave", "rslave", "private", "rprivate", "unbindable", "runbindable":
+				return nil, false, fmt.Errorf("mount operation %q is not a filesystem option", option)
+			case "ro":
+				hasRO = true
+			case "rw":
+				hasRW = true
+			}
+			options = append(options, option)
+		}
+	}
+	readOnly = readOnly || hasRO
+	if readOnly && hasRW {
+		return nil, false, fmt.Errorf("readonly volume conflicts with mount option \"rw\"")
+	}
+	if readOnly && !hasRO {
+		options = append(options, "ro")
+	}
+	return options, readOnly, nil
+}
diff --git a/pkg/driver/mount_properties_test.go b/pkg/driver/mount_properties_test.go
new file mode 100644
index 00000000..ca3c939c
--- /dev/null
+++ b/pkg/driver/mount_properties_test.go
@@ -0,0 +1,164 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package driver
+
+import (
+	b64 "encoding/base64"
+	"encoding/json"
+	"github.com/container-storage-interface/spec/lib/go/csi"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+)
+
+func readPublishedMountInfo(path string) (*mountInfoJSON, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	var metadata mountInfoJSON
+	if err := json.Unmarshal(data, &metadata); err != nil {
+		return nil, err
+	}
+	return &metadata, nil
+}
+func publishRequest(target string, mode csi.VolumeCapability_AccessMode_Mode, readonly bool, flags ...string) *csi.NodePublishVolumeRequest {
+	return &csi.NodePublishVolumeRequest{
+		VolumeId:   "pvc-workspace",
+		TargetPath: target,
+		Readonly:   readonly,
+		VolumeContext: map[string]string{
+			"cloudProvider":              "testcloud",
+			"cloud-volume-path":          "cloud-disk-123",
+			"csi.storage.k8s.io/pod.uid": "pod-uid-123",
+			"custom-workload-context":    "keep-me",
+			"encrypt-type":               "luks2",
+			"kbs-key-id":                 "default/luks-key/workspace",
+		},
+		VolumeCapability: &csi.VolumeCapability{
+			AccessType: &csi.VolumeCapability_Mount{Mount: &csi.VolumeCapability_MountVolume{
+				FsType:           "ext4",
+				MountFlags:       flags,
+				VolumeMountGroup: "2000",
+			}},
+			AccessMode: &csi.VolumeCapability_AccessMode{Mode: mode},
+		},
+	}
+}
+
+func setupPublishedNode(t *testing.T) (*nodeServer, string, string) {
+	t.Helper()
+	root := t.TempDir()
+	t.Setenv("KATA_DIRECT_VOLUME_ROOT_PATH", root)
+	kubeletRoot := t.TempDir()
+	t.Setenv("KUBELET_ROOT_PATH", kubeletRoot)
+	target := filepath.Join(kubeletRoot, "pods", "pod-uid-123", "volumes", "kubernetes.io~csi", "pvc-workspace", "mount")
+	node := newNodeServer("node-1")
+	node.devices["pvc-workspace"] = "cloud-disk-123"
+	metadataPath := filepath.Join(root, b64.URLEncoding.EncodeToString([]byte(target)), mountInfoFileName)
+	return node, target, metadataPath
+}
+
+func TestNodePublishVolumeRejectsConflictingMountOptions(t *testing.T) {
+	for _, flags := range [][]string{
+		{"ro", "rw"}, {"ro,rw"}, {"bind"}, {"remount"},
+	} {
+		node, target, _ := setupPublishedNode(t)
+		_, err := node.NodePublishVolume(t.Context(), publishRequest(target, csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER, false, flags...))
+		if status.Code(err) != codes.InvalidArgument {
+			t.Fatalf("flags %v got %v, want InvalidArgument", flags, err)
+		}
+	}
+}
+
+func TestNodePublishVolumeReadOnlyContract(t *testing.T) {
+	tests := []struct {
+		name     string
+		mode     csi.VolumeCapability_AccessMode_Mode
+		readonly bool
+		flags    []string
+	}{
+		{name: "explicit readonly", mode: csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER, readonly: true},
+		{name: "reader-only access mode", mode: csi.VolumeCapability_AccessMode_SINGLE_NODE_READER_ONLY},
+		{name: "multi-node reader-only access mode", mode: csi.VolumeCapability_AccessMode_MULTI_NODE_READER_ONLY},
+		{name: "ro mount flag", mode: csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER, flags: []string{"noatime", "ro"}},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			node, target, metadataPath := setupPublishedNode(t)
+			req := publishRequest(target, test.mode, test.readonly, test.flags...)
+			original := make(map[string]string, len(req.VolumeContext))
+			for key, value := range req.VolumeContext {
+				original[key] = value
+			}
+			if _, err := node.NodePublishVolume(t.Context(), req); err != nil {
+				t.Fatal(err)
+			}
+			metadata, err := readPublishedMountInfo(metadataPath)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !metadata.ReadOnly || metadata.FSGroup != "2000" {
+				t.Fatalf("unexpected metadata: %#v", metadata)
+			}
+			if !containsOption(metadata.Options, "ro") || containsOption(metadata.Options, "rw") {
+				t.Fatalf("readonly options not normalized: %v", metadata.Options)
+			}
+			for key, value := range original {
+				if metadata.Metadata[key] != value {
+					t.Fatalf("volume context %q was not preserved", key)
+				}
+			}
+			if !reflect.DeepEqual(req.VolumeContext, original) {
+				t.Fatal("publication modified the request context")
+			}
+			if metadata.Metadata["cloud-provider"] != "testcloud" || metadata.Metadata["cloud-volume-id"] != "pvc-workspace" {
+				t.Fatalf("missing cloud identity: %v", metadata.Metadata)
+			}
+		})
+	}
+}
+
+func containsOption(options []string, wanted string) bool {
+	for _, option := range options {
+		if option == wanted {
+			return true
+		}
+	}
+	return false
+}
+
+func TestNodePublishVolumePreservesFilesystemOptions(t *testing.T) {
+	node, target, metadataPath := setupPublishedNode(t)
+	flags := []string{"commit=30", "nouuid", "context=CaseSensitive", "sync", "async"}
+	if _, err := node.NodePublishVolume(t.Context(), publishRequest(target, csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER, false, flags...)); err != nil {
+		t.Fatal(err)
+	}
+	metadata, err := readPublishedMountInfo(metadataPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(metadata.Options, flags) {
+		t.Fatalf("flags changed: %v", metadata.Options)
+	}
+}
+
+func TestNodePublishVolumeNormalizesMountGroup(t *testing.T) {
+	node, target, path := setupPublishedNode(t)
+	req := publishRequest(target, csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER, false)
+	req.VolumeCapability.GetMount().VolumeMountGroup = "02000"
+	if _, err := node.NodePublishVolume(t.Context(), req); err != nil {
+		t.Fatal(err)
+	}
+	metadata, err := readPublishedMountInfo(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if metadata.FSGroup != "2000" {
+		t.Fatalf("group=%q", metadata.FSGroup)
+	}
+}
diff --git a/pkg/driver/nodeserver.go b/pkg/driver/nodeserver.go
index 0cb45e43..37a6cca4 100644
--- a/pkg/driver/nodeserver.go
+++ b/pkg/driver/nodeserver.go
@@ -47,14 +47,6 @@ func getKataRuntimePath() string {
 	return "kata-runtime"
 }
 
-type mountInfoJSON struct {
-	VolumeType string            `json:"volume-type"`
-	Device     string            `json:"device"`
-	FsType     string            `json:"fstype"`
-	Metadata   map[string]string `json:"metadata,omitempty"`
-	Options    []string          `json:"options,omitempty"`
-}
-
 type nodeServer struct {
 	csi.UnimplementedNodeServer
 	nodeID  string
@@ -192,20 +184,48 @@ func (ns *nodeServer) NodePublishVolume(_ context.Context, req *csi.NodePublishV
 		return nil, status.Errorf(codes.FailedPrecondition, "volume %s not staged (no device path)", volumeID)
 	}
 
-	attrib := req.GetVolumeContext()
-	if attrib == nil {
-		attrib = make(map[string]string)
+	attrib := make(map[string]string, len(req.GetVolumeContext())+1)
+	for key, value := range req.GetVolumeContext() {
+		attrib[key] = value
 	}
-
+	attrib["cloud-volume-path"] = devicePath
 	attrib["cloud-volume-id"] = volumeID
-	if attrib["cloud-volume-path"] == "" {
-		attrib["cloud-volume-path"] = devicePath
+	providerName := strings.TrimSpace(attrib["cloud-provider"])
+	if providerName == "" {
+		providerName = strings.TrimSpace(attrib["cloudProvider"])
+	}
+	if providerName != "" {
+		attrib["cloud-provider"] = providerName
+	}
+
+	mount := req.GetVolumeCapability().GetMount()
+	if mount == nil {
+		return nil, status.Error(codes.InvalidArgument, "raw block volumes are not supported")
+	}
+	mode := req.GetVolumeCapability().GetAccessMode().GetMode()
+	readerOnly := mode == csi.VolumeCapability_AccessMode_SINGLE_NODE_READER_ONLY ||
+		mode == csi.VolumeCapability_AccessMode_MULTI_NODE_READER_ONLY
+	readOnly := req.GetReadonly() || readerOnly
+	options, readOnly, err := normalizeMountOptions(mount.GetMountFlags(), readOnly)
+	if err != nil {
+		return nil, status.Errorf(codes.InvalidArgument, "invalid mount flags: %v", err)
+	}
+	fsType, err := normalizeFilesystemType(mount.GetFsType())
+	if err != nil {
+		return nil, status.Error(codes.InvalidArgument, err.Error())
+	}
+	fsGroup, err := normalizeFSGroup(mount.GetVolumeMountGroup())
+	if err != nil {
+		return nil, status.Error(codes.InvalidArgument, err.Error())
 	}
 
 	info := mountInfoJSON{
 		VolumeType: "directvol",
 		Device:     devicePath,
-		FsType:     "ext4",
+		FsType:     fsType,
+		ReadOnly:   readOnly,
+		Options:    options,
+		FSGroup:    fsGroup,
 		Metadata:   attrib,
 	}
 
@@ -471,6 +491,13 @@ func (ns *nodeServer) NodeGetCapabilities(_ context.Context, _ *csi.NodeGetCapab
 					},
 				},
 			},
+			{
+				Type: &csi.NodeServiceCapability_Rpc{
+					Rpc: &csi.NodeServiceCapability_RPC{
+						Type: csi.NodeServiceCapability_RPC_VOLUME_MOUNT_GROUP,
+					},
+				},
+			},
 		},
 	}, nil
 }
