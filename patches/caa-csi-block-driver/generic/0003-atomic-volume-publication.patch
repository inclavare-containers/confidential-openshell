index 2bece324..c8a039c7 100644
--- a/pkg/driver/directvolume.go
+++ b/pkg/driver/directvolume.go
@@ -4,20 +4,27 @@
 package driver
 
 import (
+	"bytes"
+	"encoding/json"
+	"errors"
 	"fmt"
+	"os"
+	"sort"
 	"strconv"
 	"strings"
 )
 
-// mountInfoJSON carries the upstream fields plus CSI access and group options.
+// mountInfoJSON extends the upstream mountInfo fields with the requested
+// access mode and group. Version labels are not required to read older records.
 type mountInfoJSON struct {
-	VolumeType string            `json:"volume-type"`
-	Device     string            `json:"device"`
-	FsType     string            `json:"fstype"`
-	ReadOnly   bool              `json:"readonly"`
-	Options    []string          `json:"options,omitempty"`
-	FSGroup    string            `json:"fs-group,omitempty"`
-	Metadata   map[string]string `json:"metadata,omitempty"`
+	VolumeType   string            `json:"volume-type"`
+	Device       string            `json:"device"`
+	FsType       string            `json:"fstype"`
+	ReadOnly     bool              `json:"readonly"`
+	Options      []string          `json:"options,omitempty"`
+	FSGroup      string            `json:"fs-group,omitempty"`
+	VolumeHandle string            `json:"volume-handle"`
+	Metadata     map[string]string `json:"metadata,omitempty"`
 }
 
 func normalizeFilesystemType(fsType string) (string, error) {
@@ -77,3 +84,71 @@ func normalizeMountOptions(values []string, readOnly bool) ([]string, bool, erro
 	}
 	return options, readOnly, nil
 }
+
+func readDirectVolumeMetadata(path string) (*mountInfoJSON, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	var metadata mountInfoJSON
+	if err := json.Unmarshal(data, &metadata); err != nil {
+		return nil, err
+	}
+	if metadata.Device == "" {
+		return nil, errors.New("direct-volume record lacks device identity")
+	}
+	if metadata.VolumeHandle == "" {
+		metadata.VolumeHandle = metadata.Metadata["cloud-volume-id"]
+	}
+	// The original writer omitted readonly. Mount flags still express access.
+	for _, option := range metadata.Options {
+		metadata.ReadOnly = metadata.ReadOnly || option == "ro"
+	}
+	return &metadata, nil
+}
+
+func directVolumeMetadataEqual(left, right mountInfoJSON) bool {
+	// Compare mount semantics and ownership, not transport labels or unused
+	// controller parameters from older writer versions.
+	left.VolumeType, right.VolumeType = "", ""
+	left.Metadata = map[string]string{"encrypt-type": left.Metadata["encrypt-type"], "kbs-key-id": left.Metadata["kbs-key-id"]}
+	right.Metadata = map[string]string{"encrypt-type": right.Metadata["encrypt-type"], "kbs-key-id": right.Metadata["kbs-key-id"]}
+	// Old writers sorted flags. Compare final option values while keeping
+	// the original order in records passed to the guest mount operation.
+	canonicalOptions := func(options []string) []string {
+		final := make(map[string]string)
+		groups := map[string]string{
+			"ro": "access", "rw": "access", "sync": "io", "async": "io",
+			"atime": "atime", "noatime": "atime", "relatime": "atime", "strictatime": "atime",
+			"diratime": "diratime", "nodiratime": "diratime",
+			"exec": "exec", "noexec": "exec", "dev": "dev", "nodev": "dev", "suid": "suid", "nosuid": "suid",
+		}
+		for _, option := range options {
+			key := strings.SplitN(option, "=", 2)[0]
+			if group, ok := groups[key]; ok {
+				key = group
+			}
+			final[key] = option
+		}
+		result := make([]string, 0, len(final))
+		for _, option := range final {
+			result = append(result, option)
+		}
+		sort.Strings(result)
+		return result
+	}
+	left.Options, right.Options = canonicalOptions(left.Options), canonicalOptions(right.Options)
+	leftJSON, leftErr := json.Marshal(left)
+	rightJSON, rightErr := json.Marshal(right)
+	return leftErr == nil && rightErr == nil && bytes.Equal(leftJSON, rightJSON)
+}
+
+func writeDirectVolumeMetadataAtomic(path string, metadata mountInfoJSON) error {
+	data, err := json.Marshal(metadata)
+	if err != nil {
+		return fmt.Errorf("marshal direct-volume metadata: %w", err)
+	}
+	data = append(data, '\n')
+
+	return writeMountInfoAtomic(path, data)
+}
