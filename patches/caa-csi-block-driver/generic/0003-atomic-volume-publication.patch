diff --git a/pkg/driver/metadata_atomic.go b/pkg/driver/metadata_atomic.go
new file mode 100644
index 00000000..8c2da75f
--- /dev/null
+++ b/pkg/driver/metadata_atomic.go
@@ -0,0 +1,48 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package driver
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+func writeMountInfoAtomic(path string, data []byte) error {
+	dir := filepath.Dir(path)
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return fmt.Errorf("create direct-volume directory: %w", err)
+	}
+	temporary, err := os.CreateTemp(dir, ".mountInfo.json.*")
+	if err != nil {
+		return fmt.Errorf("create direct-volume temporary file: %w", err)
+	}
+	temporaryPath := temporary.Name()
+	defer func() { _ = os.Remove(temporaryPath) }()
+
+	if _, err := temporary.Write(data); err != nil {
+		_ = temporary.Close()
+		return fmt.Errorf("write direct-volume temporary file: %w", err)
+	}
+	if err := temporary.Sync(); err != nil {
+		_ = temporary.Close()
+		return fmt.Errorf("sync direct-volume temporary file: %w", err)
+	}
+	if err := temporary.Close(); err != nil {
+		return fmt.Errorf("close direct-volume temporary file: %w", err)
+	}
+	if err := os.Rename(temporaryPath, path); err != nil {
+		return fmt.Errorf("publish direct-volume metadata: %w", err)
+	}
+
+	directory, err := os.Open(dir)
+	if err != nil {
+		return fmt.Errorf("open direct-volume directory for sync: %w", err)
+	}
+	defer func() { _ = directory.Close() }()
+	if err := directory.Sync(); err != nil {
+		return fmt.Errorf("sync direct-volume directory: %w", err)
+	}
+	return nil
+}
diff --git a/pkg/driver/metadata_atomic_test.go b/pkg/driver/metadata_atomic_test.go
new file mode 100644
index 00000000..5f2fe956
--- /dev/null
+++ b/pkg/driver/metadata_atomic_test.go
@@ -0,0 +1,32 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package driver
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestAtomicMetadataFailedRenamePreservesTarget(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "mountInfo.json")
+	if err := os.Mkdir(path, 0700); err != nil {
+		t.Fatal(err)
+	}
+	marker := filepath.Join(path, "preserve")
+	if err := os.WriteFile(marker, []byte("original"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := writeMountInfoAtomic(path, []byte(`{"device":"disk"}`)); err == nil {
+		t.Fatal("rename into directory should fail")
+	}
+	data, err := os.ReadFile(marker)
+	if err != nil || string(data) != "original" {
+		t.Fatalf("target changed: %q, %v", data, err)
+	}
+	leftovers, err := filepath.Glob(filepath.Join(filepath.Dir(path), ".mountInfo.json.*"))
+	if err != nil || len(leftovers) != 0 {
+		t.Fatalf("temporary files left: %v, %v", leftovers, err)
+	}
+}
diff --git a/pkg/driver/nodeserver.go b/pkg/driver/nodeserver.go
index 8f23c3a6..3ca25161 100644
--- a/pkg/driver/nodeserver.go
+++ b/pkg/driver/nodeserver.go
@@ -234,10 +234,7 @@ func (ns *nodeServer) NodePublishVolume(_ context.Context, req *csi.NodePublishV
 	}
 
 	volumeDir := filepath.Join(getKataDirectVolumeRootPath(), b64.URLEncoding.EncodeToString([]byte(targetPath)))
-	if err := os.MkdirAll(volumeDir, 0700); err != nil {
-		return nil, status.Errorf(codes.Internal, "failed to create kata direct volume dir %s: %v", volumeDir, err)
-	}
-	if err := os.WriteFile(filepath.Join(volumeDir, mountInfoFileName), data, 0600); err != nil {
+	if err := writeMountInfoAtomic(filepath.Join(volumeDir, mountInfoFileName), data); err != nil {
 		return nil, status.Errorf(codes.Internal, "failed to write mountInfo.json: %v", err)
 	}
 
