+)
+
+func TestDirectVolumeMetadataExistingFixture(t *testing.T) {
+	metadata, err := readDirectVolumeMetadata(filepath.Join("testdata", "direct-volume-v1.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if metadata.Device != "d-workspace123" || !metadata.ReadOnly {
+		t.Fatalf("unexpected metadata: %+v", metadata)
+	}
+	if metadata.FSGroup != "2000" {
+		t.Fatalf("unexpected fsGroup: %q", metadata.FSGroup)
+	}
+	if len(metadata.Options) != 2 || metadata.Options[0] != "noatime" || metadata.Options[1] != "ro" {
+		t.Fatalf("unexpected normalized options: %v", metadata.Options)
+	}
+}
+
+func validDirectVolumeMetadata() mountInfoJSON {
+	return mountInfoJSON{
+		VolumeType:   "directvol",
+		Device:       "cloud-disk-123",
+		FsType:       "ext4",
+		ReadOnly:     true,
+		Options:      []string{"noatime", "ro"},
+		FSGroup:      "2000",
+		VolumeHandle: "pvc-workspace",
+		Metadata: map[string]string{
+			"cloud-provider":    "testcloud",
+			"cloud-volume-path": "cloud-disk-123",
+		},
+	}
+}
+
+func TestWriteDirectVolumeMetadataAtomic(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "direct-volume", mountInfoFileName)
+	metadata := validDirectVolumeMetadata()
+	if err := writeDirectVolumeMetadataAtomic(path, metadata); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode().Perm() != 0o600 {
+		t.Fatalf("metadata permissions = %o, want 600", info.Mode().Perm())
+	}
+	written, err := readDirectVolumeMetadata(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !directVolumeMetadataEqual(*written, metadata) {
+		t.Fatalf("metadata changed during atomic write: %+v", written)
+	}
+	temporary, err := filepath.Glob(filepath.Join(filepath.Dir(path), ".mountInfo.json.*"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(temporary) != 0 {
+		t.Fatalf("temporary metadata files remain: %v", temporary)
+	}
+}
+
+func TestNodeUnpublishRejectsVolumeHandleMismatch(t *testing.T) {
+	node, target, metadataPath := setupPublishedNode(t)
+	if _, err := node.NodePublishVolume(t.Context(), publishRequest(target,
+		csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER, false)); err != nil {
+		t.Fatal(err)
+	}
+
+	_, err := node.NodeUnpublishVolume(t.Context(), &csi.NodeUnpublishVolumeRequest{
+		VolumeId: "different-volume", TargetPath: target,
+	})
+	if status.Code(err) != codes.FailedPrecondition {
+		t.Fatalf("got %v, want FailedPrecondition", err)
+	}
+	if _, err := os.Stat(metadataPath); err != nil {
+		t.Fatalf("mismatched unpublish removed metadata: %v", err)
+	}
+	if _, err := os.Stat(target); err != nil {
+		t.Fatalf("mismatched unpublish removed target: %v", err)
+	}
+}
+
+func TestNodePublishVolumeRecoversAfterPluginRestart(t *testing.T) {
+	node, target, metadataPath := setupPublishedNode(t)
+	request := publishRequest(target, csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER, false)
+	contextSize := len(request.VolumeContext)
+	if _, err := node.NodePublishVolume(t.Context(), request); err != nil {
+		t.Fatal(err)
+	}
+
+	// Recreate the plugin without NodeStage, then replay the same publish.
+	node = newNodeServer("node-1")
+	if _, err := node.NodePublishVolume(t.Context(), request); err != nil {
+		t.Fatal(err)
+	}
+	metadata, err := readDirectVolumeMetadata(metadataPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if metadata.Device != "cloud-disk-123" || node.devices["pvc-workspace"] != "cloud-disk-123" {
+		t.Fatalf("plugin state was not recovered: metadata=%+v devices=%v", metadata, node.devices)
+	}
+	if len(request.VolumeContext) != contextSize || request.VolumeContext["cloud-provider"] != "" {
+		t.Fatal("publish mutated caller volume context")
+	}
+	request.VolumeContext["cloud-volume-path"] = "other-disk"
+	if _, err := newNodeServer("node-1").NodePublishVolume(t.Context(), request); status.Code(err) != codes.AlreadyExists {
+		t.Fatalf("expected conflicting disk replay to fail, got %v", err)
+	}
+}
+
+func TestNodePublishVolumeEnforcesCompatibleRepublish(t *testing.T) {
+	node, target, metadataPath := setupPublishedNode(t)
+	if _, err := node.NodePublishVolume(t.Context(), publishRequest(target, csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER, true)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := node.NodePublishVolume(t.Context(), publishRequest(target, csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER, true)); err != nil {
+		t.Fatalf("idempotent publish failed: %v", err)
+	}
+	_, err := node.NodePublishVolume(t.Context(), publishRequest(target, csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER, false))
+	if status.Code(err) != codes.AlreadyExists {
+		t.Fatalf("got %v, want AlreadyExists", err)
+	}
+	if _, err := os.Stat(metadataPath); err != nil {
+		t.Fatal(err)
+	}
+	matches, err := filepath.Glob(filepath.Join(filepath.Dir(metadataPath), ".mountInfo.json.*"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(matches) != 0 {
+		t.Fatalf("temporary metadata files remain: %v", matches)
+	}
+}
+
+func TestNodeUnpublishVolumeIsIdempotent(t *testing.T) {
+	node, target, metadataPath := setupPublishedNode(t)
+	if _, err := node.NodePublishVolume(t.Context(), publishRequest(target,
+		csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER, false)); err != nil {
+		t.Fatal(err)
+	}
+	request := &csi.NodeUnpublishVolumeRequest{VolumeId: "pvc-workspace", TargetPath: target}
+	if _, err := node.NodeUnpublishVolume(t.Context(), request); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := node.NodeUnpublishVolume(t.Context(), request); err != nil {
+		t.Fatalf("idempotent unpublish retry failed: %v", err)
+	}
+	if _, err := os.Stat(metadataPath); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("metadata remains after unpublish: %v", err)
+	}
+}
+
+func TestReadDirectVolumeMetadataOptionalReadOnly(t *testing.T) {
+	base := `{"version":1,"volume-type":"block","volume-mode":"filesystem","device":"cloud-disk-123","fstype":"ext4","pod-uid":"pod-uid-123","volume-handle":"pvc-workspace"`
+	tests := []struct {
+		name     string
+		readonly string
+		want     bool
+		wantErr  string
+	}{
+		{name: "explicit false", readonly: `,"readonly":false}`, want: false},
+		{name: "missing", readonly: `}`, want: false},
+		{name: "null", readonly: `,"readonly":null}`, want: false},
+		{name: "wrong type", readonly: `,"readonly":"false"}`, wantErr: "cannot unmarshal"},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), mountInfoFileName)
+			if err := os.WriteFile(path, []byte(base+test.readonly), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			metadata, err := readDirectVolumeMetadata(path)
+			if test.wantErr != "" {
+				if err == nil || !strings.Contains(err.Error(), test.wantErr) {
+					t.Fatalf("error = %v, want substring %q", err, test.wantErr)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if metadata.ReadOnly != test.want {
+				t.Fatalf("readonly = %t, want %t", metadata.ReadOnly, test.want)
+			}
+		})
+	}
+}
+
+func TestUnpublishPreservesNonemptyTarget(t *testing.T) {
+	node, target, metadataPath := setupPublishedNode(t)
+	if _, err := node.NodePublishVolume(t.Context(), publishRequest(target, csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER, false)); err != nil {
+		t.Fatal(err)
+	}
+	marker := filepath.Join(target, "must-survive")
+	if err := os.WriteFile(marker, []byte("data"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	_, err := node.NodeUnpublishVolume(t.Context(), &csi.NodeUnpublishVolumeRequest{VolumeId: "pvc-workspace", TargetPath: target})
+	if status.Code(err) != codes.Internal {
+		t.Fatalf("expected cleanup error, got %v", err)
+	}
+	if _, err := os.Stat(marker); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(metadataPath); err != nil {
+		t.Fatalf("failed cleanup removed metadata: %v", err)
+	}
+	if err := os.Remove(marker); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := node.NodeUnpublishVolume(t.Context(), &csi.NodeUnpublishVolumeRequest{VolumeId: "pvc-workspace", TargetPath: target}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(metadataPath); !os.IsNotExist(err) {
+		t.Fatalf("retry left metadata: %v", err)
+	}
+}
+
+func TestNodePublishAndUnpublishExistingUpstreamMetadata(t *testing.T) {
+	node, target, path := setupPublishedNode(t)
+	request := publishRequest(target, csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER, false)
+	request.VolumeCapability.GetMount().VolumeMountGroup = ""
+	delete(request.VolumeContext, "encrypt-type")
+	delete(request.VolumeContext, "kbs-key-id")
+	if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(target, 0750); err != nil {
+		t.Fatal(err)
+	}
+	// This is the original upstream writer's shape, without a version label,
+	// explicit readonly, Pod UID or volume-handle extension.
+	original := []byte(`{"volume-type":"directvol","device":"cloud-disk-123","fstype":"ext4","metadata":{"cloud-volume-id":"pvc-workspace","cloud-volume-path":"cloud-disk-123"}}`)
+	if err := os.WriteFile(path, original, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := node.NodePublishVolume(t.Context(), request); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := node.NodeUnpublishVolume(t.Context(), &csi.NodeUnpublishVolumeRequest{VolumeId: "wrong-volume", TargetPath: target}); status.Code(err) != codes.FailedPrecondition {
+		t.Fatalf("legacy ownership check: %v", err)
+	}
+	if _, err := node.NodeUnpublishVolume(t.Context(), &csi.NodeUnpublishVolumeRequest{VolumeId: request.VolumeId, TargetPath: target}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestDirectVolumeMetadataOptionCompatibility(t *testing.T) {
+	old := mountInfoJSON{Options: []string{"noatime", "nodev"}}
+	current := mountInfoJSON{Options: []string{"nodev", "noatime"}}
+	if !directVolumeMetadataEqual(old, current) {
+		t.Fatal("sorted legacy flags must remain compatible")
+	}
+	old.Options, current.Options = []string{"noexec", "exec"}, []string{"exec", "noexec"}
+	if directVolumeMetadataEqual(old, current) {
+		t.Fatal("different final access flags must not compare equal")
+	}
+	old.Options, current.Options = []string{"commit=30", "commit=60"}, []string{"commit=60", "commit=30"}
+	if directVolumeMetadataEqual(old, current) {
+		t.Fatal("different final filesystem options must not compare equal")
+	}
+}
+
+func TestNodeTargetsMustBeAbsolute(t *testing.T) {
+	node, _, _ := setupPublishedNode(t)
+	if _, err := node.NodePublishVolume(t.Context(), publishRequest("relative", csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER, false)); status.Code(err) != codes.InvalidArgument {
+		t.Fatalf("publish: %v", err)
+	}
+	if _, err := node.NodeUnpublishVolume(t.Context(), &csi.NodeUnpublishVolumeRequest{VolumeId: "pvc-workspace", TargetPath: "relative"}); status.Code(err) != codes.InvalidArgument {
+		t.Fatalf("unpublish: %v", err)
+	}
+}
+
+func TestNodePublishCorrectRetryAfterRejectedRecovery(t *testing.T) {
+	node, target, _ := setupPublishedNode(t)
+	request := publishRequest(target, csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER, false)
+	if _, err := node.NodePublishVolume(t.Context(), request); err != nil {
+		t.Fatal(err)
+	}
+	node.devices = map[string]string{} // node-plugin restart
+	wrong := publishRequest(target, csi.VolumeCapability_AccessMode_SINGLE_NODE_WRITER, false)
+	wrong.VolumeContext["cloud-volume-path"] = "wrong-disk"
+	if _, err := node.NodePublishVolume(t.Context(), wrong); status.Code(err) != codes.AlreadyExists {
+		t.Fatalf("wrong recovery: %v", err)
+	}
+	if _, err := node.NodePublishVolume(t.Context(), request); err != nil {
+		t.Fatalf("correct retry: %v", err)
+	}
+}
