diff --git a/charts/caa-csi-block-driver/values.yaml b/charts/caa-csi-block-driver/values.yaml
index 0e69a127225e7cf91219fece61db00faf63cf061..62e5dcfba6354bad928b0279c6b72aa84213fa7f 100644
--- a/charts/caa-csi-block-driver/values.yaml
+++ b/charts/caa-csi-block-driver/values.yaml
@@ -1,4 +1,4 @@
-# Cloud provider: aws, azure, or libvirt
+# Cloud provider: alibabacloud, aws, azure, or libvirt
 provider: aws
 
 nameOverride: ""
@@ -43,6 +43,22 @@ azure:
 libvirt:
   volumeDir: /var/lib/caa-csi-volumes
 
+# Alibaba Cloud ESSD settings
+alibabacloud:
+  region: ""
+  zoneId: ""
+  clusterId: ""
+  diskCategory: cloud_essd
+  performanceLevel: PL0
+  resourceGroupId: ""
+  # Leave empty to use RRSA or the Alibaba Cloud default credential chain.
+  credentialsSecret: ""
+  rrsa:
+    enabled: false
+    roleArn: ""
+    oidcProviderArn: ""
+    tokenFile: /var/run/secrets/ack.alibabacloud.com/rrsa-tokens/token
+
 # CDH encryption settings (optional, for LUKS via CAA).
 # kbs-key-id is the KBS path without the kbs:/// prefix.
 # Example: default/luks-key/volume-key
