diff --git a/pkg/driver/chart_test.go b/pkg/driver/chart_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..3e0bdd1398ec13cdddcbcabe4ee3fca44c5df261
--- /dev/null
+++ b/pkg/driver/chart_test.go
@@ -0,0 +1,100 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package driver
+
+import (
+	"os/exec"
+	"strings"
+	"testing"
+)
+
+const chartPath = "../../charts/caa-csi-block-driver"
+
+func renderChartTemplate(t *testing.T, template string, values ...string) string {
+	t.Helper()
+	if _, err := exec.LookPath("helm"); err != nil {
+		t.Skip("helm is not installed")
+	}
+	args := []string{"template", "runtime-test", chartPath, "--show-only", template}
+	for _, value := range values {
+		args = append(args, "--set", value)
+	}
+	output, err := exec.Command("helm", args...).CombinedOutput()
+	if err != nil {
+		t.Fatalf("helm template failed: %v\n%s", err, output)
+	}
+	return string(output)
+}
+
+func genericChartValues() []string {
+	return []string{
+		"provider=aws",
+		"aws.region=us-test-1",
+		"aws.availabilityZone=us-test-1a",
+		"aws.staticCredentials.enabled=true",
+		"aws.staticCredentials.secretName=aws-controller-credentials",
+		"controller.state.storageClassName=host-storage",
+	}
+}
+
+func TestHelmSeparatesControllerAndNodePrivileges(t *testing.T) {
+	values := genericChartValues()
+	controller := renderChartTemplate(t, "templates/controller.yaml", values...)
+	for _, required := range []string{
+		"kind: PersistentVolumeClaim", "helm.sh/resource-policy: keep",
+		`storageClassName: "host-storage"`, "kind: Deployment", "type: Recreate",
+		`"--component=controller"`, `"--leader-election=true"`,
+		"name: AWS_ACCESS_KEY_ID", "name: aws-controller-credentials",
+	} {
+		if !strings.Contains(controller, required) {
+			t.Fatalf("controller render does not contain %q:\n%s", required, controller)
+		}
+	}
+	for _, forbidden := range []string{"--nodeid=", "kind: DaemonSet", "/var/lib/kubelet/pods"} {
+		if strings.Contains(controller, forbidden) {
+			t.Fatalf("controller render contains node-only value %q:\n%s", forbidden, controller)
+		}
+	}
+
+	node := renderChartTemplate(t, "templates/daemonset.yaml", values...)
+	for _, required := range []string{
+		"kind: DaemonSet", "automountServiceAccountToken: false",
+		`"--component=node"`, `"--nodeid=$(KUBE_NODE_NAME)"`,
+	} {
+		if !strings.Contains(node, required) {
+			t.Fatalf("node render does not contain %q:\n%s", required, node)
+		}
+	}
+	for _, forbidden := range []string{
+		"csi-provisioner", "--component=controller", "AWS_ACCESS_KEY",
+		"aws-controller-credentials", "controller-state", "bootstrap-params",
+	} {
+		if strings.Contains(node, forbidden) {
+			t.Fatalf("node render contains controller-only value %q:\n%s", forbidden, node)
+		}
+	}
+}
+
+func TestHelmPreservesOptionalCDHParameters(t *testing.T) {
+	values := genericChartValues()
+	plain := renderChartTemplate(t, "templates/storageclass.yaml", values...)
+	if strings.Contains(plain, "encrypt-type:") || strings.Contains(plain, "kbs-key-id:") {
+		t.Fatalf("default StorageClass unexpectedly enables CDH:\n%s", plain)
+	}
+
+	values = append(values,
+		"cdh.enabled=true",
+		"cdh.encryptionType=luks2",
+		"cdh.key=default/luks-key/workspace",
+	)
+	encrypted := renderChartTemplate(t, "templates/storageclass.yaml", values...)
+	for _, required := range []string{
+		`encrypt-type: "luks2"`,
+		`kbs-key-id: "default/luks-key/workspace"`,
+	} {
+		if !strings.Contains(encrypted, required) {
+			t.Fatalf("encrypted StorageClass does not contain %q:\n%s", required, encrypted)
+		}
+	}
+}
diff --git a/pkg/driver/controller_durable_test.go b/pkg/driver/controller_durable_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..585ecc3ae5c8b86f98e66cbf2faeb3a8718ef9bf
--- /dev/null
+++ b/pkg/driver/controller_durable_test.go
@@ -0,0 +1,363 @@
+// (C) Copyright Confidential Containers Contributors
+// SPDX-License-Identifier: Apache-2.0
+
+package driver
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/container-storage-interface/spec/lib/go/csi"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+
+	provider "github.com/confidential-devhub/caa-csi-block-driver/pkg/provider"
+)
+
+const testGiB = int64(1 << 30)
+
+var testProviderSequence atomic.Uint64
+
+type durableTestProvider struct {
+	mu               sync.Mutex
+	minimumBytes     int64
+	failFirstCreate  bool
+	terminalFailures int
+	committed        bool
+	operationID      string
+	operationIDs     []string
+	createCalls      int
+	effectiveCreates int
+	deleteCalls      int
+}
+
+type durableTerminalError struct{}
+
+func (durableTerminalError) Error() string               { return "explicit cloud API rejection" }
+func (durableTerminalError) TerminalCreateFailure() bool { return true }
+
+type genericTestProvider struct {
+	mu          sync.Mutex
+	failures    int
+	createCalls int
+}
+
+func (fake *genericTestProvider) CreateVolume(volumeID string, size int64) (*provider.VolumeInfo, error) {
+	fake.mu.Lock()
+	defer fake.mu.Unlock()
+	fake.createCalls++
+	if fake.failures > 0 {
+		fake.failures--
+		return nil, errors.New("conclusive provider failure")
+	}
+	return &provider.VolumeInfo{
+		VolumeID: volumeID, Path: "disk-" + volumeID, SizeBytes: size,
+		Provider: "generic-test", Metadata: map[string]string{"cloud-volume-path": "disk-" + volumeID},
+	}, nil
+}
+
+func (*genericTestProvider) DeleteVolume(string) error { return nil }
+func (*genericTestProvider) GetVolumeInfo(string) (*provider.VolumeInfo, error) {
+	return nil, errors.New("not implemented")
+}
+func (*genericTestProvider) VolumeExists(string) (bool, error) { return false, nil }
+
+func registerGenericTestProvider(t *testing.T, fake *genericTestProvider) string {
+	t.Helper()
+	name := fmt.Sprintf("generic-test-%d", testProviderSequence.Add(1))
+	provider.RegisterProvider(name, func(map[string]string) (provider.BlockVolumeProvider, error) {
+		return fake, nil
+	})
+	return name
+}
+
+func registerDurableTestProvider(t *testing.T, fake *durableTestProvider) string {
+	t.Helper()
+	name := fmt.Sprintf("durable-test-%d", testProviderSequence.Add(1))
+	provider.RegisterProvider(name, func(map[string]string) (provider.BlockVolumeProvider, error) {
+		return fake, nil
+	})
+	return name
+}
+
+func (fake *durableTestProvider) NormalizeCapacity(required int64) (int64, error) {
+	if required < fake.minimumBytes {
+		return fake.minimumBytes, nil
+	}
+	return required, nil
+}
+
+func (fake *durableTestProvider) CreateVolume(string, int64) (*provider.VolumeInfo, error) {
+	return nil, errors.New("persisted operation ID required")
+}
+
+func (fake *durableTestProvider) CreateVolumeWithOperation(volumeID string, size int64, operationID string) (*provider.VolumeInfo, error) {
+	fake.mu.Lock()
+	defer fake.mu.Unlock()
+	fake.createCalls++
+	fake.operationIDs = append(fake.operationIDs, operationID)
+	if fake.terminalFailures > 0 {
+		fake.terminalFailures--
+		return nil, durableTerminalError{}
+	}
+	if !fake.committed {
+		fake.committed = true
+		fake.operationID = operationID
+		fake.effectiveCreates++
+	} else if fake.operationID != operationID {
+		fake.effectiveCreates++
+	}
+	if fake.failFirstCreate {
+		fake.failFirstCreate = false
+		return nil, errors.New("client timeout after service commit")
+	}
+	return &provider.VolumeInfo{
+		VolumeID: volumeID, Path: "disk-" + volumeID, SizeBytes: size,
+		Provider: "durable-test", Metadata: map[string]string{"cloud-volume-path": "disk-" + volumeID},
