From 3bd4239cf84636df48bb3e4faef078ee70e58c96 Mon Sep 17 00:00:00 2001
From: Weidong Sun <sunweidong@linux.alibaba.com>
Date: Tue, 3 Nov 2026 01:05:58 +0800
Subject: [PATCH 5/5] build: pin supported build and runtime base indexes

Co-authored-by: Codex <codex@openai.com>
---
 Dockerfile | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/Dockerfile b/Dockerfile
index 4e7e628103b9f8573c36e63f3a9f636be1c958da..721d86bc77619ecf911f0162d6d810b23ea8764c 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,4 +1,4 @@
-FROM --platform=$BUILDPLATFORM golang:1.24-alpine AS builder
+FROM --platform=$BUILDPLATFORM golang:1.26.7-alpine3.24@sha256:28d89ee9cc0ff9fec75c82ca201e6bf7fdf9a679d4b7b24dfa04f2bb766bb468 AS builder
 
 ARG TARGETARCH
 ARG VERSION=dev
@@ -13,7 +13,9 @@ COPY pkg/ pkg/
 RUN CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH \
     go build -ldflags "-X main.version=$VERSION" -o /caa-csi-block-driver ./cmd/
 
-FROM alpine:3.19
+# Multi-platform manifest index: linux/amd64 and linux/s390x are included.
+# Update this index deliberately when refreshing the runtime base.
+FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
 RUN apk add --no-cache e2fsprogs e2fsprogs-extra blkid
 COPY --from=builder /caa-csi-block-driver /caa-csi-block-driver
 ENTRYPOINT ["/caa-csi-block-driver"]
