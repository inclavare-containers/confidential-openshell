+func TestCreateDiskRetryReusesTokenWithoutCrossClusterCollision(t *testing.T) {
+	var tokens []string
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_ = r.ParseForm()
+		w.Header().Set("Content-Type", "application/json")
+		if r.Header.Get("x-acs-action") == "CreateDisk" {
+			tokens = append(tokens, r.Form.Get("ClientToken"))
+			w.WriteHeader(http.StatusInternalServerError)
+			_, _ = w.Write([]byte(`{"Code":"InternalError","Message":"unknown create outcome"}`))
+			return
+		}
+		_, _ = w.Write([]byte(`{"TotalCount":0,"Disks":{"Disk":[]}}`))
+	}))
+	defer server.Close()
+	for _, identity := range [][2]string{{"cluster-a", "pvc-a"}, {"cluster-a", "pvc-a"}, {"cluster-b", "pvc-a"}, {"cluster-a", "pvc-b"}} {
+		p := &AlibabaCloudProvider{config: Config{Region: "cn-beijing", Zone: "cn-beijing-i", ClusterID: identity[0]}, sdk: openapi.Config{
+			Endpoint: tea.String(strings.TrimPrefix(server.URL, "http://")), Protocol: tea.String("http"),
+			AccessKeyId: tea.String("test-id"), AccessKeySecret: tea.String("test-secret"),
+		}}
+		if _, err := p.CreateVolume(context.Background(), identity[1], gib); err == nil {
+			t.Fatal("ambiguous create unexpectedly succeeded")
+		}
+	}
+	if len(tokens) != 4 || tokens[0] == "" || tokens[0] != tokens[1] || tokens[0] == tokens[2] || tokens[0] == tokens[3] {
+		t.Fatalf("retry/cluster/volume token scope is incorrect: %v", tokens)
+	}
+}
