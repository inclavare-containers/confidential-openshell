From be549d44d97974cadd913addcac80a2e36f58062 Mon Sep 17 00:00:00 2001
From: Weidong Sun <sunweidong@linux.alibaba.com>
Date: Mon, 2 Nov 2026 16:33:07 +0800
Subject: [PATCH 5/5] build: pin the runtime base manifest index

---
 Dockerfile | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/Dockerfile b/Dockerfile
index 4e7e628103b9f8573c36e63f3a9f636be1c958da..a95088625401d15e92d57e247d5a22eb170a1ba9 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -13,7 +13,9 @@ COPY pkg/ pkg/
 RUN CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH \
     go build -ldflags "-X main.version=$VERSION" -o /caa-csi-block-driver ./cmd/
 
-FROM alpine:3.19
+# Multi-platform manifest index: linux/amd64 and linux/s390x are included.
+# Update this index deliberately when refreshing the runtime base.
+FROM alpine:3.19@sha256:6baf43584bcb78f2e5847d1de515f23499913ac9f12bdf834811a3145eb11ca1
 RUN apk add --no-cache e2fsprogs e2fsprogs-extra blkid
 COPY --from=builder /caa-csi-block-driver /caa-csi-block-driver
 ENTRYPOINT ["/caa-csi-block-driver"]
